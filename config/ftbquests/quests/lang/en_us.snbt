{
	chapter.041AB330B26A5B14.chapter_subtitle: ["A little of everything, crushed into one spark, and creative items from it"]
	chapter.041AB330B26A5B14.title: "The Spark of Creation"
	chapter.066DEC55CF9583C9.chapter_subtitle: ["Power, transport, storage and the gear to go with it"]
	chapter.066DEC55CF9583C9.title: "Mekanism Systems"
	chapter.07BB46C630FA3246.chapter_subtitle: ["Caves worth seeing, ores worth finding, and faster ways to dig"]
	chapter.07BB46C630FA3246.title: "Into the Hollow"
	chapter.086C57609DB3DB96.chapter_subtitle: ["Industry on a grand scale"]
	chapter.086C57609DB3DB96.title: "Oritech"
	chapter.109E2C32DE0A3837.chapter_subtitle: ["Three endgame metals, two strange dimensions and some very big tables"]
	chapter.109E2C32DE0A3837.title: "Allthemodium Ascent"
	chapter.1D2AC3F9FC44D23B.chapter_subtitle: ["Oil, pipes, exo suits and augments"]
	chapter.1D2AC3F9FC44D23B.title: "Oritech Kit"
	chapter.1D4A618624BD29FC.chapter_subtitle: ["Chests and backpacks that grow with you"]
	chapter.1D4A618624BD29FC.title: "Packing It In"
	chapter.1EAC187E22BADD01.chapter_subtitle: ["Artifacts, relics, and a few extra hearts"]
	chapter.1EAC187E22BADD01.title: "Curios \\& Keepsakes"
	chapter.1EF3C8B3383863CA.chapter_subtitle: ["Importers and exporters, faster devices, upgrades and autocrafting"]
	chapter.1EF3C8B3383863CA.title: "The Network at Work"
	chapter.202EED7366C92DEC.chapter_subtitle: ["Your first night, and some tips and tricks"]
	chapter.202EED7366C92DEC.title: "Welcome Home"
	chapter.26CBCB3533099AA7.chapter_subtitle: ["Grow it, catch it, cook it, and eat a little of everything"]
	chapter.26CBCB3533099AA7.title: "Hearth \\& Table"
	chapter.29E5169153F6AE98.chapter_subtitle: ["Every resource and mob seed, a row for each tier of essence"]
	chapter.29E5169153F6AE98.title: "A Seed for Everything"
	chapter.31F28E2FD86A0C95.chapter_subtitle: ["Jetpacks, wings, elevators and a waystone network of your own"]
	chapter.31F28E2FD86A0C95.title: "Up \\& Away"
	chapter.3380E1EE475D131E.chapter_subtitle: ["From stone to netherite, and the small upgrades that make it last"]
	chapter.3380E1EE475D131E.title: "Tools of the Trade"
	chapter.3EA4678A9B0E7634.chapter_subtitle: ["One network for everything: disks, grids and wireless access"]
	chapter.3EA4678A9B0E7634.title: "Refined Storage"
	chapter.41A7BA482D955C1D.chapter_subtitle: ["From iron to unobtainium, upgraded in place"]
	chapter.41A7BA482D955C1D.title: "Faster Furnaces"
	chapter.471B39DFF7D32D90.chapter_subtitle: ["Teach a model a mob, then farm it without the fight"]
	chapter.471B39DFF7D32D90.title: "Hostile Neural Networks"
	chapter.4BF4F37B8A473892.chapter_subtitle: ["Pots, pylons and faster crops"]
	chapter.4BF4F37B8A473892.title: "Green Thumb"
	chapter.50A71B15CF9C9BA4.chapter_subtitle: ["Roofs, chairs, lamps and a gadget that builds walls"]
	chapter.50A71B15CF9C9BA4.title: "The Builder's Bench"
	chapter.5201D4A39447C9B2.chapter_subtitle: ["Up to five ingots from every ore"]
	chapter.5201D4A39447C9B2.title: "Mekanism"
	chapter.63310C5774205A41.chapter_subtitle: ["Fission, fusion and antimatter"]
	chapter.63310C5774205A41.title: "Mekanism Reactors"
	chapter.6A08833828DDC5F3.chapter_subtitle: ["One tool, every road"]
	chapter.6A08833828DDC5F3.title: "The Alloy Paxel"
	chapter.6BCB81E1A28243BE.chapter_subtitle: ["Grow your resources instead of mining them"]
	chapter.6BCB81E1A28243BE.title: "Mystical Agriculture"
	chapter.6ECC1B7C13D960CA.chapter_subtitle: ["Pipes that carry, routers that sort, cans that swallow"]
	chapter.6ECC1B7C13D960CA.title: "Logistics"
	chapter.7030ACE742146D78.chapter_subtitle: ["Repeatable deliveries and hunts, in three tiers"]
	chapter.7030ACE742146D78.title: "Bounty Board"
	chapter.7183322E45A36FDC.chapter_subtitle: ["Strange biomes, sky islands, old towns and older ruins"]
	chapter.7183322E45A36FDC.title: "Wanderlust"
	chapter.795AB1D39D51C32D.chapter_subtitle: ["Better gear, harder fights"]
	chapter.795AB1D39D51C32D.title: "Monsters \\& Mettle"
	chapter.7DEDCE79D4C955D3.chapter_subtitle: ["A farm for any drop, with the experience bottled"]
	chapter.7DEDCE79D4C955D3.title: "Mob Grinding"
	chapter.7EA6232EE1978E1C.chapter_subtitle: ["From a coal generator to a reactor, carried anywhere"]
	chapter.7EA6232EE1978E1C.title: "Sparks"
	chapter.7FF15EBCAE2C8B9B.chapter_subtitle: ["Every fish, every feast, every far-off place"]
	chapter.7FF15EBCAE2C8B9B.title: "The Almanac"
	chapter_group.35FD6D18A971484E.title: "Out in the World"
	chapter_group.3D424858AC8D0F3F.title: "The Long Road"
	chapter_group.6D64CA34D687FD52.title: "Getting Settled"
	chapter_group.73D6AE1B18A4548B.title: "Making It Hum"
	file.0000000000000001.title: "Hearth \\& Hollow"
	quest.0033C1CCD87D5C77.quest_desc: ["&eUltra&r devices are four Elite ones with diamond blocks and an Advanced Processor."]
	quest.0033C1CCD87D5C77.title: "Ultra Grade"
	quest.003C128A87A1AE88.quest_desc: [
		"A Heavy Core and a &eBreeze Rod&r make a &eMace&r. It hits hard on its own, and much harder when you fall onto your target first: the further the drop, the bigger the smash."
		""
		"It's also where the Allthemodium maces start. &eAllthemodium Ascent&r upgrades it three times over."
	]
	quest.003C128A87A1AE88.title: "Mind the Drop"
	quest.003E10B908F86968.quest_desc: [
		"A netherite pickaxe or paxel: the best tool you can carry without a machine behind it."
		""
		"From here, the tech chapters take over. Stronger gear is out there, but this will carry you a very long way."
	]
	quest.003E10B908F86968.title: "Built to Last"
	quest.00587CAFE71B99B2.quest_desc: ["Past netherite, the furnaces follow the allthemodium metals."]
	quest.00587CAFE71B99B2.title: "Allthemodium Furnace"
	quest.00613079BDD7D1C5.quest_desc: ["The &eAdvanced Item Collector&r reaches a little farther, and has a filter so it only picks up what you want."]
	quest.00613079BDD7D1C5.title: "Advanced Item Collector"
	quest.0070E11BC974904B.quest_desc: [
		"The &eAutocrafter Manager&r lists the patterns in every Autocrafter on the network, with a search box."
		""
		"Add and remove patterns from one screen instead of walking from crafter to crafter."
	]
	quest.0070E11BC974904B.title: "Every Pattern in One Place"
	quest.0079D12B7F4469EE.quest_desc: ["The &eCombiner&r presses things together, like dust and stone back into ore. JEI shows what it makes."]
	quest.0079D12B7F4469EE.title: "The Combiner"
	quest.009B61A136EDA6F0.quest_desc: ["Sixteen thousand items. The 16k part takes four Improved Processors."]
	quest.009B61A136EDA6F0.title: "16k Storage Disk"
	quest.00A10C0097A2F25A.quest_desc: [
		"Refined Types adds &eEnergy Storage Disks&r, which hold FE in a Disk Drive like any other resource."
		""
		"A &eNetwork Energizer&r, eight copper blocks around an Interface, draws on those disks to keep the network running."
	]
	quest.00A10C0097A2F25A.title: "Power in the Bank"
	quest.00AD4D6A2565D11E.quest_desc: [
		"The &eBio Generator&r makes 64 RF a tick from biomass and other plant matter, so a tree or crop farm can power your base."
		""
		"It needs two machine cores, and a Flux Gate in its recipe."
	]
	quest.00AD4D6A2565D11E.title: "Bio Generator"
	quest.00D15C27CEC162A9.quest_desc: ["Diamond blocks this time, around a Gold Autocrafter."]
	quest.00D15C27CEC162A9.title: "Diamond Autocrafter"
	quest.010C799C31E428CC.quest_desc: [
		"Smelt a plain book and you get &eCooking for Blockheads I&r: a recipe book that shows every food you can make with what you're carrying."
		""
		"It's also the first step toward a full kitchen. Add a crafting table and two diamonds to make &eCooking for Blockheads II&r, which goes into the Cooking Table."
	]
	quest.010C799C31E428CC.title: "Cooking for Blockheads"
	quest.010EA30DF2010CCD.quest_desc: [
		"Grows &eConstantan Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Constantan Ingots and four Imperium Essence on the pedestals."
	]
	quest.010EA30DF2010CCD.title: "Constantan Seeds"
	quest.011DA9679A6EC6A1.quest_desc: [
		"A &eSkillet&r is a frying pan you carry. Stand near a heat source, hold the skillet, and put food in your other hand to cook it."
		""
		"Sneak to place it as a block, on a stove for instance. It also makes a fine club in a pinch."
	]
	quest.011DA9679A6EC6A1.title: "Cooking on the Go"
	quest.0123AB4A358212F1.quest_desc: [
		"Jungle rivers hold the biggest catch in the log, the &eArapaima&r, and the toothiest, the &cPiranha&r."
		""
		"Arrau turtles come up on the line here too."
	]
	quest.0123AB4A358212F1.title: "Jungle Water"
	quest.0140DA1D2A0C42B3.quest_desc: [
		"A &eDynamic Tank&r is a multiblock box of casing and valves that stores a vast amount of one fluid or chemical. Make it any size you like, within limits."
		""
		"JEI shows how to build it."
	]
	quest.0140DA1D2A0C42B3.title: "The Dynamic Tank"
	quest.0169093668F76821.quest_desc: [
		"Every transmitter comes in four tiers. Each one is eight of the tier below around an alloy: infused for advanced, reinforced for elite and atomic for ultimate."
		""
		"Each tier moves more fluids, and faster, so it pays to upgrade the busiest lines first."
	]
	quest.0169093668F76821.title: "Ultimate Mechanical Pipe"
	quest.0185187F2FF301B3.quest_desc: ["Refined Storage Controllers and Ultimate Induction Providers make a Creative Controller: a network that never needs power."]
	quest.0185187F2FF301B3.title: "A Network for Free"
	quest.018658BB468A1E76.quest_desc: [
		"The &eIsotopic Centrifuge&r spins uranium hexafluoride into fissile fuel."
		""
		"It also turns nuclear waste into plutonium later on, so you'll want two."
	]
	quest.018658BB468A1E76.title: "Spin It Really Fast"
	quest.018E57B184C0741B.quest_desc: ["The &eStonecutter&r, &eAnvil&r and &eSmithing&r upgrades each add their workstation as a tab on the backpack."]
	quest.018E57B184C0741B.title: "A Workshop in a Bag"
	quest.01EFE30897AF9B5A.quest_desc: [
		"Steak and bread will keep you going. This chapter is about eating well: growing your own food, catching fish, and turning it all into proper meals."
		""
		"Start with a &eknife&r. It's a kitchen tool and a weapon, and it gets more out of plants and animals than your bare hands. A flint one is fine for now."
	]
	quest.01EFE30897AF9B5A.title: "Hearth \\& Table"
	quest.0206A15D6B33C72C.quest_desc: [
		"Somewhere out there, whole biomes of land float high above the ground: Terralith's &eSkylands&r, in spring, summer, autumn and winter colors."
		""
		"Let the Nature's Compass find one. Bring blocks to climb up, and a paraglider for the way down."
	]
	quest.0206A15D6B33C72C.title: "Above the Clouds"
	quest.02116DB82D768CF8.quest_desc: [
		"Alloys won't hold without something to bind them. A &ePiglich Heart&r does it."
		""
		"Piglichs guard the &eAncient Pyramids&r in the soul sand valleys of the Other. Each one drops a heart. Bring friends."
		""
		"Once you've met one, a Hostile Networks model can learn them, and every Piglich prediction fabricates four hearts. The tools and the paxel take eighteen hearts between them, so the model pays for itself."
	]
	quest.02116DB82D768CF8.title: "Heart of a Lich"
	quest.023B3A10D76CF2E9.quest_desc: [
		"Craft a &eNature's Compass&r: a compass ringed with saplings and logs. Open it, pick a biome and press &eStart Search&r. The needle points the way and the screen shows the coordinates."
		""
		"It won't teleport you. The walk is the point."
	]
	quest.023B3A10D76CF2E9.title: "Which Way?"
	quest.024CB470C736AB9B.quest_desc: [
		"See in the dark, with no torches."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.024CB470C736AB9B.title: "Night Vision Augment"
	quest.0251B5C76B9DB63E.quest_desc: ["A &eRotational Complex&r sits on the top rotor, with &ePressure Dispersers&r filling the rest of that layer. &eElectromagnetic Coils&r above it turn the spin into power."]
	quest.0251B5C76B9DB63E.title: "Spinning Into Power"
	quest.0263092562281BE7.quest_desc: ["128 FE/t, and the root of three odd ones: magmatic, ender and enchantment generators all grow from it."]
	quest.0263092562281BE7.title: "Obsidian Generator"
	quest.0275CC16427ED3E9.quest_desc: [
		"Once you have a paxel, you can make more without the tech pieces. Put yours in the middle of a crafting table with eight blocks of alloy around it: Vibranium-Allthemodium and Unobtainium-Vibranium on the corners, two of each, and Unobtainium-Allthemodium on the four sides."
		""
		"Your paxel stays in the grid, so you end up with two. Pass one on, or keep a spare."
	]
	quest.0275CC16427ED3E9.title: "One for a Friend"
	quest.029246B8AE34A885.quest_desc: [
		"Oritech's &eNuclear Reactor&r is a multiblock of any size you like: walls, rods, a fuel port over each rod, and a controller to assemble it. It burns uranium or plutonium pellets for huge amounts of power."
		""
		"&cIt runs hot.&r Heat pipes, vents and absorbers carry the heat away. Read the manual's reactor pages before you load the fuel."
	]
	quest.029246B8AE34A885.title: "Splitting Atoms"
	quest.0299C1CAECBAD261.quest_desc: [
		"Some keepsakes are made for a scrap:"
		""
		"the &eVampiric Glove&r drains life from what you hit, the &ePower Glove&r hits harder, &eFeral Claws&r swing faster, and the &eCross Necklace&r keeps you safe a moment longer after a hit."
		""
		"Any one of them will do."
	]
	quest.0299C1CAECBAD261.title: "A Fighting Chance"
	quest.029E64382B8839F4.quest_desc: ["The largest disk ExtraStorage makes. Extra Disks keeps going."]
	quest.029E64382B8839F4.title: "16384k Storage Disk"
	quest.02A23AD84E3C2D8E.quest_desc: [
		"A swamp that someone decorated, full of blue orchids."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.02A23AD84E3C2D8E.title: "Orchid Swamp"
	quest.02BAEEEB6FEBDA21.quest_desc: [
		"Powah's &eReactor&r is a big generator built from 36 reactor blocks. Hold all of them and place one where there's open room, 3 blocks across and 4 tall: the reactor builds itself."
		""
		"It runs on &eUraninite&r. Energize uranium ingots in the orb to make it, both for the blocks and for fuel."
		""
		"Wire it into a flux network and your whole world has power. Higher tiers of reactor make much more."
	]
	quest.02BAEEEB6FEBDA21.title: "Reactor"
	quest.02BC9448B77D2685.quest_desc: [
		"&eLead&r, &eSilver&r, &eNickel&r and &eOsmium&r keep below sea level, and they're thickest around the top of the deepslate."
		""
		"Osmium is the one you'll want most: a lot of Mekanism runs on it. Grab every vein you see."
	]
	quest.02BC9448B77D2685.title: "Below Sea Level"
	quest.032E11C6DB6B51E2.quest_desc: [
		"A second kind of research station, with three cores of its own. It unlocks the high-tier augments: stronger health and armor, far reach, hyper mining and more."
		""
		"The center has three station slots, so plan your layout."
	]
	quest.032E11C6DB6B51E2.title: "Quantum Research Station"
	quest.033A3F06B0ACAA5B.quest_desc: [
		"The next step needs &eCognizant Dust&r, and only two monsters have it: the Wither and the Ender Dragon."
		""
		"They drop it when killed with an essence weapon carrying &eMystical Enlightenment&r. The Enchanter, just below, can put that enchantment on a sword."
	]
	quest.033A3F06B0ACAA5B.title: "Cognizant Dust"
	quest.03888092D173CBED.quest_desc: [
		"Upgrades go into the gadget at a &eModification Table&r. Put the gadget in, then drop upgrades onto the screen."
		""
		"Click an installed upgrade to take it back out."
	]
	quest.03888092D173CBED.title: "Modification Table"
	quest.03A9CD4CDE5D72C9.quest_desc: [
		"An &eItem Collector&r picks up items lying around it and puts them in the inventory it's attached to."
		""
		"Put one on a chest next to your mob farm or under a tree farm and stop chasing drops. You can widen or shrink its range in its menu."
	]
	quest.03A9CD4CDE5D72C9.title: "Tidy Up the Floor"
	quest.03CD6EA75FF72BF7.quest_desc: [
		"For the miners among us:"
		""
		"&eDigging Claws&r speed up mining, the &eLucky Scarf&r adds a little Fortune, the &ePickaxe Heater&r smelts ore as you dig it, and &eNight Vision Goggles&r light up the dark."
		""
		"Wear one while you mine and it levels up as you go."
	]
	quest.03CD6EA75FF72BF7.title: "Pocket Prospector"
	quest.03D4D2011F0DD177.quest_desc: [
		"The &eCrusher&r grinds ingots back into dust and, more to the point, turns &eClumps&r into &eDirty Dust&r."
		""
		"Dirty Dust goes back through the Enrichment Chamber to come out clean. Every higher tier of ore processing ends with this pair, so build them side by side."
	]
	quest.03D4D2011F0DD177.title: "The Crusher"
	quest.03DBD108CAB3356F.quest_desc: [
		"Fluids get disks too. A &e64B Fluid Storage Disk&r holds 64 buckets, and the bigger ones go up from there."
		""
		"Stored fluids show up in the Grid right next to your items."
	]
	quest.03DBD108CAB3356F.title: "Liquid Assets"
	quest.045874CAA2BFE060.quest_desc: [
		"&ePrometheum&r is Oritech's last material: a Heisenberg Compensator and two Overcharged Crystals in the Atomic Forge."
		""
		"It makes the Ultimate Machine Core, and tools that never break."
	]
	quest.045874CAA2BFE060.title: "Stolen Fire"
	quest.04C19D6ED41C5CA8.quest_desc: ["Netherite ingots and redstone blocks around an Advanced upgrade. The fastest pipes you can make."]
	quest.04C19D6ED41C5CA8.title: "Ultimate Pipe Upgrade"
	quest.053674F41F96C542.quest_desc: ["A &eChemical Tank&r does the same for gases and slurries. A full tank of hydrogen in your pocket fills a jetpack anywhere."]
	quest.053674F41F96C542.title: "Chemical Tanks"
	quest.059037054F4BBC09.quest_desc: [
		"Nether Star Seeds only grow over a &eNether Star Crux&r: two Nether Stars, two Withering Souls, four Insanium Essence and a block of diamond."
		""
		"Nine Nether Star Essence make a shard, and three shards a Nether Star."
	]
	quest.059037054F4BBC09.title: "Nether Star Crux"
	quest.059710CC3283BA98.quest_desc: [
		"The &eAutocrafting Monitor&r shows every craft the network is working on, and lets you cancel one that's stuck."
		""
		"When a big order stalls, look here first."
	]
	quest.059710CC3283BA98.title: "Watch It Work"
	quest.0598186D0C1FD3C3.quest_desc: [
		"No socket on your favorite sword? A &eSigil of Socketing&r adds one. Combine the item and the sigil in a Smithing Table."
		""
		"Sigils can add up to two sockets to an item. Changed your mind about a gem? A &eSigil of Withdrawal&r pops it back out, and you keep both."
		""
		"The recipe needs &eGem-Fused Slate&r, which is deepslate around a pinch of Gem Dust."
	]
	quest.0598186D0C1FD3C3.title: "Make Some Room"
	quest.05AF70930FFD8E13.quest_desc: [
		"Playing with friends? A &eSecurity Manager&r locks the network down: once it's on, nobody can use it until you add a &eSecurity Card&r for them."
		""
		"Each card sets what one player may do. A Fallback Security Card covers everyone else."
	]
	quest.05AF70930FFD8E13.title: "Who Goes There"
	quest.061748C4E1943C74.quest_desc: [
		"Arrows, bones and the odd skull."
		""
		"Right-click a Skeleton with a &eModel Framework&r to attune one. Simulating it costs 128 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.061748C4E1943C74.title: "Skeleton Model"
	quest.061BEFBB012B94CF.quest_desc: ["The &eFurnator&r burns coal, wood and other furnace fuel. Better tiers burn faster and make more from each piece."]
	quest.061BEFBB012B94CF.title: "Furnator"
	quest.06215D112F4387BC.quest_desc: [
		"A full set of &ediamond armor&r is a real step up from iron, and it's the base for netherite later."
		""
		"Don't throw it away when you find netherite: you'll upgrade each piece in a smithing table, and it keeps its enchantments."
	]
	quest.06215D112F4387BC.title: "Dressed in Diamond"
	quest.0684FFD80B7BF030.quest_desc: [
		"Past netherite sit three harder metals: &eAllthemodium&r, &eVibranium&r and &eUnobtainium&r. Each hides somewhere stranger than the last, and each needs a pickaxe made from the one before."
		""
		"Allthemodium Ore needs at least a netherite pickaxe, so that's where the climb starts."
	]
	quest.0684FFD80B7BF030.title: "Beyond Netherite"
	quest.068FA4414CCAC321.quest_desc: [
		"No need to tear out your generator to get a better one. Right-click a placed one with an upgrade, such as &eCopper to Iron Upgrade&r, and it changes on the spot."
		""
		"An &eIron Generator&r makes 16 FE/t, twice the copper one. Each tier on this line climbs from there."
	]
	quest.068FA4414CCAC321.title: "Turn It Up"
	quest.06E2D5161DD649C6.quest_desc: [
		"Many models turn out a &eGeneralized Nether Prediction&r with every simulation, on top of their own. Each model's quest says which kind it makes."
		""
		"They craft into blaze rods, ghast tears, gold, nether wart and soul sand. Four of them around end stone make an Ender one."
	]
	quest.06E2D5161DD649C6.title: "Generalized Nether Prediction"
	quest.06F2EDDB689D0F23.quest_desc: [
		"Many models turn out a &eGeneralized Ender Prediction&r with every simulation, on top of their own. Each model's quest says which kind it makes."
		""
		"They craft into ender pearls, end stone and chorus fruit."
	]
	quest.06F2EDDB689D0F23.title: "Generalized Ender Prediction"
	quest.06F534555780A3B1.quest_desc: [
		"The keys you'll reach for most:"
		""
		"&e`&r  Ultimine: hold it and break a block to take the whole vein, tree or patch"
		"&eB&r  Open your backpack"
		"&eM&r  Claim map"
		"&eJ&r  Full JourneyMap"
		"&eShift+B&r  New waypoint"
		"&eShift+G&r  Curios slots, for rings, charms and belts"
		"&eShift+E&r  Crafting on a Stick, and later the wireless grid"
		"&eCtrl+M&r  Turn your magnet on or off"
		"&eR&r / &eU&r  Recipes and uses, while hovering an item"
		""
		"Change any of them under Options, Controls, Key Binds."
		""
		"Commands anyone can use: &e/sethome&r and &e/home&r, &e/back&r to where you died or last teleported from, &e/spawn&r, &e/tpa <name>&r to ask to join a friend, and &e/rtp&r to jump somewhere far away, once every 10 minutes."
		""
		"Playing with others? The team button at the top left of your inventory makes a party, and everyone in it shares claims, force-loaded chunks and progress in this book."
	]
	quest.06F534555780A3B1.title: "Keys \\& Commands"
	quest.06F701A8F101CE9E.quest_desc: ["An &eInterface&r combines importing and exporting, with slots in between. Hoppers and pipes put things in to store them, and pull out whatever you've set it to stock."]
	quest.06F701A8F101CE9E.title: "The Interface"
	quest.0712ED6C6DCEA76A.quest_desc: [
		"Grows &eEnergized Steel Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Energized Steel and four Imperium Essence on the pedestals."
	]
	quest.0712ED6C6DCEA76A.title: "Energized Steel Seeds"
	quest.0728E3B31BA30CC0.quest_desc: [
		"Power needs a road. Powah's &eEnergy Cables&r carry it from generators to machines."
		""
		"Nearly every Powah recipe starts with &eDielectric Paste&r: three coal, two clay balls and a bucket of lava make a big batch."
		""
		"Pipez &eEnergy Pipes&r work too, if you'd rather match your item pipes."
		""
		"This line climbs Powah's tiers: starter, basic, hardened, blazing, niotic, spirited and nitro, with each tier's rod running alongside. The machines below come in every tier, so take them in any order."
	]
	quest.0728E3B31BA30CC0.title: "Carry the Current"
	quest.07431CCAB9825F77.quest_desc: [
		"The &eBasic Generator&r burns ordinary furnace fuel, like coal, charcoal or wood, and makes 32 RF a tick. That's enough for your first few machines."
		""
		"It's cheap and needs no multiblock, so build a second or third rather than waiting for something better."
	]
	quest.07431CCAB9825F77.title: "Your First Oritech Machine"
	quest.0787D54D56A6B675.quest_desc: ["The blazing tier's rod. Swap a few in and watch the orb speed up."]
	quest.0787D54D56A6B675.title: "Blazing Energizing Rod"
	quest.078FCCEEAB719D91.quest_desc: [
		"Mekanism turns one ore into two ingots, then three, then four, and finally five. Each step is a new machine and a new chemical, and each one pays you back on every ore you mine from then on."
		""
		"Almost all of it starts with &eosmium&r. Smelt a stack and keep it handy."
	]
	quest.078FCCEEAB719D91.title: "Mekanism"
	quest.07BD59A4F375F180.quest_desc: [
		"Deep in the Deep Dark lie the ruins of an &eAncient City&r: halls of deepslate and sculk around a great empty portal frame."
		""
		"Its chests hold some of the best loot underground, and its &eSuspicious Clay&r can hide an Allthemodium Smithing Template, so bring a brush."
		""
		"The Warden lives here too. Sneak, and keep the noise down. Sculk can't hear through wool, so the reward should help."
	]
	quest.07BD59A4F375F180.title: "The Silent City"
	quest.07E13ADC954AED93.quest_desc: [
		"A Wireless Transmitter stops at the edge of its range and at the edge of the dimension it's in. The &eInterdimensional Wireless Transmitter&r doesn't: infinite range, from any dimension."
		""
		"It takes four Wireless Transmitters, four nether stars and an elytra, and it draws more power than an ordinary one."
		""
		"One last thing: a &e64k Storage Disk&r is part of the &eAllthemodium Alloy Paxel&r recipe. The paxel quest gives it back once you've crafted it."
	]
	quest.07E13ADC954AED93.title: "No Borders"
	quest.07EDE8A242B51AB2.quest_desc: [
		"The Wither drops a &eWithering Soul&r when it dies."
		""
		"Three of them make three Wither Skeleton Skulls, enough for the next Wither. Keep two back for the crux."
	]
	quest.07EDE8A242B51AB2.title: "Withering Soul"
	quest.07FAAABD8596911C.quest_desc: [
		"Grows &eNether Quartz Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Nether Quartz and four Tertium Essence on the pedestals."
	]
	quest.07FAAABD8596911C.title: "Nether Quartz Seeds"
	quest.080B9D0F0230DC03.quest_desc: [
		"Suspicious sand and gravel can hide artifacts too. Look around desert pyramids, desert wells, ocean ruins and trail ruins."
		""
		"Hold right-click with a &eBrush&r to dust it off. Mine it with a tool instead and whatever was inside is lost."
	]
	quest.080B9D0F0230DC03.title: "Brush Up"
	quest.08340EB177507491.quest_desc: [
		"Grows &eSilicon Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Silicon and four Prudentium Essence on the pedestals."
	]
	quest.08340EB177507491.title: "Silicon Seeds"
	quest.0855FCBDDE619451.quest_desc: [
		"A &eSharestone&r is a waystone with a color. It takes you to any other sharestone of the same color."
		""
		"Give each part of your world its own color: blue for the coast, green for the farms. Playing with friends? A shared color makes a meeting place everyone can reach."
	]
	quest.0855FCBDDE619451.title: "Sharestones"
	quest.086155A9E07F1B84.quest_desc: [
		"&eTin&r, &eZinc&r and &eAluminum&r spread through a tall band of stone, from deep caves up into the hills. Any decent caving trip turns some up."
		""
		"Aluminum climbs highest of all, so look in mountain cliffs too."
		""
		"Every mod that wants tin, lead or osmium shares one set of ores, so you'll never hold three tin ingots that don't stack. Some gem ores show up in JEI but don't generate in this pack: if an ore isn't in this chapter, don't go looking for it."
	]
	quest.086155A9E07F1B84.title: "Everyday Metals"
	quest.08715E75324D5115.quest_desc: ["And a villager. Something tells you this won't end well for the village."]
	quest.08715E75324D5115.title: "Villain Origin Story"
	quest.088391B0BEA824F5.quest_desc: [
		"In dark caves you may find small, glinting bushes. Those are &eOreberry Bushes&r, and they grow metal."
		""
		"Break one and it comes with you. Replant it somewhere dark: they won't take root in the light."
	]
	quest.088391B0BEA824F5.title: "Berries That Grow Metal"
	quest.08AC6105437441ED.quest_desc: ["Spare seeds are worth something. The &eSeed Reprocessor&r turns each one into two of its essence."]
	quest.08AC6105437441ED.title: "Seed Reprocessor"
	quest.08AD4AF61A9DB09E.quest_desc: [
		"Grows &eDye Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Dye Agglomeratio and four Prudentium Essence on the pedestals."
	]
	quest.08AD4AF61A9DB09E.title: "Dye Seeds"
	quest.08AF5E67639E7E14.quest_desc: [
		"Grows &eExperience Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Experience Capsules and four Imperium Essence on the pedestals."
	]
	quest.08AF5E67639E7E14.title: "Experience Seeds"
	quest.0923A52325656859.quest_desc: [
		"Snowballs."
		""
		"Right-click a Snow Golem with a &eModel Framework&r to attune one. Simulating it costs 64 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.0923A52325656859.title: "Snow Golem Model"
	quest.0963E028E48BD57C.quest_desc: ["Any crop at all, from wheat to whatever Croptopia grows."]
	quest.0963E028E48BD57C.quest_subtitle: "Odd Job"
	quest.0963E028E48BD57C.title: "Harvest Help"
	quest.0986D3CB4ECEDA74.quest_desc: [
		"A &eGrowth Accelerator&r goes under your farmland and speeds up the crop above it."
		""
		"Stack several, of any tier, as long as the crop is within their range. The tooltip shows each one's range."
	]
	quest.0986D3CB4ECEDA74.title: "Growth Accelerator"
	quest.09A8AF9A6AA54E30.quest_desc: [
		"Grows &eDeepslate Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Deepslate and four Inferium Essence on the pedestals."
	]
	quest.09A8AF9A6AA54E30.title: "Deepslate Seeds"
	quest.09AF1489577E1E6E.quest_desc: [
		"In an Exporter, a &eRegulator Upgrade&r only exports while the target holds less than you set. In an Importer, it only imports while the target holds more."
		""
		"Use the upgrade in your hand to set the amount."
	]
	quest.09AF1489577E1E6E.title: "Regulator Upgrade"
	quest.0A0680C2A2915A77.quest_desc: [
		"Raw beef and leather."
		""
		"Right-click a Cow with a &eModel Framework&r to attune one. Simulating it costs 64 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.0A0680C2A2915A77.title: "Cow Model"
	quest.0A07F9D4D7D3B5F0.quest_desc: [
		"A &ePortable Grid&r holds one storage disk and lets you use it with no network at all: two Grids and a Controller in a ring of Quartz Enriched Iron."
		""
		"Use it from your inventory, or sneak and place it as a block. It has its own small battery, so charge it now and then."
	]
	quest.0A07F9D4D7D3B5F0.title: "Storage in a Box"
	quest.0A2A911C712D2779.quest_desc: ["A &eVoid Module&r deletes what's in the router's buffer, filtered or not. A tidy end for overflow."]
	quest.0A2A911C712D2779.title: "Void Module"
	quest.0A72F92664F513E3.quest_desc: [
		"The last page of the cookbook: a &eNether Star Cake&r."
		""
		"Yes, it takes a Nether Star. Yes, you can eat it. Whether you should is between you and your Food Book."
		""
		"Here's a trophy of it to keep, whatever you decide."
	]
	quest.0A72F92664F513E3.title: "A Cake Fit for a Star"
	quest.0A8504E5B99B1D43.quest_desc: [
		"The top of the line. A &eData Center&r runs up to twenty-five Self Aware models at once, all feeding one output."
		""
		"It needs a hollow 7x7x7 shell: an obsidian floor, black stained glass walls and ceiling, and the controller set into the bottom of a wall, facing out. &eData Center IO Ports&r can stand in for any wall or ceiling block to move power, models and items."
	]
	quest.0A8504E5B99B1D43.title: "The Data Center"
	quest.0AD4CF05A37A295B.quest_desc: [
		"The &eFuel Generator&r burns liquid fuel for 256 RF a tick. Crude oil works, but refined fuels go much further per bucket."
		""
		"It only sends power out of the two yellow spots on its front, so run your cables there."
	]
	quest.0AD4CF05A37A295B.title: "Fuel Generator"
	quest.0B16A10D224B7821.quest_desc: ["Gold around iron. Bigger again."]
	quest.0B16A10D224B7821.title: "Gold Backpack"
	quest.0B261DF8010D741B.quest_desc: [
		"Every transmitter comes in four tiers. Each one is eight of the tier below around an alloy: infused for advanced, reinforced for elite and atomic for ultimate."
		""
		"Each tier moves more power, and faster, so it pays to upgrade the busiest lines first."
	]
	quest.0B261DF8010D741B.title: "Ultimate Universal Cable"
	quest.0B29A883C2F19A1E.quest_desc: [
		"Put your rod in a &eTackle Box&r to fit it with a hook, bait, fishing line and a bobber."
		""
		"Hooks change how it fishes: a Double Hook can catch two at once, a Light Hook casts farther, and a Note Hook plays a sound when a fish is coming."
		""
		"&eWorms&r make good bait. A Worm Farm will raise them for you."
	]
	quest.0B29A883C2F19A1E.title: "The Tackle Box"
	quest.0B43596D17178607.quest_desc: [
		"The &eSummit&r takes a full set of &9Rare&r gear, weapon included, and the &cWither&r dead at your feet."
		""
		"Pick your arena with care: the Wither breaks blocks as it fights. Three Wither Skeleton Skulls on four soul sand or soul soil summon it, and the Nether's skeletons drop skull fragments."
	]
	quest.0B43596D17178607.title: "World Tier: Summit"
	quest.0B84A3E5BE9783DF.quest_desc: [
		"Place an item on a &eCutting Board&r, then use it with a knife in hand to chop it up: cabbage into leaves, meat into cuts, a pumpkin into slices."
		""
		"Other tools work too. An axe strips logs and gives you tree bark."
		""
		"Press &eU&r on the board to see everything it can do."
	]
	quest.0B84A3E5BE9783DF.title: "The Cutting Board"
	quest.0B984B38CCB4FA21.quest_desc: [
		"The other road for waste: an Isotopic Centrifuge makes &eplutonium&r, and a PRC turns that into &ePlutonium Pellets&r."
		""
		"JEI shows where they go. Some of the heaviest machinery in Mekanism wants them."
	]
	quest.0B984B38CCB4FA21.title: "Plutonium, Not Polonium"
	quest.0BBD7EA7E8E80EA5.quest_desc: ["Two &eUnobtainium Ingots&r, two &eAllthemodium Ingots&r and a Piglich Heart, into the orb again. This one wants 5,000,000 FE."]
	quest.0BBD7EA7E8E80EA5.title: "Unobtainium Meets Allthemodium"
	quest.0BEE409DF9D8D1A1.quest_desc: [
		"Each jetpack is crafted around one from the tier below, and it keeps its charge when you do."
		""
		"Stone or copper, then iron, gold, diamond, and finally &eEmerald&r. Along the way, steel, electrum and other metals offer a few alternatives at each step."
		""
		"Each tier holds more charge and flies faster. Hover over a jetpack to compare."
	]
	quest.0BEE409DF9D8D1A1.title: "Faster, Higher"
	quest.0C12B88C20FCFE4D.quest_desc: [
		"5,000 Coal in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.0C12B88C20FCFE4D.title: "Coal Singularity"
	quest.0C219C46B19A7D0C.quest_desc: [
		"An &eElevator&r is eight wool around an ender pearl. Stack two or more in a shaft, one above the other, with room to stand on each."
		""
		"Stand on one and jump to go up to the next. Sneak to go down. They can be a long way apart, and the colors don't have to match."
		""
		"Elevators can also be disguised as other blocks, so the shaft can look like part of the wall."
	]
	quest.0C219C46B19A7D0C.title: "Going Up"
	quest.0C2BD9BCDC181F7E.quest_desc: [
		"Past emerald, Hearth \\& Hollow adds jetpacks of its own, made from allthemodium, vibranium and unobtainium."
		""
		"The &eAllthemodium Jetpack&r is built around your emerald one. It's tougher, faster and holds more charge."
		""
		"With elevators in the walls, waystones on every hill and this on your back, the whole world is a short trip away."
	]
	quest.0C2BD9BCDC181F7E.title: "Above the Clouds"
	quest.0C833282401D6BBB.quest_desc: [
		"More patterns than slots? Time to upgrade."
		""
		"ExtraStorage's &eIron Autocrafter&r is an Autocrafter with iron and a chest around it, and it holds more patterns and works faster. Each tier after it is built around the one before."
		""
		"Hover one and hold Shift to see its slots and speed."
	]
	quest.0C833282401D6BBB.title: "Bigger Autocrafters"
	quest.0C8651DB7EAD1818.quest_desc: [
		"The &ePulverizer&r grinds saplings, crops and plants into &eBiomass&r. It's also what Biosteel is made from."
		""
		"You can eat it in a pinch. You won't enjoy it."
	]
	quest.0C8651DB7EAD1818.title: "Biomass"
	quest.0C91907C139CC7DF.quest_desc: [
		"Each &eRange Upgrade&r in a Wireless Transmitter adds 8 blocks to its reach. It's an Upgrade with ender pearls."
		""
		"Several transmitters work together too, if you'd rather cover a wide base."
	]
	quest.0C91907C139CC7DF.title: "A Longer Reach"
	quest.0CC61BCE024A2E4A.quest_desc: ["Before they get to the garden."]
	quest.0CC61BCE024A2E4A.quest_subtitle: "Odd Job"
	quest.0CC61BCE024A2E4A.title: "Creeper Control"
	quest.0CDA0A16614D8DC7.quest_desc: [
		"Four netherite scrap and four gold ingots make one &enetherite ingot&r."
		""
		"One ingot upgrades one piece of diamond gear in a smithing table. Netherite gear is tougher, lasts longer, and floats in lava if you drop it."
		""
		"Here's an upgrade template to get you started."
	]
	quest.0CDA0A16614D8DC7.title: "Netherite"
	quest.0CDF490522849D03.quest_desc: [
		"Point, hold right-click, and a beam melts through stone in front of you."
		""
		"The &eMining Gadget&r runs on power, a little per block, so it needs charging. The reward includes a &eCharging Station&r: feed it coal or logs and it fills whatever sits in its charging slot."
		""
		"There are three models that differ only in looks, so pick the one you like."
	]
	quest.0CDF490522849D03.title: "The Mining Gadget"
	quest.0CEF74E40FB2F4B5.quest_desc: [
		"Crafting every framed shape by hand gets old. The &eFraming Saw&r turns Framed Cubes into any other framed block."
		""
		"Put cubes in, pick a shape from the list, take it out. If you're short of material, it tells you what's missing."
	]
	quest.0CEF74E40FB2F4B5.title: "The Framing Saw"
	quest.0CF868B6B531D184.quest_desc: [
		"Sand, but with grass and green scrub in it. Easier on the feet than a plain desert."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.0CF868B6B531D184.title: "Lush Desert"
	quest.0D1ACFCABE48A061.quest_desc: [
		"A nether star, every time."
		""
		"Right-click a Wither with a &eModel Framework&r to attune one. Simulating it costs 2,560 FE a tick, and every run makes a &eGeneralized Ender Prediction&r as well."
	]
	quest.0D1ACFCABE48A061.title: "Wither Model"
	quest.0D2B97C7DD27D3B5.quest_desc: [
		"5,000 Nickel in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.0D2B97C7DD27D3B5.title: "Nickel Singularity"
	quest.0D4A947038B9D40A.quest_desc: ["Mystical Agradditions adds an essence &ePaxel&r for every tier: the axe, pickaxe and shovel of one tier, on two sticks."]
	quest.0D4A947038B9D40A.title: "One Tool for Everything"
	quest.0D760E2390C4F61B.quest_desc: ["The furnace only does smoking recipes, like a smoker. Good for a kitchen."]
	quest.0D760E2390C4F61B.title: "Augment: Smoking"
	quest.0D91FA312E1E873C.quest_desc: ["Sixteen steel ingots for a new bridge."]
	quest.0D91FA312E1E873C.quest_subtitle: "Commission"
	quest.0D91FA312E1E873C.title: "Steel Order"
	quest.0DF82F3A8A63005E.quest_desc: [
		"Raw porkchops."
		""
		"Right-click a Pig with a &eModel Framework&r to attune one. Simulating it costs 64 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.0DF82F3A8A63005E.title: "Pig Model"
	quest.0DFADB95924EA874.quest_desc: ["Eight generators of a kind around an &eecho shard&r press into one &e8x generator&r. Saves a lot of floor space."]
	quest.0DFADB95924EA874.title: "Eight in One"
	quest.0E11ACD43E3C4DF8.quest_desc: [
		"Flour, sugar, butter, and a lot of patience."
		""
		"Some of these need fruit from trees you may not have planted yet. The Market sells the saplings."
	]
	quest.0E11ACD43E3C4DF8.title: "The Bakery"
	quest.0E1F5B0EF2E5C37A.quest_desc: ["Sugar and an Upgrade make a &eSpeed Upgrade&r. The device works more often, and draws a little more power."]
	quest.0E1F5B0EF2E5C37A.title: "Speed Upgrade"
	quest.0E66799BE221568C.quest_desc: [
		"Stick templates add a second mode to your Construction Stick. Put the stick, a template and the extra item in a &esmithing table&r to apply it."
		""
		"The &eAngel&r template places blocks in mid air or on the far side of a wall. &eDestruction&r takes a whole face down instead, and &eReplacement&r swaps blocks for whatever is in your off hand."
		""
		"Press &eU&r on a template to see what it needs."
	]
	quest.0E66799BE221568C.title: "New Tricks for an Old Stick"
	quest.0E76F5E42544E10A.quest_desc: [
		"Grows &eStone Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Stone and four Inferium Essence on the pedestals."
	]
	quest.0E76F5E42544E10A.title: "Stone Seeds"
	quest.0EE1F465B4ACDEB5.quest_desc: [
		"&eFungal Caves&r are carpeted with moss and rooted dirt and sprout red and brown mushrooms everywhere, with roots hanging from the ceiling."
		""
		"Pick a bowlful on the way. A stew is a good lunch three hundred blocks down."
	]
	quest.0EE1F465B4ACDEB5.title: "Mushroom Country"
	quest.0EE59A78B459C2F8.quest_desc: [
		"An emerald, energized, and hungrier still."
		""
		"Spirited parts make the tier after niotic."
	]
	quest.0EE59A78B459C2F8.quest_subtitle: "Spirited tier"
	quest.0EE59A78B459C2F8.title: "Spirited Crystal"
	quest.0EF2A9AC02797372.quest_desc: [
		"The size upgrade turns your beam into a 3x3 square. A tunnel takes seconds."
		""
		"It asks for diamond blocks, redstone blocks, ender pearls and a diamond pickaxe, so it's a real investment. You won't want to go back."
	]
	quest.0EF2A9AC02797372.title: "Three by Three"
	quest.0F0B905A64EAA527.quest_desc: [
		"Sophisticated chests and barrels have upgrade slots, just like your backpack. Start with an &eUpgrade Base&r: planks and iron."
		""
		"Any upgrade at all finishes this one. The others around it are the ones worth having, in any order."
	]
	quest.0F0B905A64EAA527.title: "Chests with Talents"
	quest.0F3758AE2DF5B079.quest_desc: [
		"More hearts, plain and simple. It comes in 5 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.0F3758AE2DF5B079.title: "Health Boost Augments"
	quest.0F807CFA097F3E69.quest_desc: [
		"Grows &eWater Essence&r, one of the four elemental essences the Awakening Altar needs."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Water Agglomeratio and four Inferium Essence on the pedestals."
	]
	quest.0F807CFA097F3E69.title: "Water Seeds"
	quest.0F901983E9CB704E.quest_desc: ["An Upgrade with a Silk Touch book makes a &eSilk Touch Upgrade&r. In a Destructor, it picks blocks up whole, like a Silk Touch pickaxe."]
	quest.0F901983E9CB704E.title: "Silk Touch Upgrade"
	quest.0F94D1A9132BBF13.quest_desc: ["Each &eAuxiliary Processing Chamber&r lets a machine work one more recipe at a time, at the cost of efficiency."]
	quest.0F94D1A9132BBF13.title: "Processing Chamber"
	quest.102120BAD782AC54.quest_desc: [
		"Dishes from a long way off, made from crops you've found growing wild."
		""
		"Corn, eggplant and cucumbers come from Cultural Delights; rice grows wild near water."
	]
	quest.102120BAD782AC54.title: "From Far Afield"
	quest.1031B3A825D82366.quest_desc: [
		"Eight Inferium Essence around a Wheat Seed make &eInferium Seeds&r, which grow more Inferium Essence. Once a few are in the ground, you'll never need to dig for it again."
		""
		"They grow on any farmland, but do best on Essence Farmland, just below."
	]
	quest.1031B3A825D82366.title: "Plant an Inferium Seed"
	quest.10590A582B10BB54.quest_desc: [
		"A &eDestructor&r breaks the block in front of it and sends it into the network. Pair one with a Constructor and the network can move blocks around on its own."
		""
		"Silk Touch and Fortune upgrades work in it, just like on a pickaxe."
	]
	quest.10590A582B10BB54.title: "Pick It Up"
	quest.10A4DA00ABAC4A9D.quest_desc: [
		"Hold right-click with a &eshield&r and most hits stop dead, arrows included. Keep it in your off hand and you'll wonder how you managed without it."
		""
		"Mekanism Tools adds shields in its own metals too, if you want one that lasts longer."
	]
	quest.10A4DA00ABAC4A9D.title: "Shield Up"
	quest.10F58A7A9E5449E1.quest_desc: [
		"Every automated setup makes something you don't want. A &eTrash Can&r deletes it."
		""
		"The &eItem Trash Can&r has a filter for up to nine items, so it only eats what you tell it to."
		""
		"Pipe your overflow into one and nothing backs up."
	]
	quest.10F58A7A9E5449E1.title: "Take Out the Trash"
	quest.11040994E44DA3A9.quest_desc: ["Down the middle goes a column of &eTurbine Rotors&r, each holding &eTurbine Blades&r. Steam pushes on the blades and spins the rotor."]
	quest.11040994E44DA3A9.title: "Blades and Rotors"
	quest.11331CCF05DCAA35.quest_desc: ["With an &eEverlasting Upgrade&r your backpack can't be destroyed. Dropped, it never despawns and never falls into the void."]
	quest.11331CCF05DCAA35.title: "Forever Yours"
	quest.1192ADD637ED05E0.quest_desc: [
		"Dirty slurry needs a wash. The &eChemical Washer&r cleans it with water, turning Dirty Slurry into Clean Slurry."
		""
		"It drinks a lot of water. An &eElectric Pump&r over a lake keeps it well fed."
	]
	quest.1192ADD637ED05E0.title: "Washing Slurry"
	quest.12075BF07FEA1848.quest_desc: ["Moves over four million RF a tick. It won't join ordinary energy pipes, so run it as its own line."]
	quest.12075BF07FEA1848.title: "Superconductor"
	quest.1274527C4172D943.quest_desc: ["Ten wither skeletons. Skulls are yours to keep."]
	quest.1274527C4172D943.quest_subtitle: "Commission"
	quest.1274527C4172D943.title: "Skull Duty"
	quest.12AA614633E6F06A.quest_desc: [
		"Some drops are easier to farm the old way. The &eMob Masher&r is a mob grinder you can fit with upgrades for Sharpness, Looting, Fire Aspect and more. Its kills count as player kills."
		""
		"For a steady supply of monsters, &eDreadful Dirt&r spawns them in the dark. Keep it out of the daylight, or it catches fire."
	]
	quest.12AA614633E6F06A.title: "Mob Masher"
	quest.12B47441FFAF6872.quest_desc: [
		"Right-click your crops with a &eWatering Can&r and they grow faster."
		""
		"Upgraded with essence, a can reaches further and grows things quicker. &eShift+right-click&r into the air with an upgraded can to have it water on its own."
	]
	quest.12B47441FFAF6872.title: "Watering Can"
	quest.12D9B8D85AAB63D7.quest_desc: [
		"A &eRelay&r passes the network on to the cables behind it, and redstone can switch it off. Use it to turn a whole wing of the network on or off."
		""
		"It can also pass along only some of the network, like its storage or its patterns, which makes a separate branch for a friend's base."
	]
	quest.12D9B8D85AAB63D7.title: "Branch Lines"
	quest.12F5BD1F0D1406B7.quest_desc: [
		"Macaw's Holidays has decorations for autumn and winter: carved pumpkins, scarecrows, autumn leaves in red, orange and yellow, snowmen, garlands, wreaths and string lights."
		""
		"Some pieces have more than one look. Right-click them to switch, and check the tooltip."
	]
	quest.12F5BD1F0D1406B7.title: "For the Season"
	quest.13014BA2499A6131.quest_desc: [
		"A &eFramed Cube&r is an empty frame that can look like any other block. Right-click it with a block in hand and it takes on that block's look."
		""
		"There are framed slopes, stairs, slabs, panels, doors and dozens more, so you can make shapes no ordinary block comes in, in any material you like."
		""
		"Right-click a framed block with &eGlowstone Dust&r to make it glow. A &eFramed Hammer&r takes the look back off."
	]
	quest.13014BA2499A6131.title: "Wear Any Face"
	quest.1304BD217F005A96.quest_desc: [
		"Set a &eTree Cutter&r in front of a tree and it takes the whole thing down, leaves and all, and keeps the saplings and fruit that drop."
		""
		"Pair it with a Placer for a tree farm that runs itself."
	]
	quest.1304BD217F005A96.title: "Tree Cutter"
	quest.13275702E1FF764F.quest_desc: ["An &eExtruder Module Mk1&r places a line of blocks from the buffer when the router gets a redstone signal, and pulls them back when it stops. Instant doors and bridges."]
	quest.13275702E1FF764F.title: "Extruder Module"
	quest.132A6900659A1304.quest_desc: ["A room full of machines gets loud. &eMuffling Upgrades&r quiet them down."]
	quest.132A6900659A1304.title: "Muffling Upgrade"
	quest.1345AA2EA95C215A.quest_desc: [
		"The &eHand Drill&r is a pickaxe and a shovel in one, runs on power instead of durability, and never breaks."
		""
		"Each block costs power according to how hard it is, so keep it charged."
	]
	quest.1345AA2EA95C215A.title: "Hand Drill"
	quest.135E35D4449D29E5.quest_desc: ["Holds 256 buckets and keeps them when you break it. Stack tanks and the fluid flows down into the lower ones."]
	quest.135E35D4449D29E5.title: "Portable Tank"
	quest.13695F7F355074C4.quest_desc: [
		"Turn a wide patch of grass into path at once. It comes in 4 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.13695F7F355074C4.title: "Pathing Area Augments"
	quest.137B469576A8CCE6.quest_desc: ["Refined Storage processors: Basic, Improved or Advanced. A mix is fine."]
	quest.137B469576A8CCE6.quest_subtitle: "Commission"
	quest.137B469576A8CCE6.title: "Processor Batch"
	quest.1381966F616584D1.quest_desc: [
		"A crafting table on a stick. Right-click it to craft wherever you stand."
		""
		"Better yet, tuck it into its Curios slot and press &eShift+E&r to open it without digging through your bags. Anything you leave in the grid is still there next time."
	]
	quest.1381966F616584D1.title: "A Workbench in Your Pocket"
	quest.13AA35AC54E2BCEC.quest_desc: ["Duratium around a &eDubious Container&r. One step from the top."]
	quest.13AA35AC54E2BCEC.title: "Ultra Machine Core"
	quest.13C6D6D1360653CF.quest_desc: [
		"Villages here come in far more shapes than the usual. Towns and Towers builds them to suit the land, plus special towns in Tudor, Swedish, Iberian and Mediterranean styles. ChoiceTheorem's Overhauled Village adds villages for nearly every biome, some of them walled."
		""
		"Visit one of each. Most villages have a waystone, and a village is a fine place to trade for what you can't find."
	]
	quest.13C6D6D1360653CF.title: "Every Town Is Different"
	quest.143980085A5AA972.quest_desc: [
		"Chests fill up. Then the chests need chests. Refined Storage puts everything you own into one network you can search, sort and craft from."
		""
		"Almost every part of it starts with &eQuartz Enriched Iron&r: three iron ingots and a piece of quartz make four."
		""
		"The top line builds the network itself. Each line below it is a separate track to follow once it's running."
	]
	quest.143980085A5AA972.title: "One Network for Everything"
	quest.143B863D240BBEAB.quest_desc: [
		"The &eAssembler&r crafts Oritech's components, like motors and magnetic coils, on its own 2x2 grid. Many parts can be made by hand, but the assembler uses far less material."
		""
		"The order of the inputs doesn't matter, and Refined Storage autocrafting works with it out of the box."
	]
	quest.143B863D240BBEAB.title: "The Assembler"
	quest.144830592379A7CB.quest_desc: ["The &eEquipment Charger&r tops up powered tools and armor quickly, and fills the fuel tanks of jetpacks."]
	quest.144830592379A7CB.title: "Equipment Charger"
	quest.1488E2F6B38359C5.quest_desc: ["The village feast needs bread, and plenty of it."]
	quest.1488E2F6B38359C5.quest_subtitle: "Odd Job"
	quest.1488E2F6B38359C5.title: "Baker's Order"
	quest.1490815FED2A7655.quest_desc: [
		"Two &eDrone Ports&r at least 50 blocks apart, linked with a Target Designator, fly items between them. Add a Fluid Addon to carry liquids too."
		""
		"Both ends need to be chunk-loaded."
	]
	quest.1490815FED2A7655.title: "Drone Port"
	quest.14B1F4BA1A3BE476.quest_desc: [
		"A Supremium Block on the altar, four Cognizant Dust on the pedestals and ten of each elemental essence in the vessels make an &eAwakened Supremium Block&r."
		""
		"Break it down for nine &eAwakened Supremium Essence&r. Its ingots and gemstones work like any other tier's."
	]
	quest.14B1F4BA1A3BE476.title: "Awakened Supremium"
	quest.150E35B79590BED2.quest_desc: ["&eThermodynamic Conductors&r carry heat between blocks that use it, like a Resistive Heater and the Thermal Evaporation Plant."]
	quest.150E35B79590BED2.title: "Moving Heat"
	quest.155927DE8A181767.quest_desc: [
		"Pale flowers under tall trees. It's at its best after dark."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.155927DE8A181767.title: "Moonlight Grove"
	quest.15638F6B41DA25BE.quest_desc: [
		"The last page of the field notes is the strangest place in the world."
		""
		"Past the dragon's island, the outer End has its own lands: crystal peaks, shadowlands and the empty void barrens."
		""
		"Here's a globe for the study, and a map to go with it."
	]
	quest.15638F6B41DA25BE.title: "Beyond the Dragon"
	quest.1579194BF2C094AE.quest_desc: [
		"Essence gear takes &eAugments&r: small upgrades like Speed, Night Vision or a bigger mining area."
		""
		"They go in at a &eTinkering Table&r, made from stone and Soulium Dust. Put the gear in, then slot the augments around it."
	]
	quest.1579194BF2C094AE.title: "The Tinkering Table"
	quest.15A78D0C8B59FB54.quest_desc: ["A mace that calls down lightning when it hits. Like any mace, it hits harder the further you fall first."]
	quest.15A78D0C8B59FB54.title: "Electric Mace"
	quest.15B40A5194C9C466.quest_desc: [
		"Prefer a proper field to pots? The &eHarvester Pylon&r harvests ripe crops in a square around it, from 3x3 up to 9x9, and puts them in a chest on top."
		""
		"Set it in the water block of your farm or level with the crops. It needs a hoe inside, which loses a point of durability with each harvest, so Unbreaking is a good friend here."
	]
	quest.15B40A5194C9C466.title: "Harvester Pylon"
	quest.15DB8A6DADF7653F.quest_desc: ["Four Allthemodium Ingots, straight from the deep."]
	quest.15DB8A6DADF7653F.quest_subtitle: "Grand Bounty"
	quest.15DB8A6DADF7653F.title: "Allthemodium Shipment"
	quest.15E5C3A1A34B523D.quest_desc: [
		"The &eDestroyer&r breaks the blocks under its frame, one by one. Harder blocks take longer and more power."
		""
		"Build it over a field with a Crop Filter Addon and it's a harvester. Build it over stone and it's a quarry."
	]
	quest.15E5C3A1A34B523D.title: "Destroyer"
	quest.15F8189333D323C8.quest_desc: ["Speeds up the XP Solidifier, or the Entity Spawner."]
	quest.15F8189333D323C8.title: "XP Speed"
	quest.1619F2C02A17CF7D.quest_desc: [
		"Grows &eAluminum Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Aluminum Ingots and four Prudentium Essence on the pedestals."
	]
	quest.1619F2C02A17CF7D.title: "Aluminum Seeds"
	quest.163837E13A16EA4F.quest_desc: [
		"A &eMachine Addon Extender&r attaches like an addon and gives you more addon spots. How many extenders a machine can take depends on its core quality."
		""
		"That's where better machine cores pay off."
	]
	quest.163837E13A16EA4F.title: "Room for More"
	quest.165C298B4DCBBA9E.quest_desc: ["The fastest rods there are."]
	quest.165C298B4DCBBA9E.title: "Nitro Energizing Rod"
	quest.166E753301E3FD6F.quest_desc: [
		"Grows &eCow Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of cow souls and four Prudentium Essence on the pedestals."
	]
	quest.166E753301E3FD6F.title: "Cow Seeds"
	quest.167616BB0903DE82.quest_desc: ["A &eDeposit Upgrade&r unloads the backpack into a chest when you sneak and right-click the chest. A &eRestock Upgrade&r does the reverse."]
	quest.167616BB0903DE82.title: "Empty Your Pockets"
	quest.16B2A4A03DA2F593.quest_desc: [
		"Seeds, a used Mob Swab and a bucket of liquid experience make &eGM Chicken Feed&r. Feed it to a chicken and it turns that DNA into the mob's spawn egg, for the Entity Spawner."
		""
		"The chicken only gets the one go. JEI shows the details."
	]
	quest.16B2A4A03DA2F593.title: "Chicken Feed, Modified"
	quest.16B6BBC93215E6BF.quest_desc: [
		"A &eFeeding Trough&r breeds animals for you. Fill it with their food and it feeds any nearby animal that's ready to mate."
		""
		"It stops once there are 24 of a kind around, so your pen won't overflow."
	]
	quest.16B6BBC93215E6BF.title: "Feeding Time"
	quest.16CFB9A26822AC29.quest_desc: ["The Refinery is built from three of these, and up to two more stacked on top give it extra outputs. Pull those fluids from the modules, not the base."]
	quest.16CFB9A26822AC29.title: "Refinery Chamber Module"
	quest.16DF7C38ED7D6E80.quest_desc: [
		"A Chemical Crystallizer packs antimatter into an &eAntimatter Pellet&r."
		""
		"Each pellet is a whole bucket of the stuff. Hold it carefully: one goes into the &eSpark of Creation&r, in its own chapter."
	]
	quest.16DF7C38ED7D6E80.title: "Impossible Material"
	quest.16E214F36D126CC6.quest_desc: ["A laser you carry. One mode mines blocks from far away. The other makes things explode. &eShift+right-click&r switches between them."]
	quest.16E214F36D126CC6.title: "Portable Laser"
	quest.1701B5AD38CD52FD.quest_desc: ["Somewhere to thaw out afterward. Oases count double in the heart, if not in the book."]
	quest.1701B5AD38CD52FD.title: "Warm Places"
	quest.1702438719AAB86F.quest_desc: [
		"Grows &eDirt Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Dirt and four Inferium Essence on the pedestals."
	]
	quest.1702438719AAB86F.title: "Dirt Seeds"
	quest.171C3838945290BC.quest_desc: [
		"5,000 Silver in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.171C3838945290BC.title: "Silver Singularity"
	quest.174C46A9FEA0F4E0.quest_desc: ["Adds two million RF to a machine's battery and lets it take power in faster. Good for anything that works in bursts."]
	quest.174C46A9FEA0F4E0.title: "Capacitor Addon"
	quest.175ECA0CFCA7858E.quest_desc: [
		"Wet sponges, prismarine and a lot of fish."
		""
		"Right-click an Elder Guardian with a &eModel Framework&r to attune one. Simulating it costs 1,024 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.175ECA0CFCA7858E.title: "Elder Guardian Model"
	quest.1762969A24C7FE6C.quest_desc: [
		"Each tier is built on the one below: an Imperium piece between two &eSupremium Ingots&r and two &eSupremium Gemstones&r."
		""
		"Damage and enchantments carry over, so nothing you put into the old piece is lost."
	]
	quest.1762969A24C7FE6C.title: "Supremium Gear"
	quest.1773395362D097ED.quest_desc: [
		"The biggest disk Refined Storage makes on its own, built with Advanced Processors."
		""
		"A 64k disk also goes into the &eAllthemodium Alloy Paxel&r, so keep that in mind for later."
	]
	quest.1773395362D097ED.title: "64k Storage Disk"
	quest.17768AA219D41404.quest_desc: [
		"A &eSharestone&r links only to other sharestones of the same color. Put a pair of red ones at your base and your mine, and you have a private line between them."
		""
		"Each one takes a Warp Stone to make, so plan your colors before you craft."
	]
	quest.17768AA219D41404.title: "Matching Pairs"
	quest.17C35BFCAEBA1BBB.quest_desc: ["Tier 3 holds a lot. Conversion recipes turn the tier you have into a better one, so nothing goes to waste."]
	quest.17C35BFCAEBA1BBB.title: "Stack Upgrade Tier 3"
	quest.17FE0B3DF0A2DB5E.quest_desc: ["Voids energy. It can also cap how fast it takes it, which makes it a handy limiter."]
	quest.17FE0B3DF0A2DB5E.title: "Energy Trash Can"
	quest.1806337BC707BBAB.quest_desc: [
		"The &eConfigurator&r is Mekanism's wrench. It can set a machine's sides, empty its tanks, rotate it, or pick it up."
		""
		"Hover over it to see its current mode and the key that switches it."
	]
	quest.1806337BC707BBAB.title: "The Configurator"
	quest.180677ED035E6F04.quest_desc: ["The top of the line, built around a Vibranium Jetpack. The fastest thing in the sky, and the toughest thing to wear on your back."]
	quest.180677ED035E6F04.title: "Unobtainium Jetpack"
	quest.1807251A0DBF9634.quest_desc: [
		"Land a fish worth bragging about. A tuna, a catfish, an arapaima, a halibut: something that took a while to reel in."
		""
		"They're rare, so be patient. Tuna and grouper live in the ocean, arapaima in jungle water, and catfish and muskellunge in rivers and lakes."
	]
	quest.1807251A0DBF9634.title: "One for the Wall"
	quest.186164B6E9DF1596.quest_desc: ["A &eScuba Mask&r and a &eScuba Tank&r full of oxygen let you breathe underwater for a good long while."]
	quest.186164B6E9DF1596.title: "Under the Sea"
	quest.189024CF01577218.quest_desc: [
		"Grows &eLumium Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Lumium Ingots and four Imperium Essence on the pedestals."
	]
	quest.189024CF01577218.title: "Lumium Seeds"
	quest.18A36FCF159CA190.quest_desc: ["Ultimate Bins and Atomic Alloy make a Creative Bin. Put one item in, and it hands out that item forever."]
	quest.18A36FCF159CA190.title: "A Bin That Gives"
	quest.192EFC51CA2C567A.quest_desc: ["An extender with a big battery built in: more addon spots and millions of RF of storage in one block."]
	quest.192EFC51CA2C567A.title: "Power Bank Addon Extender"
	quest.19A28662874641C7.quest_desc: [
		"The &eNetherite Stick&r places up to 1024 blocks at a time. Floors, walls and bridges go down in a few clicks."
		""
		"It takes a netherite ingot to make, so maybe wait until you have a spare."
	]
	quest.19A28662874641C7.title: "The Big Build"
	quest.19DCC7B13D81267F.quest_desc: [
		"Every fish in the Angler's Log, starting close to home."
		""
		"These live in rivers and lakes in ordinary country: forests, plains and hills. A few of them skip the warm biomes, and a few skip the snowy ones."
		""
		"Each one only needs to be in your inventory once. Release them afterward if you like."
	]
	quest.19DCC7B13D81267F.title: "Rivers and Lakes"
	quest.19F9892805712E60.quest_desc: ["A &eLaser Amplifier&r collects energy from lasers aimed into it and fires it all out in one big pulse. That pulse is what lights a fusion reactor."]
	quest.19F9892805712E60.title: "Store the Beam"
	quest.1A1905EFB2633500.quest_desc: [
		"Four Imperium make &eSupremium Essence&r, the top tier in Mystical Agriculture itself. The seeds for the most precious materials need it."
		""
		"One more step remains, from Mystical Agradditions. That's the end of this line."
	]
	quest.1A1905EFB2633500.title: "Supremium"
	quest.1A341565D8A6BFE6.quest_desc: ["An &eEnder Cell&r stores power in a channel of your own Ender Network. Every cell on that channel shares it, wherever it is in the world."]
	quest.1A341565D8A6BFE6.title: "Ender Cell"
	quest.1A42B59E69B6F1C7.quest_desc: [
		"Grows &eCopper Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Copper Ingots and four Tertium Essence on the pedestals."
	]
	quest.1A42B59E69B6F1C7.title: "Copper Seeds"
	quest.1A4501EFB6D51C7C.quest_desc: [
		"Pipes can go into any chest in a controller's wall, but an &eStorage Input&r, &eStorage Output&r or &eStorage I/O&r block makes a tidy spot for them."
		""
		"Place one in the wall: input lets you pipe items in, output lets you pipe them out, and I/O does both."
	]
	quest.1A4501EFB6D51C7C.title: "In and Out"
	quest.1A5EE4EE9C98EE6C.quest_desc: [
		"The &eFertilizer&r waters the farmland below its frame and speeds up whatever grows there, like weak bone meal."
		""
		"Give it Mineral Slurry instead of water and the effect gets much stronger."
	]
	quest.1A5EE4EE9C98EE6C.title: "Fertilizer"
	quest.1A6A5E62AF12A9FA.quest_desc: ["Built from a Tier 1 upgrade, and each slot holds more again. There's a Tier 1 Plus in between if you want a cheaper step."]
	quest.1A6A5E62AF12A9FA.title: "Stack Upgrade Tier 2"
	quest.1A7B80692C7C375E.quest_desc: ["Faster again. Built around an iron or silver furnace."]
	quest.1A7B80692C7C375E.title: "Golden Furnace"
	quest.1AB5DC71B489C069.quest_desc: [
		"Grows &eSteel Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Steel Ingots and four Imperium Essence on the pedestals."
	]
	quest.1AB5DC71B489C069.title: "Steel Seeds"
	quest.1AC41EFE0EA289F6.quest_desc: ["A filter in an upgrade can name a destination. Click a block with the &eFilter Destination Tool&r, then add it to a filter, and matching items go only there."]
	quest.1AC41EFE0EA289F6.title: "Send It There"
	quest.1ADF72118EEE6768.quest_desc: ["The &eOsmium Compressor&r burns osmium to press dusts into Refined Obsidian and Refined Glowstone."]
	quest.1ADF72118EEE6768.title: "The Osmium Compressor"
	quest.1B069CCAD8B66D44.quest_desc: [
		"Blaze rods, with no fortress to find."
		""
		"Right-click a Blaze with a &eModel Framework&r to attune one. Simulating it costs 256 FE a tick, and every run makes a &eGeneralized Nether Prediction&r as well."
	]
	quest.1B069CCAD8B66D44.title: "Blaze Model"
	quest.1B2D4C086D213720.quest_desc: [
		"The &eQuantum Compressor&r crushes 5,000 of one material into a &eSingularity&r, using 5,000,000 FE to do it."
		""
		"It needs an &eUltimate Catalyst&r in its catalyst slot, and it keeps it."
		""
		"There are nineteen singularities to make. They'll take a while, so set up farms and let the compressor chew."
	]
	quest.1B2D4C086D213720.title: "Quantum Compression"
	quest.1B378960BF299315.quest_desc: [
		"Grows &eBreeze Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of breeze souls and four Imperium Essence on the pedestals."
	]
	quest.1B378960BF299315.title: "Breeze Seeds"
	quest.1B612907F6B6A38E.quest_desc: ["The &eXP Solidifier&r turns liquid experience into edible &eXP Jellies&r, using a mould. Eat one for its experience, or keep them for the next quest."]
	quest.1B612907F6B6A38E.title: "XP Jellies"
	quest.1B86F686C714BC59.quest_desc: [
		"Wear an affix item in all four armor slots and hold an affix weapon, and the &eFrontier&r tier unlocks."
		""
		"Tiers don't switch on by themselves. Open &eCtrl+T&r, pick Frontier and activate it. Monsters get tougher and loot gets better, and from here on &cApothic Invaders&r start to show up."
		""
		"You can switch back to an easier tier any time."
	]
	quest.1B86F686C714BC59.title: "Ready for the Frontier"
	quest.1B8FCC1116D3F297.quest_desc: ["A &eCardboard Box&r picks up a block, contents and all. Sneak and right-click a full chest, carry it anywhere, and put it down again."]
	quest.1B8FCC1116D3F297.title: "Moving Day, Mekanism Style"
	quest.1BB42BC320CB5062.quest_desc: [
		"A &eLogistical Transporter&r carries items from one inventory to another. You can watch them ride along the pipe."
		""
		"Machines push their output into a transporter by themselves if the side config says so."
	]
	quest.1BB42BC320CB5062.title: "Moving Items"
	quest.1BC71C2BD841B2CD.quest_desc: [
		"Handcrafted makes proper furniture: chairs, couches, benches, tables, desks, shelves and cupboards, in every kind of wood."
		""
		"Right-click a chair or couch to sit down."
		""
		"Dress things up with fabric. Right-click a chair with a &eCushion&r, or a table with a &eSheet&r, to give it a seat pad or a tablecloth in that color."
	]
	quest.1BC71C2BD841B2CD.title: "Pull Up a Chair"
	quest.1BD36E35D7190F10.quest_desc: [
		"No more rolling the dice. The &eEnchanter&r gives you the enchantment you pick, for a set price in materials and &eExperience Essence&r."
		""
		"Efficiency, for example, takes redstone and a stack of Experience Essence. Experience Seeds are the ones to plant for it."
	]
	quest.1BD36E35D7190F10.title: "The Enchanter"
	quest.1BF3D6E3FF628002.quest_desc: [
		"The &eEntity Spawner&r spawns the mob from a spawn egg in its top slot, in a 3x3 area, and eats XP Jellies to do it. Upgrades make the area bigger."
		""
		"Put a Mob Masher in front of it and you have a farm for any drop you like."
	]
	quest.1BF3D6E3FF628002.title: "Entity Spawner"
	quest.1BF6AF98B756BF4E.quest_desc: [
		"Some of those campsite chests are &cMimics&r. Open one and it opens you right back."
		""
		"They hop, they bite, and they're tougher than they look. Fight one with good armor on and a full belly."
		""
		"The reward is worth the bruises: a beaten Mimic coughs up artifacts."
	]
	quest.1BF6AF98B756BF4E.title: "Not a Chest"
	quest.1C13CEDB4B9F5477.quest_desc: ["A backpack that carries a small warehouse."]
	quest.1C13CEDB4B9F5477.title: "Stack Upgrade Tier 2"
	quest.1C36DF7EAAA290B4.quest_desc: [
		"A &eRadioactive Waste Barrel&r holds waste and slowly makes it safe. It's the place for anything you can't use."
		""
		"Most waste is worth more than that, though: it's where polonium and plutonium come from."
	]
	quest.1C36DF7EAAA290B4.title: "Somewhere to Put It"
	quest.1C38FB01E03E717F.quest_desc: ["Pulls nearby items straight to you."]
	quest.1C38FB01E03E717F.title: "Magnetic Attraction Unit"
	quest.1C453D7D168732FB.quest_desc: ["Fix an &eXP Tap&r to the side of a tank and it turns the liquid back into orbs. Stand under it and soak it up."]
	quest.1C453D7D168732FB.title: "XP Tap"
	quest.1C5A7184F90DB134.quest_desc: [
		"Grows &eObsidian Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Obsidian and four Tertium Essence on the pedestals."
	]
	quest.1C5A7184F90DB134.title: "Obsidian Seeds"
	quest.1CBB82802FC6D781.quest_desc: ["Gold chests and barrels hold more again, with another upgrade slot. Upgrade in place or craft one around an iron chest."]
	quest.1CBB82802FC6D781.title: "Gold Tier"
	quest.1CCDCB049D9FD108.quest_desc: ["Drinks lava for 40 FE/t. Pipe it from a Nether lake and it never stops."]
	quest.1CCDCB049D9FD108.title: "Magmatic Generator"
	quest.1CFC5BCEA9656A63.quest_desc: ["Four Nitro Energy Cells and four Nitro Crystals make a Creative Energy Cell."]
	quest.1CFC5BCEA9656A63.title: "Powah, Unlimited"
	quest.1CFFF84E84084992.quest_desc: [
		"Magma cream."
		""
		"Right-click a Magma Cube with a &eModel Framework&r to attune one. Simulating it costs 256 FE a tick, and every run makes a &eGeneralized Nether Prediction&r as well."
	]
	quest.1CFFF84E84084992.title: "Magma Cube Model"
	quest.1D26C6E1A8BDD2B6.quest_desc: ["The &eSender Module Mk2&r sends items to any inventory nearby, with no line of sight needed. Most routers end up with one."]
	quest.1D26C6E1A8BDD2B6.title: "Sender Module Mk2"
	quest.1D3BF77D1CB34C70.quest_desc: [
		"Many models turn out a &eGeneralized Overworld Prediction&r with every simulation, on top of their own. Each model's quest says which kind it makes."
		""
		"They craft into everyday drops: bones, gunpowder, rotten flesh, iron and more. Four of them around netherrack make a Nether one."
	]
	quest.1D3BF77D1CB34C70.title: "Generalized Overworld Prediction"
	quest.1D8C13C5D445839D.quest_desc: [
		"Mekanism Tools makes full sets of tools and armor from more than just iron and diamond."
		""
		"&eLapis lazuli&r and &eosmium&r gear is easy to start with. &eBronze&r and &esteel&r come once you can make alloys, and the refined metals once Mekanism's machines are running."
		""
		"Press &eR&r on any of them to compare."
	]
	quest.1D8C13C5D445839D.title: "Other Metals"
	quest.1DB81C1A0E6474C6.quest_desc: ["The &eQuantum Entangloporter&r sends items, fluids, chemicals, heat and power to every other entangloporter on its frequency, even across dimensions."]
	quest.1DB81C1A0E6474C6.title: "Quantum Entangloporter"
	quest.1DBF1C72400C8C4A.quest_desc: [
		"A &ePickup Upgrade&r scoops items into your backpack as you walk over them."
		""
		"Craft it into a &eMagnet Upgrade&r and the backpack pulls them in from a few blocks away. Mining, farming and mob fights get a lot less fiddly."
		""
		"Both have filters, so you can leave the cobblestone on the ground."
	]
	quest.1DBF1C72400C8C4A.title: "Pull It In"
	quest.1DD84909B8530028.quest_desc: [
		"Set the Ultimate Singularity in the middle of the Ultimate Crafting Table, ring it with twelve &eCrystaltine Ingots&r, and put a &eBlock of Black Iron&r in each corner of the ring."
		""
		"Out comes &eThe Ultimate Ingot&r. Hold on to it."
	]
	quest.1DD84909B8530028.title: "The Ultimate Ingot"
	quest.1E020D6AAB84F089.quest_desc: [
		"A &eSolar Panel&r makes power in daylight. Anything blocking the sky above it stops it."
		""
		"A &eLens of Ender&r fitted to a panel lets it see through blocks, so you can bury it under a floor."
	]
	quest.1E020D6AAB84F089.title: "Solar Panel"
	quest.1E496E2ED47A7FDD.quest_desc: [
		"&eLuminax&r blocks are colored stone that gives off light, made from stone, a dye and glowstone dust."
		""
		"They come as blocks, stairs, slabs, walls, buttons and pressure plates in all sixteen colors, so a floor or a ceiling can be the light. Dim versions are made with wool instead of glowstone."
	]
	quest.1E496E2ED47A7FDD.title: "Glow in Color"
	quest.1E9411F8738A9CF6.quest_desc: [
		"5,000 Electrum in the Quantum Compressor."
		""
		"Electrum is an alloy. Press &eR&r on the ingot to see what makes it."
	]
	quest.1E9411F8738A9CF6.title: "Electrum Singularity"
	quest.1EBD11F16E51110E.quest_desc: [
		"Artifacts turn up in loot chests all over: dungeons, mineshafts, temples, shipwrecks, strongholds and village houses."
		""
		"Each one does one thing well. A &eCloud in a Bottle&r gives you a double jump, &eFlippers&r make you a fish, and the &eAntidote Vessel&r cuts poisons short."
		""
		"Hover over an artifact to see what it does, then wear it in a Curios slot: press &eShift+G&r to open them. There are slots for your head, neck, belt, hands, feet and more."
		""
		"Deep underground you may stumble on a little abandoned campsite. Its loot leans towards artifacts, but knock on the chest before you open it."
	]
	quest.1EBD11F16E51110E.title: "Finders Keepers"
	quest.1EC8865833770926.quest_desc: [
		"The &eFusion Reactor&r is a ring of Reactor Frame around a &eFusion Reactor Controller&r, with Reactor Ports to feed it and a &eLaser Focus Matrix&r for the amplifier to fire into."
		""
		"Once it's lit and fed, it runs as long as the fuel lasts, and it doesn't make waste."
	]
	quest.1EC8865833770926.title: "A Star in a Box"
	quest.1ED950662D2763B3.quest_desc: [
		"Sooner or later every base turns into a maze of chests. This chapter is about taming the pile: chests and backpacks that grow with you. Moving things between them is in &eLogistics&r."
		""
		"Start with a Sophisticated &echest&r or &ebarrel&r: planks around a lever. It holds as much as a vanilla chest, plus a slot for an upgrade."
		""
		"Already have chests full of stuff? Right-click a placed vanilla chest with a &eBasic Tier Upgrade&r and it becomes a Sophisticated one, with everything still inside."
		""
		"Some clicks that save clicking: &eShift&r and drag moves a whole row of items, &eCtrl&r-click moves one, &eSpace&r-click moves everything, and &eMiddle-click&r sorts."
	]
	quest.1ED950662D2763B3.title: "Packing It In"
	quest.1F62F17ACBD1A0A7.quest_desc: [
		"Put a fish and a &eFillet Knife&r in the crafting grid to cut it into fish fillets."
		""
		"Cooked fillets are quick, easy food, and they count for the Food Book like anything else."
	]
	quest.1F62F17ACBD1A0A7.title: "Fish Fillets"
	quest.1F67D9765183075C.quest_desc: ["A &ePipe Duct&r is a pipe wrapped in plating and stone, for runs that should look like part of the wall. Ducts only join other pipes, not machines, so end each run with an ordinary pipe."]
	quest.1F67D9765183075C.title: "Pipe Ducts"
	quest.1F7BCF7C2C5317D7.quest_desc: [
		"Grows &eEnd Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four End Agglomeratio and four Imperium Essence on the pedestals."
	]
	quest.1F7BCF7C2C5317D7.title: "End Seeds"
	quest.1F85DA4ECC1B2654.quest_desc: ["The &ePlacer Module&r puts a block from the router's buffer in front of it. Handy for replanting, or for setting blocks where a machine expects them."]
	quest.1F85DA4ECC1B2654.title: "Placer Module"
	quest.1F8973A17F817A3A.quest_desc: [
		"Macaw's Fences and Walls has picket fences, stockade walls, horse fences, wrought-iron railings, hedges and modern stone walls."
		""
		"Some of them stack upward into a taller wall, and the tooltip says which. Wired fences hurt anything that pushes through them, so keep them away from the path."
		""
		"Fences in this pack also join up corner to corner, so a fence can run diagonally."
	]
	quest.1F8973A17F817A3A.title: "Good Fences"
	quest.1FAFEC5E2B2A7788.quest_desc: ["More per slot again. Each tier is built from the one before, and conversion recipes skip a step if you have the materials."]
	quest.1FAFEC5E2B2A7788.title: "Stack Upgrade Tier 1"
	quest.1FED4F187694C37A.quest_desc: [
		"Mekanism's &eJetpack&r burns hydrogen instead of FE. Fill it from your Electrolytic Separator or a Chemical Tank."
		""
		"It has a hover mode too. An &eArmored Jetpack&r adds protection, if you can spare the chest slot."
	]
	quest.1FED4F187694C37A.title: "Hydrogen Jetpack"
	quest.1FF8A61D92046A07.quest_desc: [
		"Four Inferium around your crystal make &ePrudentium Essence&r, the second of five tiers."
		""
		"Each tier opens up more resource seeds, better farmland and faster growth accelerators. Every step up costs four of the step below, so a big inferium field pays off."
	]
	quest.1FF8A61D92046A07.title: "Prudentium"
	quest.202A345B110DB328.quest_desc: [
		"Four Allthemodium Nuggets around an Ender Pearl make a &eTeleport Pad&r."
		""
		"Place it in the Overworld, empty both hands, then sneak and right-click it."
		""
		"&cIt doesn't drop when you break it&r, so pick its spot carefully."
	]
	quest.202A345B110DB328.title: "Teleport Pad"
	quest.20328547FDC8F3A3.quest_desc: [
		"Your swings catch whatever's standing around the target too. It comes in 3 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.20328547FDC8F3A3.title: "Attack Area Augments"
	quest.2038E7A17CB7EF02.quest_desc: [
		"Some recipes don't fit in a 3x3 grid. Extended Crafting adds bigger tables, and they all start with &eBlack Iron&r: an iron ingot and black dye."
		""
		"You'll want &eLuminessence&r too. Two glowstone dust, a redstone and some gunpowder make two."
	]
	quest.2038E7A17CB7EF02.title: "Black Iron"
	quest.2042C3929B79A339.quest_desc: ["Built around a golden furnace. From here it branches: emerald or crystal, then obsidian."]
	quest.2042C3929B79A339.title: "Diamond Furnace"
	quest.208D08A82F8BC343.quest_desc: [
		"One of every singularity, on the Ultimate Crafting Table, makes the &eUltimate Singularity&r."
		""
		"Press &eR&r on it to see the full set."
	]
	quest.208D08A82F8BC343.title: "A Little of Everything"
	quest.20E5ED1F094AAD43.quest_desc: [
		"Grows &eLead Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Lead Ingots and four Tertium Essence on the pedestals."
	]
	quest.20E5ED1F094AAD43.title: "Lead Seeds"
	quest.211F6174C46C7752.quest_desc: ["Four Ultimate Energy Cubes and four Ultimate Induction Cells around the Spark make a Creative Energy Cube, full and bottomless."]
	quest.211F6174C46C7752.title: "Endless Power"
	quest.2137A757227177C3.quest_desc: [
		"A front door says a lot about a house. Macaw's Doors has barn doors, stable doors, glass doors, paper doors, western doors and plenty more."
		""
		"Metal doors need redstone power to open, like vanilla iron ones. A &eGarage Door&r goes on the ceiling and rolls down when opened."
	]
	quest.2137A757227177C3.title: "Come On In"
	quest.2160790A754ADE19.quest_desc: ["Winter's coming somewhere. Any logs will do."]
	quest.2160790A754ADE19.quest_subtitle: "Odd Job"
	quest.2160790A754ADE19.title: "Firewood"
	quest.219585BA15DC8A88.quest_desc: [
		"Grows &eFish Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of fish souls and four Prudentium Essence on the pedestals."
	]
	quest.219585BA15DC8A88.title: "Fish Seeds"
	quest.21E7128ADDBE1FDA.quest_desc: [
		"An &eIndustrial Turbine&r turns steam into a great deal of power. It's a tall box of &eTurbine Casing&r, with &eTurbine Valves&r for steam in and power out, and &eTurbine Vents&r to let the steam go."
		""
		"Look it up in JEI: the size of the box sets how much it can do."
	]
	quest.21E7128ADDBE1FDA.title: "The Industrial Turbine"
	quest.21F8534B4C04B2EF.quest_desc: ["&eMega&r is the top: four Ultra devices, netherite blocks and a &edragon head&r. The heads hang on the prows of End ships."]
	quest.21F8534B4C04B2EF.title: "Mega Grade"
	quest.225AFB5E04304672.quest_desc: ["An axe that never breaks, and a sword in a pinch. Like the drill, it runs on power."]
	quest.225AFB5E04304672.title: "Chainsaw"
	quest.2279FC04A2534288.quest_desc: [
		"The &eWireless Universal Grid&r rolls a Wireless Grid, a Wireless Crafting Grid and a Wireless Autocrafting Monitor into one, with a button to switch between them."
		""
		"Press &eShift+E&r to open it straight from your inventory."
		""
		"Your Curios (&eShift+G&r) have a Refined Storage slot for wireless grids, so it doesn't have to take up a pocket."
	]
	quest.2279FC04A2534288.title: "The Universal Grid"
	quest.22AAF987309806CA.quest_desc: [
		"The world underground has biomes of its own. Each of these is a whole cave system, not just a room."
		""
		"Stand anywhere inside one and it counts. Mantle and thermal caves sit deep; bring fire resistance."
	]
	quest.22AAF987309806CA.title: "Under the Hills"
	quest.22AB6B800BDAE25C.quest_desc: [
		"Last on the wall: the &eEnder Dragon&r."
		""
		"Already beaten it once? Respawn it with four End Crystals on the exit portal. It's a good afternoon out with friends."
		""
		"Here's its trophy, and a dragon's head to hang beside it."
	]
	quest.22AB6B800BDAE25C.title: "The Trophy Wall"
	quest.22B1CB8EBCA26B82.quest_desc: [
		"Grows &eOsmium Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Osmium Ingots and four Imperium Essence on the pedestals."
	]
	quest.22B1CB8EBCA26B82.title: "Osmium Seeds"
	quest.22E6961F6AED4B34.quest_desc: ["A &eBreaker Module&r breaks the block in front of the router and keeps it. Pair it with a sender for a tiny automatic quarry face."]
	quest.22E6961F6AED4B34.title: "Breaker Module"
	quest.22F762C7AAAE7901.quest_desc: [
		"Fish and polar bear gall bladders."
		""
		"Right-click a Polar Bear with a &eModel Framework&r to attune one. Simulating it costs 64 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.22F762C7AAAE7901.title: "Polar Bear Model"
	quest.231364C97547CE46.quest_desc: ["Endermen won't teleport within 8 blocks of an &eEnder Inhibitor&r. Right-click it to switch it off and on."]
	quest.231364C97547CE46.title: "Ender Inhibitor"
	quest.2318106F8EB8AEAE.quest_desc: [
		"Ancient Cities hide &eSuspicious Clay&r. Brush it and you may find an &eAllthemodium Smithing Template&r."
		""
		"Seven netherite ingots and a deepslate block copy a template into two. That's pricey, so brush every bit of clay you see."
	]
	quest.2318106F8EB8AEAE.title: "Ancient Blueprints"
	quest.2321C7120A96F0DF.quest_desc: [
		"Grows &eArmadillo Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of armadillo souls and four Prudentium Essence on the pedestals."
	]
	quest.2321C7120A96F0DF.title: "Armadillo Seeds"
	quest.235016AF92062BCA.quest_desc: ["Three ghasts. Mind the fireballs."]
	quest.235016AF92062BCA.quest_subtitle: "Commission"
	quest.235016AF92062BCA.title: "Quiet the Wailing"
	quest.23774F00D815BAD7.quest_desc: [
		"5,000 Diamond in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.23774F00D815BAD7.title: "Diamond Singularity"
	quest.23A286CC00383011.quest_desc: [
		"Tier five starts by dissolving ore in &esulfuric acid&r. The &eChemical Dissolution Chamber&r turns each ore into a big helping of &eDirty Slurry&r."
		""
		"Slurry is a chemical, not an item, so it travels through Pressurized Tubes like the gases do."
	]
	quest.23A286CC00383011.title: "Dissolving Ore"
	quest.23BEEC700CF05695.quest_desc: ["A mooshroom, perhaps. Its color might not survive the trip."]
	quest.23BEEC700CF05695.title: "A Different Shade"
	quest.23C1DD9684D170D9.quest_desc: [
		"A &ediamond pickaxe&r mines obsidian and ancient debris, and it'll outlast a stack of iron ones."
		""
		"Diamonds sit deep, well below sea level. Bring torches, food and a way home."
		""
		"Here's an anvil to look after your new tools."
	]
	quest.23C1DD9684D170D9.title: "Diamonds!"
	quest.23CC42770E083544.quest_desc: [
		"Grows &eNitro Crystal Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Nitro Crystals and four Insanium Essence on the pedestals."
		""
		"It only grows with a &eNitro Crystal Crux&r under its farmland."
	]
	quest.23CC42770E083544.title: "Nitro Crystal Seeds"
	quest.23CD78F40C58C6F8.quest_desc: [
		"The &eThermal Evaporation Plant&r is a tall tower of Thermal Evaporation Blocks with a controller and a valve. Pour water in and brine comes out, faster the hotter it runs."
		""
		"Just Enough Mekanism Multiblocks shows the shape in JEI. Look up the controller."
	]
	quest.23CD78F40C58C6F8.title: "Brine From Seawater"
	quest.2403B95718ECAD36.quest_desc: [
		"A diamond and a nickel ingot in the Foundry make &eAdamant&r. The Assembler, the hand drill and the better machine cores all ask for it."
		""
		"The Foundry's other alloys are worth knowing: iron and coal dust for steel, gold and redstone for electrum, nickel and fluxite for energite."
	]
	quest.2403B95718ECAD36.title: "Adamant"
	quest.244E40D9F2FF2A0E.quest_desc: [
		"Raw chicken and feathers."
		""
		"Right-click a Chicken with a &eModel Framework&r to attune one. Simulating it costs 64 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.244E40D9F2FF2A0E.title: "Chicken Model"
	quest.246332DA8CEFA248.quest_desc: [
		"A &eRed Health Patch&r is wool, string and a red heart. Use it to heal a heart on the spot."
		""
		"It has a short cooldown and a few uses before it wears out. Handy in a pinch, but the canisters are the real prize."
	]
	quest.246332DA8CEFA248.title: "Patch Yourself Up"
	quest.246B52C8CBC86FB5.quest_desc: [
		"The &eFragment Forge&r is the big step up for ore. Ore blocks become raw ore, and raw ore becomes a clump and some small clumps, plus small clumps of a second metal as a bonus."
		""
		"Nine small clumps make a clump, and the Centrifuge spins clumps into dust."
		""
		"It needs seven machine cores. Feed it ore blocks mined with Silk Touch for the best return."
	]
	quest.246B52C8CBC86FB5.title: "Fragment Forge"
	quest.248E8BBF58BC0886.quest_desc: [
		"Deep in forests, jungles and taiga stands a lonely tower. Somebody lived here, and they didn't like visitors."
		""
		"Watch for traps and the monster spawner inside. There's a brewing stand, chests worth opening, and a bed. Spend the night in it, if you dare."
		""
		"It's rare. The Explorer's Compass knows it as the Witch Tower."
	]
	quest.248E8BBF58BC0886.title: "The Witch's Tower"
	quest.24AB8DB57F1DEB70.quest_desc: [
		"The &eUniversal Pipe&r carries items, fluids and energy in one line, which keeps a busy wall tidy."
		""
		"Two each of the item, energy and fluid pipes, with iron and a block of redstone, make six."
	]
	quest.24AB8DB57F1DEB70.title: "One Pipe for Everything"
	quest.24B4A3B6B4EC054F.quest_desc: [
		"Piglich Hearts, four at a time, for the Allthemodium alloys."
		""
		"Right-click a Piglich with a &eModel Framework&r to attune one. Simulating it costs 16,384 FE a tick, and every run makes a &eGeneralized Ender Prediction&r as well."
	]
	quest.24B4A3B6B4EC054F.title: "Piglich Model"
	quest.25252A32CFAE3243.quest_desc: [
		"Wireless grids have four upgrade slots."
		""
		"&eMagnet&r picks up items within 6 blocks, into your inventory or the network. &eInsert&r sends chosen inventory slots into the network. &eExport&r pulls chosen items out to you. &eBlock Picker&r makes Pick Block fetch from storage. &eEnergy Capacity&r adds to the battery."
	]
	quest.25252A32CFAE3243.title: "Upgrades in Your Pocket"
	quest.2557EF532F297862.quest_desc: [
		"The last tier is built with &eRefined Obsidian&r."
		""
		"Crush obsidian into dust, infuse the dust with diamond, then press the result into an ingot in an &eOsmium Compressor&r. The compressor burns osmium to do it."
	]
	quest.2557EF532F297862.title: "Refined Obsidian"
	quest.25846311B9058C19.quest_desc: ["Water goes into the addon and steam comes out of it, not the generator itself, so pipe to the addon."]
	quest.25846311B9058C19.title: "Steam Boiler Addon"
	quest.25B014576D57B5C6.quest_desc: [
		"Every page filled: the cookbook, the angler's log, the field notes and the trophy wall."
		""
		"There's nothing left to unlock. That was never really the point."
		""
		"Bring the four &6Almanac Pages&r together, and the whole server will hear about it."
	]
	quest.25B014576D57B5C6.title: "The Almanac, Complete"
	quest.25B4A69244502CF2.quest_desc: [
		"The &eController&r is the heart of the network. It takes power from any FE source and shares it with every device on the cables."
		""
		"No power, no network, so give it a steady supply before you build out. Every device draws a little, and a Disk Drive draws more for each disk in it."
		""
		"A big network that runs short can have more than one Controller."
	]
	quest.25B4A69244502CF2.title: "The Controller"
	quest.26152ABE0D45C272.quest_desc: [
		"Grows &eBrass Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Brass Ingots and four Tertium Essence on the pedestals."
	]
	quest.26152ABE0D45C272.title: "Brass Seeds"
	quest.2637571AD1864C37.quest_desc: [
		"Summon the &eWither&r somewhere you don't mind losing. It breaks almost everything."
		""
		"Its Nether Star bakes into a certain cake, if you're working on the cookbook."
	]
	quest.2637571AD1864C37.title: "Three Heads Are Worse Than One"
	quest.26AF74EA4C09B57C.quest_desc: [
		"Cut grass, wheat or rice with a knife and you'll collect &eStraw&r."
		""
		"Straw makes canvas, straw bales and rope, and it goes into organic compost."
		""
		"Knives are good for more than plants: a pig felled with one drops ham."
	]
	quest.26AF74EA4C09B57C.title: "Last Straw"
	quest.26BEA4913ED1B728.quest_desc: ["The hardest of the tier Gateways. Beat it and you've seen everything Apotheosis can throw at you, nearly."]
	quest.26BEA4913ED1B728.title: "The Apothic Pinnacle"
	quest.26D79DF0FCFBA2C5.quest_desc: [
		"The ground around a house matters as much as the house. Macaw's Paths and Pavings has flagstones, cobbled paths, running bond brick, basket weave and more, in most kinds of stone and wood."
		""
		"Some pavings change when you right-click them: a pickaxe engraves them and a shovel flattens them. The tooltip says which."
	]
	quest.26D79DF0FCFBA2C5.title: "The Garden Path"
	quest.26EBB0CE42133A10.quest_desc: [
		"Terralith's volcanoes rise out of the land like nothing else in the world."
		""
		"Find a Volcanic Peak or Crater, climb to the rim and look in. Then glide down the side."
	]
	quest.26EBB0CE42133A10.title: "Hot Ground"
	quest.26FDC378A6FB2CB1.quest_desc: ["Halves the cook time for every recipe, but burns fuel twice as fast."]
	quest.26FDC378A6FB2CB1.title: "Augment: Speed"
	quest.27154EAD7D43083A.quest_desc: [
		"The &eIndustrial Chiller&r turns water into ice, lava into obsidian and steam into snow. Reactors that cool with absorbers need its ice."
		""
		"It needs one machine core, and it works better somewhere cold."
	]
	quest.27154EAD7D43083A.title: "Industrial Chiller"
	quest.271A362A93370AA1.quest_desc: [
		"Four Prudentium make &eTertium Essence&r, tier three. Every tier opens up seeds for more valuable materials."
		""
		"A field of resource crops occasionally drops &eFertilized Essence&r, which works like bone meal on Mystical crops. Save it for the slow ones."
	]
	quest.271A362A93370AA1.title: "Tertium"
	quest.27347AB0CB8D902E.quest_desc: ["Gold generators make 32 FE/t, and burn their fuel a little slower than iron ones."]
	quest.27347AB0CB8D902E.title: "Gold Generator"
	quest.2735297BEC1A2E15.quest_desc: ["A hydrogen jetpack built into the MekaSuit chestplate."]
	quest.2735297BEC1A2E15.title: "Jetpack Unit"
	quest.27757E04058E0A74.quest_desc: [
		"Infuse an iron ingot with carbon for &eEnriched Iron&r, then infuse that with carbon again for Steel Dust. Smelt the dust and you have steel."
		""
		"Steel, glass and osmium make the &eSteel Casing&r at the heart of most Mekanism machines. Steel also goes into Universal Cables."
	]
	quest.27757E04058E0A74.title: "Steel, the Mekanism Way"
	quest.27D6C6A84097486E.quest_desc: [
		"A &eMega Torch&r stops hostile mobs from spawning naturally for 64 blocks in every direction. Put one in your base and the nights get a lot quieter."
		""
		"It works in caves too. Set one in the middle of a cave system and you can mine it out in peace."
		""
		"Spawners still work near it, so a mob farm will keep running."
	]
	quest.27D6C6A84097486E.title: "Light Up the Dark"
	quest.283B243E044874AC.quest_desc: ["Don't look them in the eye. Well, until you have to."]
	quest.283B243E044874AC.quest_subtitle: "Commission"
	quest.283B243E044874AC.title: "Ender Harvest"
	quest.28403086B7915729.quest_desc: [
		"Template, Allthemodium pickaxe, Vibranium Ingot."
		""
		"Unobtainium won't budge for anything less."
	]
	quest.28403086B7915729.title: "Vibranium Pickaxe"
	quest.28424C5E347C0B5B.quest_desc: [
		"Nearly. The &eEndless Gateway of Apothic Invaders&r never stops sending waves."
		""
		"Hold out to wave 100 and it gives up a &eSigil of Supremacy&r. Bragging rights don't come bigger."
	]
	quest.28424C5E347C0B5B.title: "Supremacy"
	quest.28863DE855695491.quest_desc: [
		"Every transmitter comes in four tiers. Each one is eight of the tier below around an alloy: infused for advanced, reinforced for elite and atomic for ultimate."
		""
		"Each tier moves more items, and faster, so it pays to upgrade the busiest lines first."
	]
	quest.28863DE855695491.title: "Ultimate Logistical Transporter"
	quest.288EFC60FD3F5496.quest_desc: ["On a server, the &eExpulsion Pylon&r keeps other players out of your chunks, from one chunk up to 5x5. Let friends in with a &ePlayer Filter&r."]
	quest.288EFC60FD3F5496.title: "Expulsion Pylon"
	quest.28AD440D776D7835.quest_desc: ["Faster again."]
	quest.28AD440D776D7835.title: "Vibranium Furnace"
	quest.28B1507A648721C2.quest_desc: [
		"Place a Teleport Pad in the Nether and it leads to &eThe Other&r: an older, hotter Nether under a sky where it's always night."
		""
		"Water boils away here, just like in the Nether. Wither skeletons, blazes and ghasts keep you company."
		""
		"The ground is &eAncient Stone&r, and the strange trees are worth a few logs for the build pile. Look up in the caves: the ceilings are where the Vibranium is."
	]
	quest.28B1507A648721C2.title: "The Other"
	quest.28E244F9001C6825.quest_desc: ["Glass and an eye of ender around a diamond furnace. Emerald and crystal both lead on to obsidian."]
	quest.28E244F9001C6825.title: "Crystal Furnace"
	quest.28F8799E07EFCE2A.quest_desc: ["Lets you feed power into the addon instead of the machine, which helps when the machine's own sides are crowded."]
	quest.28F8799E07EFCE2A.title: "Acceptor Addon"
	quest.291EC6C55C2C258F.quest_desc: ["The Summit's challenge Gateway, another step up from the Ascent's. JEI has the pearl's recipe."]
	quest.291EC6C55C2C258F.title: "The Thundering Summit"
	quest.2929FC1A5CE99D97.quest_desc: [
		"A backpack you can wear, place like a chest, or carry in your hand."
		""
		"Upgrades turn it into a magnet, a compactor, a lunchbox and more. &ePacking It In&r covers those, and bigger packs."
	]
	quest.2929FC1A5CE99D97.title: "Room for More"
	quest.293829C786BBFABB.quest_desc: ["The &eInception Upgrade&r lets you put backpacks inside your backpack, and their upgrades keep working."]
	quest.293829C786BBFABB.title: "Backpacks in Backpacks"
	quest.294CFFE1B731A60A.quest_desc: [
		"Many of Oritech's stronger machines need &eFluxite&r. Point a laser at amethyst clusters and they come off as fluxite instead."
		""
		"Aim one at a &eBudding Amethyst&r and it speeds up the growth without breaking the block, so one geode can keep you supplied."
	]
	quest.294CFFE1B731A60A.title: "Fluxite"
	quest.294DF3EAAE3D8293.quest_desc: [
		"Grows &eAmethyst Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Amethyst Shards and four Prudentium Essence on the pedestals."
	]
	quest.294DF3EAAE3D8293.title: "Amethyst Seeds"
	quest.2953D46CB7F13B9C.quest_desc: [
		"A few ores give something other than metal: &eFluorite&r, &eSulfur&r and &eSalt&r."
		""
		"Fluorite and salt run from deep down up into the hills. Sulfur keeps low, mostly down in the deepslate. Machines later on will be glad of all three."
	]
	quest.2953D46CB7F13B9C.title: "Not Just Metal"
	quest.2956723CE089344D.quest_desc: [
		"Grows &eZombie Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of zombie souls and four Tertium Essence on the pedestals."
	]
	quest.2956723CE089344D.title: "Zombie Seeds"
	quest.297CFF2AA839CF49.quest_desc: [
		"Look up. Moog's Soaring Structures floats islands high over the land: castle ruins, little houses, ponds, groves of trees, even a volcano."
		""
		"This quest wants the &eCalcite House&r. Search for it in your Explorer's Compass, then build your way up and step onto it. Your paraglider is the easy way down."
	]
	quest.297CFF2AA839CF49.title: "Land on a Sky Island"
	quest.29A7793116934600.quest_desc: ["Summon it, beat it, keep the star."]
	quest.29A7793116934600.quest_subtitle: "Grand Bounty"
	quest.29A7793116934600.title: "The Wither"
	quest.29E58A46426E1598.quest_desc: [
		"Each rod tier passes power to the orb faster, so a few good rods beat a ring of starter ones."
		""
		"Craft a &eBasic Energizing Rod&r from a starter rod, then keep climbing as you make better crystals."
	]
	quest.29E58A46426E1598.title: "Better Rods"
	quest.29F6424BECE6700C.quest_desc: [
		"&eMimi-Dust&r turns an ordinary chest into a Mimic."
		""
		"Here's the trick: the Mimic drops as many random relics as the chest held items before you dusted it. Fill a chest with junk, wake it up, and win it back as treasure."
		""
		"It takes an Echo Shard, so you'll need a trip to an ancient city first."
	]
	quest.29F6424BECE6700C.title: "Make Your Own Mimic"
	quest.2A3151FDFB9A441B.quest_desc: [
		"Out on the plains and in the forests, Explorify scatters small places to stop: taverns, farmsteads, campsites, watchtowers and supply caches."
		""
		"Find a tavern. A warm room on a long road is worth something."
	]
	quest.2A3151FDFB9A441B.title: "A Roadside Tavern"
	quest.2AA2D6536DD79316.quest_desc: [
		"The &eHeart Amulet&r is glass, string and a heart. It sits in its own Curios slot."
		""
		"Right-click it to open it. Every heart canister you put inside adds a heart to your health bar, and each kind of canister stacks to ten."
		""
		"Your first canister is next. It needs a few ingredients from around the world."
	]
	quest.2AA2D6536DD79316.title: "Heart Amulet"
	quest.2AC05EC2962F2631.quest_desc: ["An &eEnergy Hopper&r charges the items inside the chest or other inventory it touches. Drop your tools in overnight."]
	quest.2AC05EC2962F2631.title: "Energy Hopper"
	quest.2AC54E2E6A1616F5.quest_desc: [
		"The &eUltimate Crafting Table&r is 9x9: two Elite tables, a block of emerald and Ultimate Components."
		""
		"Everything in this chapter is made on one. The tables before it are in &eAllthemodium Ascent&r."
	]
	quest.2AC54E2E6A1616F5.title: "The Biggest Table"
	quest.2AD377E7C7CA95A3.quest_desc: [
		"Grows &eSpider Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of spider souls and four Tertium Essence on the pedestals."
	]
	quest.2AD377E7C7CA95A3.title: "Spider Seeds"
	quest.2B38FF8D9BE99D3F.quest_desc: [
		"Recipes that call for a water or lava bucket normally need a real filled bucket in storage."
		""
		"A &eFluid Substitution Pattern&r, a Pattern between two buckets, lets autocrafting use the stored fluid instead."
	]
	quest.2B38FF8D9BE99D3F.title: "Buckets Not Included"
	quest.2B6075E871446F47.quest_desc: ["Turns the furnace into a factory that runs on power instead of fuel."]
	quest.2B6075E871446F47.title: "Augment: Factory"
	quest.2B830E5582EA61E4.quest_desc: [
		"A &eHopper Botany Pot&r harvests its own crop and passes it down into a chest or hopper underneath."
		""
		"Line a few up over a row of hoppers feeding one chest, and your essence piles up while you're off doing something else."
		""
		"Saplings grow in pots too. An oak sapling in a pot of dirt gives logs, leaves, apples and the odd sapling, so a Hopper Botany Pot makes a wood supply the size of a block."
	]
	quest.2B830E5582EA61E4.title: "A Row of Pots"
	quest.2BD36B823FA2B9C1.quest_desc: ["The &eRefill Upgrade&r keeps a stack of what you choose topped up in your inventory, from the backpack. Torches, food, building blocks."]
	quest.2BD36B823FA2B9C1.title: "Never Run Out"
	quest.2BDE3E3F5D253C01.quest_desc: ["With &eEnergy Upgrades&r a router holds FE. An &eEnergy Output Module&r passes it to the block in front, and an &eEnergy Distributor Module&r shares it out to several."]
	quest.2BDE3E3F5D253C01.title: "Routers Carry Power Too"
	quest.2BE03CBB14E8327A.quest_desc: [
		"The Skylands come in four seasons. Find all of them."
		""
		"A paraglider and a good updraft will get you between islands. Falling will get you down."
	]
	quest.2BE03CBB14E8327A.title: "Four Seasons in the Sky"
	quest.2BE29382279AE83C.quest_desc: [
		"5,000 Redstone in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.2BE29382279AE83C.title: "Redstone Singularity"
	quest.2BE46948DBA4CCF5.quest_desc: ["Carbon Fibre Strands around redstone. Spin coal dust in the Centrifuge for the strands."]
	quest.2BE46948DBA4CCF5.title: "Improved Machine Core"
	quest.2BE5EA215EFEA58E.quest_desc: [
		"Most villages have a waystone near the middle. Right-click one to remember it."
		""
		"From any waystone you can travel to any other one you've found, and it costs nothing. Wander as far as you like and come home in a heartbeat."
		""
		"A Return Scroll takes you back to the last waystone you used."
		""
		"The minimap in the corner is JourneyMap. Press &eShift+B&r to drop a waypoint where you stand, and &eJ&r for the full map."
	]
	quest.2BE5EA215EFEA58E.title: "Find a Waystone"
	quest.2C21ED508BC849C4.quest_desc: [
		"A 5x5 grid. The Allthemodium alloy tools are made on one of these, so it's worth building now."
		""
		"Every size also comes as an &eAuto Crafting Table&r, for a recipe you want made over and over."
	]
	quest.2C21ED508BC849C4.title: "Advanced Crafting Table"
	quest.2C29E762E374F520.quest_desc: ["A &eDistributor Module&r spreads items across several inventories: round robin, random, nearest first or furthest first."]
	quest.2C29E762E374F520.title: "Share It Out"
	quest.2C33150B111197D6.quest_desc: ["A full &eHazmat Suit&r keeps radiation off you. A &eGeiger Counter&r tells you how much is around, and a &eDosimeter&r how much you've taken."]
	quest.2C33150B111197D6.title: "Dress for It"
	quest.2C3777741D8F6C26.quest_desc: [
		"&eCable&r links devices to each other. Six &eQuartz Enriched Copper&r, two glass and a redstone make twelve. The copper works like the iron: three ingots and a quartz."
		""
		"Dyed cable only joins cable of the same color or plain gray, so two networks can run side by side without merging."
	]
	quest.2C3777741D8F6C26.title: "Run the Cables"
	quest.2C571764D7F82FF1.quest_desc: [
		"Grows &eSculk Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Sculk and four Tertium Essence on the pedestals."
	]
	quest.2C571764D7F82FF1.title: "Sculk Seeds"
	quest.2C5F50D00CD3E5C1.quest_desc: ["&eMechanical Pipes&r carry fluids: water to the washer, lava to the Heat Generator."]
	quest.2C5F50D00CD3E5C1.title: "Moving Fluids"
	quest.2C6FBC60B724FF19.quest_desc: [
		"Every chapter is open from the start, so read ahead, skip around, and come back whenever you like."
		""
		"You can finish a quest's tasks at any time, in any order. Its rewards wait until the quests before it are done, so a line between two quests means the second one pays out after the first. Most quests have nothing before them at all."
		""
		"Most quests finish on their own once you have the item. A few explainers like this one have a checkmark to click after you've read them."
		""
		"Rewards suit the chapter they're in: Mekanism quests pay out in Mekanism parts, farming quests in seeds and essence. Hover over a reward to see everything it can give, and the odds."
		""
		"Milestones add a roll on the &dLantern&r table. A chapter's finale lets you &epick&r the item you want, with a roll on the &6Ember&r table on top."
		""
		"Crates are the other source. Now and then a monster you defeat drops a &7Kindling&r crate, bosses always leave a better one, and the Bounty Board pays in crates. Right-click one to open it."
	]
	quest.2C6FBC60B724FF19.title: "How This Book Works"
	quest.2CB81A0420A66226.quest_desc: ["A &eFilter Upgrade&r sets what pipes and hoppers may put into the chest, or take out of it. Keep the ore chest for ore."]
	quest.2CB81A0420A66226.title: "Only What Belongs"
	quest.2CE9E90ADDC9A07E.quest_desc: ["The mod's own &eFurnace&r is two furnaces, iron and Prosperity Ingots around a Machine Frame. It cooks like a furnace, and upgrades make it faster."]
	quest.2CE9E90ADDC9A07E.title: "An Essence Furnace"
	quest.2D15C773B7089981.quest_desc: [
		"A &eWireless Player Charger&r tops up the powered gear of anyone standing near it: tools, armor, jetpacks, anything that holds FE."
		""
		"Put one by your front door, feed it power, and never think about batteries again."
	]
	quest.2D15C773B7089981.title: "Charge on the Go"
	quest.2D2D993BE4529113.quest_desc: [
		"Grows &eChicken Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of chicken souls and four Prudentium Essence on the pedestals."
	]
	quest.2D2D993BE4529113.title: "Chicken Seeds"
	quest.2D30013B5CBBD153.quest_desc: [
		"Redstone, glowstone, sugar, spider eyes and bottles: a brewer's shopping list."
		""
		"Right-click a Witch with a &eModel Framework&r to attune one. Simulating it costs 256 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.2D30013B5CBBD153.title: "Witch Model"
	quest.2D4F71A8058260DE.quest_desc: [
		"The &eCooking Table&r is the center of a kitchen. Right-click it to see every food you can make from the ingredients in the kitchen around it, and craft any of them with a click or two."
		""
		"Counters, fridges, sinks, ovens and the rest share their contents with it when they touch it or each other. Kitchen Floor connects them across a room."
		""
		"Looking for something you haven't eaten yet? Sort the Cooking Table's list by &eEaten&r."
		""
		"Here's a toaster to get you started."
	]
	quest.2D4F71A8058260DE.title: "The Heart of the Kitchen"
	quest.2D787F0F99F15AE0.quest_desc: [
		"The first mob to walk over a &eSpawner Controller&r decides what it spawns. Build &eSpawner Cages&r beneath it to the size it shows, and feed it souls."
		""
		"Choose that first mob with care: changing it means breaking the controller."
	]
	quest.2D787F0F99F15AE0.title: "Make Your Own Spawner"
	quest.2D87FC29B228BF14.quest_desc: [
		"The &eEnderic Laser&r fires a beam up to 128 blocks. Aim it with a &eTarget Designator&r and it mines everything in that line, passing through glass, until something stops it."
		""
		"Mined drops go into the laser's own inventory, and anything that doesn't fit is destroyed, so pipe them out."
		""
		"Aim it at a machine instead and it charges the machine, ignoring the usual input limit. Your biggest machines need power this way."
	]
	quest.2D87FC29B228BF14.title: "Enderic Laser"
	quest.2D9514A153596A71.quest_desc: [
		"Grows &eCoral Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Coral Agglomeratio and four Prudentium Essence on the pedestals."
	]
	quest.2D9514A153596A71.title: "Coral Seeds"
	quest.2DA83054B4065A27.quest_desc: [
		"Underground, in the Nether and in some villages, you may find a darker statue with horns. It's the goddess's opposite, and it deals in the same goods."
		""
		"Give it a Heart Container or Stamina Vessel and it pays you in emeralds and an &eEssence&r. Bring it an Essence and some emeralds, and it gives one back."
		""
		"Wish you'd picked stamina over hearts? This is how you change your mind. This quest wants one of the underground statues."
	]
	quest.2DA83054B4065A27.title: "The Horned Statue"
	quest.2DA8665EB9369B73.quest_desc: [
		"Spruce on cold mountain slopes. Bring a paraglider for the way down."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.2DA8665EB9369B73.title: "Alpine Grove"
	quest.2DCE38A00D7D946D.quest_desc: [
		"Grows &eFire Essence&r, one of the four elemental essences the Awakening Altar needs."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Fire Agglomeratio and four Inferium Essence on the pedestals."
	]
	quest.2DCE38A00D7D946D.title: "Fire Seeds"
	quest.2DD4410F94CA3749.quest_desc: [
		"An &eAutocrafting Upgrade&r in an Exporter starts a craft whenever something it should export is missing."
		""
		"Pair it with a Regulator Upgrade and a chest of torches, or a machine's input, stays topped up forever."
	]
	quest.2DD4410F94CA3749.title: "Never Run Out"
	quest.2E0EE5F1079BE906.quest_desc: [
		"A &eFancy Bed&r has a proper wooden frame and works just like any other bed."
		""
		"Right-click it with a &eSheet&r to change the bedding, or with a &eCushion&r to change the pillow. Put a nightstand next to it and a lamp on top, and you've got a bedroom."
	]
	quest.2E0EE5F1079BE906.title: "Sweet Dreams"
	quest.2E175A47DAF209EC.quest_desc: [
		"A &eFlux Controller&r turns on wireless charging for its network: the powered gear of the players on that network gets topped up from it."
		""
		"Pair it with a big flux storage and your jetpack never runs dry."
	]
	quest.2E175A47DAF209EC.title: "Charge from Anywhere"
	quest.2E3243F65F1D8531.quest_desc: [
		"Grows &eHoney Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Honey Agglomeratio and four Prudentium Essence on the pedestals."
	]
	quest.2E3243F65F1D8531.title: "Honey Seeds"
	quest.2E6009811F8E12CE.quest_desc: [
		"Generators make power whether or not you're using it. An &eEnergy Cell&r saves the extra for later."
		""
		"Put one between your generators and machines. It fills up overnight and covers the busy moments when everything runs at once."
		""
		"Higher tiers hold more, and you can build each tier out of cells from the one before."
		""
		"Shift-click a cell into an &eEnder Cell&r's screen and it adds its capacity to that Ender Network channel."
	]
	quest.2E6009811F8E12CE.title: "Store It Up"
	quest.2E770C9E4123A15C.quest_desc: [
		"Grows &eCoal Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Coal and four Prudentium Essence on the pedestals."
	]
	quest.2E770C9E4123A15C.title: "Coal Seeds"
	quest.2EBE61653DCCEFCD.quest_desc: [
		"Swap the iron for a gold ingot and you get an &eImproved Processor&r."
		""
		"They go into upgrades, constructors and destructors, and the 16k storage part."
	]
	quest.2EBE61653DCCEFCD.title: "Improved Processor"
	quest.2ECB18270BE008E3.quest_desc: [
		"Look down as you walk. &eTwigs&r lie about in forests and taiga, and &ePebbles&r on plains, beaches and riverbanks. Pick them up."
		""
		"A twig crafts into two sticks, and four pebbles make a cobblestone, so they're handy on your first day. Pebbles can be thrown, too."
		""
		"Twigs also adds small tables made from a fence and a slab, paper lanterns, seashells on the beach, and a few new kinds of stone underground."
	]
	quest.2ECB18270BE008E3.title: "Bits on the Ground"
	quest.2F19DB0B9FB90C94.quest_desc: ["Fuel heats the furnace twice as much, but cooking is a quarter slower."]
	quest.2F19DB0B9FB90C94.title: "Augment: Fuel Efficiency"
	quest.2F19F4D8EA914D9E.quest_desc: ["Drinks honey and makes 64 FE/t. A beehive full of bees is a power station."]
	quest.2F19F4D8EA914D9E.title: "Honey Generator"
	quest.2F2DA16F3553EA88.quest_desc: [
		"Fill out the kitchen. A &eFridge&r and &eKitchen Counters&r store ingredients the Cooking Table can reach. A &eSink&r supplies water to recipes, as much as you need."
		""
		"An &eOven&r and a &eTool Rack&r for your knives and pans round it out. Hang cabinets on the wall for even more space."
	]
	quest.2F2DA16F3553EA88.title: "Stock the Pantry"
	quest.2F3D677D3C2F09B8.quest_desc: [
		"A &eDetector&r gives a redstone signal when the network holds more, less or exactly as much of something as you set."
		""
		"Switch a farm off when the stock is full, or a light on when the coal runs low."
	]
	quest.2F3D677D3C2F09B8.title: "Ring a Bell"
	quest.2F7240862881C340.quest_desc: [
		"Every part of the Mining Gadget starts from a &eBlank Upgrade Module&r: redstone, lapis, diamonds and a glass pane."
		""
		"Make a few. The gadget takes one, its workbench takes another, and most upgrades need one more."
	]
	quest.2F7240862881C340.title: "A Blank Slate"
	quest.2F8C6FD9A76B3A2E.quest_desc: [
		"A 7x7 grid, and the table the &eAllthemodium Alloy Paxel&r itself is made on."
		""
		"Two Advanced tables, a block of diamond and Elite components."
	]
	quest.2F8C6FD9A76B3A2E.title: "Elite Crafting Table"
	quest.2FCFB1D6520340E7.quest_desc: [
		"Grows &eTurtle Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of turtle souls and four Prudentium Essence on the pedestals."
	]
	quest.2FCFB1D6520340E7.title: "Turtle Seeds"
	quest.2FEBF68152976A36.quest_desc: [
		"Fusion burns &edeuterium&r and &etritium&r. Deuterium comes from heavy water in an Electrolytic Separator. Tritium comes from lithium in the Solar Neutron Activator."
		""
		"A &eHohlraum&r filled with mixed D-T fuel goes into the reactor controller for ignition."
	]
	quest.2FEBF68152976A36.title: "Fusion Fuel"
	quest.2FF8E0187B8C4C21.quest_desc: ["Twenty million RF, with room for addons to make it bigger. It needs three machine cores and only sends power out of its red marker."]
	quest.2FF8E0187B8C4C21.title: "Large Energy Storage"
	quest.3025117458AC624B.quest_desc: ["Adds a level of &eBeheading&r to the Mob Masher. Stack a few for more. Beheading means heads."]
	quest.3025117458AC624B.title: "Masher: Beheading"
	quest.302537769E5066AA.quest_desc: [
		"An &eenchanting table&r puts your experience to work on tools and armor."
		""
		"Bookshelves around it unlock stronger enchantments, so build a little library around it."
		""
		"Enchanted books can go on an anvil with a tool to add that enchantment, or with each other to make a stronger book."
	]
	quest.302537769E5066AA.title: "A Touch of Shine"
	quest.30470F3BA87F18FF.quest_desc: [
		"Mineshafts here match the land above them, with desert, icy, jungle, lush, badlands and mushroom versions and more."
		""
		"They're a fast way to find ore, and the minecart chests are Loot Chests too."
	]
	quest.30470F3BA87F18FF.title: "Rails Under the Hills"
	quest.3067FF6459FB1045.quest_desc: [
		"Glowstone dust pressed in the &eOsmium Compressor&r becomes &eRefined Glowstone&r."
		""
		"It glows, and it goes into Teleporter Frames and a few of the fancier machines."
	]
	quest.3067FF6459FB1045.title: "Refined Glowstone"
	quest.3098E0D69C4C6064.quest_desc: [
		"A &eWind Generator&r needs no fuel at all. It makes more power the higher up it stands, so hilltops and tall towers are worth the climb."
		""
		"A row of them along a ridge makes a fine little wind farm."
	]
	quest.3098E0D69C4C6064.title: "Catch the Wind"
	quest.30B8CC0C1ABCCA7E.quest_desc: [
		"Bring it all to an &eElite Crafting Table&r: the four alloy tools, a ring of alloy ingots, four Supremium Essence and the five tech pieces."
		""
		"One tool for every block, made from everything you've built along the way. Well done."
		""
		"The tech pieces come back to you as rewards, so your bases don't go short."
	]
	quest.30B8CC0C1ABCCA7E.title: "The Allthemodium Alloy Paxel"
	quest.30CFC7D8ACD88949.quest_desc: [
		"Cod, roe and bone meal."
		""
		"Right-click a Cod with a &eModel Framework&r to attune one. Simulating it costs 32 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.30CFC7D8ACD88949.title: "Cod Model"
	quest.30F44DDF921B6A0F.quest_desc: [
		"Glow ink sacs and glowing calamari."
		""
		"Right-click a Glow Squid with a &eModel Framework&r to attune one. Simulating it costs 32 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.30F44DDF921B6A0F.title: "Glow Squid Model"
	quest.311E4E25B1251EAB.quest_desc: [
		"Cave spiders are small enough to slip through a one-block gap, and their bite is poisonous."
		""
		"Thin them out. Break their spawners too, if you find any: it's quieter that way."
	]
	quest.311E4E25B1251EAB.title: "Pest Control"
	quest.313079ED5926FF5B.quest_desc: [
		"Grows &eGold Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Gold Ingots and four Imperium Essence on the pedestals."
	]
	quest.313079ED5926FF5B.title: "Gold Seeds"
	quest.314590FC5CC27466.quest_desc: [
		"5,000 Emerald in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.314590FC5CC27466.title: "Emerald Singularity"
	quest.314A53DD91312149.quest_desc: [
		"Moss, spikes, mud, mushrooms, hot springs, blue ice, cobwebs, tuff, magma and the great dark caverns. You've seen the whole underground."
		""
		"Visit every cave in the rows below and this one completes too."
	]
	quest.314A53DD91312149.title: "Spelunker"
	quest.317638A2227C9CED.quest_desc: [
		"Bone meal, Inferium Essence and a diamond make four &eMystical Fertilizer&r. It grows a crop or sapling fully in one go."
		""
		"Save it for the slow ones at the top of the ladder."
	]
	quest.317638A2227C9CED.title: "Mystical Fertilizer"
	quest.31B34B53A5D264FE.quest_desc: [
		"Grows &eRefined Obsidian Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Refined Obsidian Ingots and four Imperium Essence on the pedestals."
	]
	quest.31B34B53A5D264FE.title: "Refined Obsidian Seeds"
	quest.31C91E01FF122D39.quest_desc: [
		"Macaw's Trapdoors comes in the same styles as its doors: barn, ranch, barred, glass and more, in every wood."
		""
		"They make good shutters on a wall, cupboard doors on a shelf, or a cellar hatch in the floor."
	]
	quest.31C91E01FF122D39.title: "Hatches and Shutters"
	quest.31D0EC8B143255E7.quest_desc: [
		"A &eHeavy Core&r is the rarest thing in a Trial Chamber. Drink an Ominous Bottle, beat the chamber's ominous waves for an &eOminous Trial Key&r, and open an &eOminous Vault&r. Now and then one gives a core."
		""
		"If luck won't oblige, Oritech can make one. Forge &eReinforced Deepslate&r in the Atomic Forge from deepslate and two duratium ingots, then collide it with &eDuratium Dust&r in the Particle Accelerator."
		""
		"Oritech's &eElectric Mace&r needs a core too."
	]
	quest.31D0EC8B143255E7.title: "Heavier Than It Looks"
	quest.31D3CC66FAA927AB.quest_desc: [
		"The witch who lives in the swamp has had a renovation. YUNG's Better Witch Huts are bigger and stranger than the old shack on stilts."
		""
		"There's usually a witch at home, and a cat."
	]
	quest.31D3CC66FAA927AB.title: "Swamp Cottage"
	quest.31F5A358CE8F8C15.quest_desc: [
		"Each tier is built on the one below: an Inferium piece between two &ePrudentium Ingots&r and two &ePrudentium Gemstones&r."
		""
		"Damage and enchantments carry over, so nothing you put into the old piece is lost."
	]
	quest.31F5A358CE8F8C15.title: "Prudentium Gear"
	quest.321C61DFB43B9E96.quest_desc: [
		"The &eWireless Autocrafting Monitor&r shows your running crafts from anywhere in range: an Autocrafting Monitor with ender pearls and an Advanced Processor."
		""
		"With this and the two wireless grids, you have everything the next quest needs."
	]
	quest.321C61DFB43B9E96.title: "Keep an Eye on It"
	quest.3237FA76293F1DBA.quest_desc: [
		"The &eLoot Fabricator&r turns Predictions into the real thing. Pick which of the mob's drops you want on its screen."
		""
		"A &eFabrication Directive&r copies one fabricator's choices onto another."
	]
	quest.3237FA76293F1DBA.title: "Loot Fabricator"
	quest.323A91C2A6A33074.quest_desc: [
		"Grows &eBronze Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Bronze Ingots and four Tertium Essence on the pedestals."
	]
	quest.323A91C2A6A33074.title: "Bronze Seeds"
	quest.323E33539B5DC97B.quest_desc: [
		"Processors start as a &eProcessor Binding&r, made from string and a slime ball. Add silicon, redstone and an iron ingot for a raw processor, then smelt it into a &eBasic Processor&r."
		""
		"&eSilicon&r is just quartz, smelted. One binding recipe makes eight, so string is rarely the problem."
	]
	quest.323E33539B5DC97B.title: "Printed Circuits"
	quest.324ADC650C2BE914.quest_desc: [
		"Mystical Agriculture's machines are all built around a &eMachine Frame&r: iron, redstone and stone."
		""
		"Make a few. Every machine in this row takes one."
	]
	quest.324ADC650C2BE914.title: "Machine Frame"
	quest.3263425B58C953C4.quest_desc: [
		"The &eStabilized Enchanter&r lets you choose exactly which enchantment to apply. It runs on power and on souls from &eArcane Catalysts&r within 16 blocks."
		""
		"Catalysts collect souls from mobs that die nearby. A laser on a catalyst lets it hold far more of them."
	]
	quest.3263425B58C953C4.title: "Pick Your Enchantment"
	quest.32A0644E86AE7667.quest_desc: [
		"Stairs make a fine roof. Macaw's Roofs makes a better one: steep pitches, low pitches, attic pieces and top caps in wood, stone, brick, concrete, terracotta and thatch."
		""
		"Try a steep roof on a narrow cottage and a low one on a wide barn, and finish the peak with a top piece so it doesn't look chopped off."
	]
	quest.32A0644E86AE7667.title: "A Proper Roof"
	quest.32B2A911D2E1C217.quest_desc: [
		"A &eTier Installer&r turns a machine into a factory, or a factory into the next tier up, without picking it up."
		""
		"Right-click the machine with it. Basic, Advanced, Elite and Ultimate each add lanes."
	]
	quest.32B2A911D2E1C217.title: "Upgrade in Place"
	quest.32D28F186D19C096.quest_desc: [
		"Drift down gently instead of falling."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.32D28F186D19C096.title: "Slow Falling Augment"
	quest.32D7773AF7B6E7F3.quest_desc: [
		"The &eRefinery&r splits crude oil into &eheavy oil&r, &enaphtha&r and &esulfuric acid&r. It needs nine machine cores."
		""
		"Out of the box only the first output works. Stack &eRefinery Chamber Modules&r on top to open the other two."
		""
		"Heavy oil refines again into diesel. Refined fuels give a Fuel Generator much more power per bucket than crude."
	]
	quest.32D7773AF7B6E7F3.title: "The Refinery"
	quest.331970696BC30085.quest_desc: [
		"The &ePowered Furnace&r smelts twice as fast as a stone furnace and needs no fuel, only power."
		""
		"It needs one machine core beside it. Right-click the furnace and the spot lights up."
	]
	quest.331970696BC30085.title: "Powered Furnace"
	quest.337F4F7FB910171F.quest_desc: ["&eFree Runners&r stop fall damage and let you walk straight up single blocks. They run on power."]
	quest.337F4F7FB910171F.title: "Free Runners"
	quest.33976B383FA077EA.quest_desc: [
		"The hardest of the three: two &eUnobtainium Ingots&r, two &eVibranium Ingots&r and a Piglich Heart, for 10,000,000 FE."
		""
		"If your power grid has been coasting, this is where you'll find out."
	]
	quest.33976B383FA077EA.title: "Unobtainium Meets Vibranium"
	quest.33A0F81CF3956DAA.quest_desc: [
		"5,000 Tin in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.33A0F81CF3956DAA.title: "Tin Singularity"
	quest.33A50FC8109294C4.quest_desc: [
		"A &eMachine Upgrade&r goes into any of these machines. Each tier changes its speed, fuel use and fuel capacity, and on the Harvester its area. The tooltip shows by how much."
		""
		"Each starts as a Machine Upgrade Base, with essence and ingots of its tier around it."
	]
	quest.33A50FC8109294C4.title: "Machine Upgrades"
	quest.33A6439DC62A0A18.quest_desc: ["An &eUltimate Factory&r runs nine stacks side by side. Put one at each step of your ore line and nothing will keep up with you."]
	quest.33A6439DC62A0A18.title: "Nine Lanes"
	quest.33D72D8B71A125CE.quest_desc: ["The &eFlinger Module&r throws items, a long way if you like. Set the speed and angle in its menu, and aim for a hopper."]
	quest.33D72D8B71A125CE.title: "Flinger Module"
	quest.33EE0D360D0951A4.quest_desc: ["The furnace only does blasting recipes, like a blast furnace."]
	quest.33EE0D360D0951A4.title: "Augment: Blasting"
	quest.341647BEAEEC8554.quest_desc: ["A &eFluid Tank&r holds one fluid and keeps it when you pick the tank up. Stack them for more."]
	quest.341647BEAEEC8554.title: "Fluid Tanks"
	quest.344C668003CD0E71.quest_desc: ["For the refineries and reactors that drink fluid by the thousand buckets."]
	quest.344C668003CD0E71.title: "262kB Fluid Storage Disk"
	quest.345B0BA3BFE19CFA.quest_desc: [
		"The &eFormulaic Assemblicator&r crafts for you. Write a recipe onto a &eCrafting Formula&r, slot it in, and it crafts from its inventory on its own."
		""
		"It doubles as a crafting table that keeps its ingredients."
	]
	quest.345B0BA3BFE19CFA.title: "The Formulaic Assemblicator"
	quest.3471BBDEEE89C02F.quest_desc: [
		"5,000 Invar in the Quantum Compressor."
		""
		"Invar is an alloy. Press &eR&r on the ingot to see what makes it."
	]
	quest.3471BBDEEE89C02F.title: "Invar Singularity"
	quest.3479F21CA9A75252.quest_desc: ["Speed Upgrades and sugar make a &eStack Upgrade&r: the device handles far more per operation."]
	quest.3479F21CA9A75252.title: "Stack Upgrade"
	quest.347DB171ECD19E8C.quest_desc: [
		"&eGems&r turn up in chest loot and now and then from monsters. Bosses and Invaders drop them more often."
		""
		"Each gem has a &ePurity&r, from Cracked up to Perfect, and purity is all that sets its strength. A gem gives a different bonus depending on what you put it in: hover over one to see."
		""
		"To socket a gem, put the item and the gem together in a &eSmithing Table&r, or pick the gem up and right-click it onto the item. The item needs an empty socket: Uncommon and better gear often has one."
		""
		"This line covers what to do with them, and with the gear you outgrow."
	]
	quest.347DB171ECD19E8C.title: "A Gem in the Rough"
	quest.348D7F1B4EDB2839.quest_desc: [
		"Better rolls on loot and fishing. It comes in 3 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.348D7F1B4EDB2839.title: "Luck Augments"
	quest.34AF0312EEBA76B7.quest_desc: ["Half a bucket every three ticks. Toggle an end to extract, just like item pipes."]
	quest.34AF0312EEBA76B7.title: "Fluid Pipes"
	quest.34B1C23E843A2C09.quest_desc: [
		"Grows &eCreeper Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of creeper souls and four Tertium Essence on the pedestals."
	]
	quest.34B1C23E843A2C09.title: "Creeper Seeds"
	quest.34DAED11CB75C78C.quest_desc: [
		"A diamond makes the &eAdvanced Processor&r, the one the network's best parts ask for: wireless gear, crafting grids, the 64k part and up."
		""
		"Make a handful at a time. You'll be back for more."
	]
	quest.34DAED11CB75C78C.title: "Advanced Processor"
	quest.350D48A52845E5E8.quest_desc: ["Burns the Ender Dragon's breath, bottled, for 128 FE/t. Each bottle lasts a long time."]
	quest.350D48A52845E5E8.title: "Halitosis Generator"
	quest.3510303011B01564.quest_desc: [
		"Every job on this board can be done again and again, as often as you like."
		""
		"Deliveries take the items when you hand them in, so open the quest and click the task to turn them over. Don't hand over anything you still need. Hunts only count kills."
		""
		"Three tiers: &7Odd Jobs&r pay a Kindling crate, &aCommissions&r a Hearth crate, and &6Grand Bounties&r an Ember crate."
	]
	quest.3510303011B01564.title: "The Bounty Board"
	quest.352A68ABC78A600F.quest_desc: [
		"Fusion needs a spark to get going, and that spark is a laser. A &eLaser&r fires a beam that breaks blocks, and hurts anything in the way."
		""
		"Never stand in front of one."
	]
	quest.352A68ABC78A600F.title: "Lasers"
	quest.353216D47AB13391.quest_desc: ["The biggest chests and barrels there are, with the most upgrade slots."]
	quest.353216D47AB13391.title: "Netherite Tier"
	quest.355AF11335BDC340.quest_desc: ["Point a powered &ePipe Booster&r at an extracting pipe and it pulls a full stack every tick, or up to 50 buckets of fluid."]
	quest.355AF11335BDC340.title: "Pipe Booster"
	quest.35719E573E8621A6.quest_desc: [
		"Once in a long while, a cow you kill drops &eEverlasting Beef&r. Kill it while it's on fire and you get it already cooked."
		""
		"Take a bite and it grows back. It's the last packed lunch you'll ever need."
	]
	quest.35719E573E8621A6.title: "A Meal That Never Ends"
	quest.35742CBFFD53A7D6.quest_desc: [
		"The &eVacuum Module&r sucks nearby items off the ground into the router."
		""
		"Pair it with a Sender Module and items go straight to storage. Add an &eXP Vacuum Augment&r and it gathers experience orbs instead, turning them into Bottles o' Enchanting."
	]
	quest.35742CBFFD53A7D6.title: "Vacuum Module"
	quest.35872551CCE4B575.quest_desc: ["The better ExtraStorage crafters need a &eNeural Processor&r: raw improved and advanced processors, quartz, obsidian and a crafting table around a Processor Binding, then smelted."]
	quest.35872551CCE4B575.title: "Neural Processor"
	quest.35959001CADEC254.quest_desc: [
		"A jar of every berry and stone fruit you can find, lined up on a shelf."
		""
		"Berry bushes grow wild in their own biomes. Break one for the berries, then craft them into seeds to grow your own."
	]
	quest.35959001CADEC254.title: "The Jam Shelf"
	quest.35B4A1778EF5E80B.quest_desc: ["A stack of nether quartz for the glassworks."]
	quest.35B4A1778EF5E80B.quest_subtitle: "Commission"
	quest.35B4A1778EF5E80B.title: "Quartz Delivery"
	quest.35B6228C78CEFB29.quest_desc: ["Thirty-two osmium ingots for the machine shop."]
	quest.35B6228C78CEFB29.quest_subtitle: "Commission"
	quest.35B6228C78CEFB29.title: "Osmium Order"
	quest.35D05A93F31D6519.quest_desc: [
		"Built something you like? The &eCopy Paste Gadget&r builds it again."
		""
		"In copy mode, right-click one corner of your build and shift-right-click the opposite corner. A green box shows what's copied. Switch to paste mode, look where you want it, and right-click."
		""
		"It uses blocks from your inventory. The &eMaterial List&r in its menu shows what you need and what you're short of."
	]
	quest.35D05A93F31D6519.title: "Copy That"
	quest.35E5546AB8C6F6DD.quest_desc: [
		"Grows &ePhantom Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of phantom souls and four Tertium Essence on the pedestals."
	]
	quest.35E5546AB8C6F6DD.title: "Phantom Seeds"
	quest.363D7BC36DCA9B28.quest_desc: ["Every bonus you spliced into it, in one addon. The catch: it only works as the first and only addon on a machine."]
	quest.363D7BC36DCA9B28.title: "Heart of the Machine"
	quest.365EC6354C359484.quest_desc: ["A backpack &eVoid Upgrade&r deletes the items in its filter as you pick them up. Goodbye, cobblestone."]
	quest.365EC6354C359484.title: "Leave It Behind"
	quest.36688CD2FD037DE9.quest_desc: ["An Iron Autocrafter with gold blocks and Neural Processors. More slots, more speed."]
	quest.36688CD2FD037DE9.title: "Gold Autocrafter"
	quest.36810C95B9A33ED7.quest_desc: [
		"Grows &eBlazing Crystal Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Blazing Crystals and four Imperium Essence on the pedestals."
	]
	quest.36810C95B9A33ED7.title: "Blazing Crystal Seeds"
	quest.36E08B143119F7A7.quest_desc: [
		"Grows &eSquid Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of squid souls and four Prudentium Essence on the pedestals."
	]
	quest.36E08B143119F7A7.title: "Squid Seeds"
	quest.36EB4650F02BEA32.quest_desc: [
		"The waystones in villages are handy, but they're never quite where you live. Make your own."
		""
		"A &eWarp Stone&r takes amethyst shards, ender pearls and an emerald. Set it in stone bricks over a row of obsidian, and you have a &eWaystone&r."
		""
		"Put one at home, one at the mine, one at the farm. Traveling between them costs nothing in this pack."
	]
	quest.36EB4650F02BEA32.title: "A Waystone of Your Own"
	quest.371978AE8723C437.quest_desc: [
		"Grows &eRedstone Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Redstone and four Tertium Essence on the pedestals."
	]
	quest.371978AE8723C437.title: "Redstone Seeds"
	quest.37BF4A1A5D96EDBF.quest_desc: [
		"An &eEnergizing Orb&r does nothing alone. Place &eEnergizing Rods&r within four blocks of it, set them on cables so they get power, and right-click your ingredients into the orb. More rods, and better ones, means faster crafting."
		""
		"The orb itself needs no power. Right-click it with an empty hand to take things back out."
		""
		"Most of Powah's better parts are made here. Press &eU&r on the orb to see what it can make."
	]
	quest.37BF4A1A5D96EDBF.title: "The Energizing Orb"
	quest.3811122CB324A706.quest_desc: ["From here on the disks come only from Extra Disks."]
	quest.3811122CB324A706.title: "65536k Storage Disk"
	quest.3811E9601ED0EBF7.quest_desc: [
		"Grows &eNickel Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Nickel Ingots and four Imperium Essence on the pedestals."
	]
	quest.3811E9601ED0EBF7.title: "Nickel Seeds"
	quest.381B137FD77DA906.quest_desc: [
		"Put a Pattern in an &eAutocrafter&r and that item shows up in the Grid as craftable, even with none in stock. Ask for any amount and the network works out the rest, sub-recipes included."
		""
		"For a processing pattern, face the Autocrafter at the machine that does the work. Autocrafters facing each other form a chain, so one machine can serve many patterns."
	]
	quest.381B137FD77DA906.title: "Autocrafting"
	quest.383B0D1A52E598C8.quest_desc: [
		"Wither skeleton skulls, skull fragments, bones and coal."
		""
		"Right-click a Wither Skeleton with a &eModel Framework&r to attune one. Simulating it costs 768 FE a tick, and every run makes a &eGeneralized Nether Prediction&r as well."
	]
	quest.383B0D1A52E598C8.title: "Wither Skeleton Model"
	quest.38534A91108CF3B2.quest_desc: [
		"Point a &eConstruction Stick&r at a wall and right-click: it copies the face you're looking at, one block deep, using blocks from your inventory."
		""
		"The Iron Stick places up to 27 blocks at a time. Diamond and netherite sticks place far more."
		""
		"Made a mess? Hold Shift while hovering the stick for its full guide, including how to undo your last few placements."
	]
	quest.38534A91108CF3B2.title: "Build Faster"
	quest.38755BA4A1629EAF.quest_desc: [
		"A &eBlank Scroll&r is paper, a feather and gold nuggets. Use it on a waystone and it becomes a &eBound Scroll&r that takes you to that waystone."
		""
		"Keep a few bound to home in your backpack. A &eWarp Scroll&r lets you pick any waystone you know instead."
	]
	quest.38755BA4A1629EAF.title: "A Ticket Home"
	quest.38885A1AF52B23C8.quest_desc: [
		"Strange glowing &eSpirit Orbs&r turn up in old chests: buried treasure, ocean ruins, woodland mansions, ancient cities and bastions."
		""
		"Every monster spawner you break drops one, and trial chamber rewards include them too."
		""
		"Collect four, then bring them to the Goddess."
	]
	quest.38885A1AF52B23C8.title: "Spirit Orbs"
	quest.38A6322CAD4EF20E.quest_desc: [
		"Grows &eElectrum Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Electrum Ingots and four Imperium Essence on the pedestals."
	]
	quest.38A6322CAD4EF20E.title: "Electrum Seeds"
	quest.38EAC5CC9ABC90B8.quest_desc: [
		"In the Nether, every skeleton is a Wither Skeleton, not just the ones in fortresses."
		""
		"They drop &eWither Skull Fragments&r. Nine fragments craft a Wither Skeleton Skull, so you'll have three skulls long before your luck would give them to you."
	]
	quest.38EAC5CC9ABC90B8.title: "Skull Fragments"
	quest.392824171370F6EA.quest_desc: [
		"Four Solar Generators and some Infused Alloy make an &eAdvanced Solar Generator&r. It makes far more power than the four did, in one block."
		""
		"It still sleeps at night, so keep something else running beside it."
	]
	quest.392824171370F6EA.title: "Bigger Panels"
	quest.393186B3A7B12B00.quest_desc: [
		"Two Atomic Alloys around an Elite Control Circuit make the &eUltimate Control Circuit&r, the top of the ladder."
		""
		"The last tier of ore processing, the MekaSuit and the Meka-Tool all need them. It's also one of the pieces of the &eAllthemodium Alloy Paxel&r."
	]
	quest.393186B3A7B12B00.title: "Ultimate Control Circuit"
	quest.39466924602BC427.quest_desc: [
		"The world out there is bigger and stranger than you'd think. Terralith reshapes the land into dozens of new biomes, islands float overhead, and towns, towers and ruins wait to be found."
		""
		"Nothing in this chapter has to be done in order. Each row is one kind of discovery, and they tick off as you stumble on them."
		""
		"Chests out here, and the monsters guarding them, carry gear with bonus stats. The two quests either side of the next row are from &eMonsters \\& Mettle&r, the chapter for all of that."
		""
		"Here's a &espyglass&r for scouting the horizon."
	]
	quest.39466924602BC427.title: "Wanderlust"
	quest.395054B4C2775EED.quest_desc: ["The Mk3 sends items to an inventory anywhere, even in another dimension. Mining Dimension output, straight home."]
	quest.395054B4C2775EED.title: "Sender Module Mk3"
	quest.39660BD94267C871.quest_desc: ["Makes the Absorption Hopper reach further."]
	quest.39660BD94267C871.title: "Hopper: Radius"
	quest.396B8362F17604D3.quest_desc: [
		"Macaw's Stairs adds new stair styles, railings, platforms and balconies."
		""
		"A &eBalcony&r can be placed up to four times on the same block. A &eRailing&r goes along the side of a stair. Hit either with &eShears&r to change its style."
	]
	quest.396B8362F17604D3.title: "Up and Out"
	quest.3974DD3DA4A70787.quest_desc: [
		"Oritech's &eBoosted Exo Elytra&r builds an elytra into the Exo Jetpack, with processing units and gunpowder."
		""
		"Its engine only fires while you're already gliding, so take off the usual way and let it carry you from there."
	]
	quest.3974DD3DA4A70787.title: "Wings With an Engine"
	quest.399C9753FE8DFD85.quest_desc: ["&eFluid Pipes&r work like item pipes: wrench the side touching a tank to pull from it, and the fluid flows to whatever the pipe touches."]
	quest.399C9753FE8DFD85.title: "Fluid Pipes"
	quest.399CBDCC664EE39F.quest_desc: [
		"A &ePressurized Reaction Chamber&r turns polonium, water and fluorite into &ePolonium Pellets&r."
		""
		"The MekaSuit, the Meka-Tool, the Modification Station and the SPS all need them."
	]
	quest.399CBDCC664EE39F.title: "Polonium, Not Plutonium"
	quest.39A85A5FA1EB346C.quest_desc: [
		"No room for a Disk Drive? A Storage Part in a Machine Casing makes a &eStorage Block&r, which holds the same amount and joins the network like any other device."
		""
		"Use an empty one in your hand to get the part and the casing back."
	]
	quest.39A85A5FA1EB346C.title: "Storage Blocks"
	quest.39AB7C0BE37D3C0B.quest_desc: [
		"The &eChisel&r turns plain blocks into fancier versions of themselves: stone into tiles, planks into panels, bricks into patterns."
		""
		"Use it to open its menu, drop in a stack, and pick the look you want. &eChisel all&r converts the whole stack at once."
		""
		"Many variants have connected textures that join up across a wall. Turn that on or off in the same menu."
	]
	quest.39AB7C0BE37D3C0B.title: "A Chisel for Everything"
	quest.39BB442C19716C82.quest_desc: [
		"Resource seeds are made on an &eInfusion Altar&r with eight &eInfusion Pedestals&r around it. Place the altar first and it shows you where the pedestals go."
		""
		"Put the seed base on the altar and the ingredients on the pedestals, then right-click the altar with a &eWand&r, or give it a redstone signal."
	]
	quest.39BB442C19716C82.title: "The Infusion Altar"
	quest.39BE6161684FC574.quest_desc: [
		"Cultural Delights brings corn, cucumbers, eggplants and beans, all found growing wild, plus avocado and lemon trees."
		""
		"They open up tacos, curries, pickles and a lot more. Plenty of it uses the cooking pot and cutting board you already have, and the mod adds its own Oven for baking and a Vat for aging."
	]
	quest.39BE6161684FC574.title: "Flavors from Afar"
	quest.39E401E4A9D05B9C.quest_desc: [
		"The &eSolar Neutron Activator&r uses the sun to transmute chemicals. It only works under open sky in daylight."
		""
		"Feed it nuclear waste and it makes &epolonium&r. Feed it lithium and it makes tritium, for fusion."
	]
	quest.39E401E4A9D05B9C.title: "Sunlight, Weaponized"
	quest.39EAE1E71E2CAFF7.quest_desc: [
		"An &eElytra&r hangs in the ship moored beside some &eEnd Cities&r, out on the outer islands. Jump off something high, press jump again, and glide. Fireworks give you a boost in the air."
		""
		"No ship in sight? Oritech's &eParticle Accelerator&r collides feathers with a saddle and makes one."
		""
		"Hang on to a spare. Refined Storage's &eInterdimensional Wireless Transmitter&r takes one, and so does Oritech's &eBoosted Elytra&r."
	]
	quest.39EAE1E71E2CAFF7.title: "Wings of the End"
	quest.3A0D837FE1BE2F95.quest_desc: [
		"Too much cobblestone? Nine of most common blocks craft into a &e1x&r compressed block, nine of those into a 2x, and so on up to 9x."
		""
		"A 9x block holds 387,420,489 of the original. Craft one back down to get nine out again."
	]
	quest.3A0D837FE1BE2F95.title: "Squeeze It Down"
	quest.3A0EE173F063AF38.quest_desc: [
		"Macaw's Furniture is another full set: chairs, tables, desks, kitchen cabinets, bookshelves, drawers and wardrobes."
		""
		"Chairs seat you, and many of the cabinets and drawers open up to store things, so a kitchen can hold your food as well as look the part."
		""
		"Mix it freely with Handcrafted. Nobody's checking."
	]
	quest.3A0EE173F063AF38.title: "A Second Opinion on Furniture"
	quest.3A5BF187321AD9F5.quest_desc: [
		"Put a trained model and a &ePrediction Matrix&r in a powered &eSimulation Chamber&r and it fights the battle for you, producing that mob's &ePrediction&r. A &eLoot Fabricator&r turns predictions into real drops."
		""
		"New models are Faulty, and a Faulty model can't be simulated. Get a few kills in first. After that, the chamber's Training Mode can level a model up for you, at the cost of making nothing while it does."
	]
	quest.3A5BF187321AD9F5.title: "Train a Model"
	quest.3A5E63F89F37E24F.quest_desc: ["A million RF in a block that keeps its charge when you pick it up. A redstone signal stops it sending power."]
	quest.3A5E63F89F37E24F.title: "Portable Energy Storage"
	quest.3ACFD3F5F95A12C3.quest_desc: [
		"The Ender Dragon drops &eDragon Scales&r. You'll want plenty: the Dragon Egg Seed takes four, and so does its crux."
		""
		"The dragon comes back if you place four End Crystals on the exit portal."
	]
	quest.3ACFD3F5F95A12C3.title: "Dragon Scales"
	quest.3AFC4104CC277E71.quest_desc: ["Makes the Meka-Tool dig faster. Install several to stack the effect."]
	quest.3AFC4104CC277E71.title: "Excavation Escalation Unit"
	quest.3B003232D8A9449B.quest_desc: [
		"Wear a full set of &aUncommon&r gear, weapon included, and slay an &cApothic Invader&r. They arrive with a loud noise and a beam of light from the sky, and never in Haven."
		""
		"Do both and the &eAscent&r tier is yours. Every Invader drops its own affix item, so it's worth the fight."
	]
	quest.3B003232D8A9449B.title: "World Tier: Ascent"
	quest.3B05A6F3D0207C39.quest_desc: ["The places worth a screenshot. Some are rare enough that you may need a Nature's Compass to find them."]
	quest.3B05A6F3D0207C39.title: "Wonders of the World"
	quest.3B2379512913DFEE.quest_desc: ["Pack a warm coat. These are the most beautiful cold places in the world."]
	quest.3B2379512913DFEE.title: "Cold Country"
	quest.3B32C2E02BEE59B5.quest_desc: ["Past 4096 buckets, ExtraStorage and Extra Disks take over, just as they do for items."]
	quest.3B32C2E02BEE59B5.title: "16384B Fluid Storage Disk"
	quest.3B5008C4F0E744F8.quest_desc: [
		"A bed, a fire, a pack on your back and a way home. Hang a &elantern&r by the door and call it home."
		""
		"From here the book branches out. &eTools of the Trade&r gets you better gear, &eHearth \\& Table&r fills the kitchen, and &eWanderlust&r is for the road. Follow whichever calls to you."
	]
	quest.3B5008C4F0E744F8.title: "Settled In"
	quest.3B56BC2183E1FD3F.quest_desc: [
		"White birch among the spruce, cool and quiet."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.3B56BC2183E1FD3F.title: "Birch Taiga"
	quest.3B9F8587B26491A8.quest_desc: [
		"Bastion treasure rooms in the Nether have &eSuspicious Soul Sand&r. Brush it for a &eVibranium Smithing Template&r."
		""
		"Seven Allthemodium Ingots and a block of Ancient Stone copy a template into two."
	]
	quest.3B9F8587B26491A8.title: "Bastion Treasure"
	quest.3BC572A604EC93B8.quest_desc: ["Extra Disks also makes an &eAdvanced Storage Housing&r, with Advanced and Improved Processors. Its big parts go into either housing."]
	quest.3BC572A604EC93B8.title: "Advanced Storage Housing"
	quest.3BF050ED090F5DFF.quest_desc: [
		"&eAllthemodium Ore&r sits on the floor of the Deep Dark, right down at the very bottom."
		""
		"It's tough stuff: you need a netherite pickaxe to mine it."
		""
		"Smelt the raw ore into an ingot and break that into nuggets. Four of them open the way to the next step."
	]
	quest.3BF050ED090F5DFF.title: "Allthemodium"
	quest.3BF64D9230AF6997.quest_desc: [
		"Grows &eNature Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Nature Agglomeratio and four Prudentium Essence on the pedestals."
	]
	quest.3BF64D9230AF6997.title: "Nature Seeds"
	quest.3C05CEF2626143D1.quest_desc: [
		"Grows &eNether Star Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Nether Stars and four Insanium Essence on the pedestals."
		""
		"It only grows with a &eNether Star Crux&r under its farmland."
	]
	quest.3C05CEF2626143D1.title: "Nether Star Seeds"
	quest.3C0C3CB21143B2C8.quest_desc: [
		"The &ePurification Chamber&r feeds &eoxygen&r into each ore and gets three &eClumps&r out."
		""
		"Crush the clumps into Dirty Dust, enrich that into dust, and smelt it. Three ingots per ore."
		""
		"Oxygen comes from the Electrolytic Separator, on the chemistry line below."
	]
	quest.3C0C3CB21143B2C8.title: "Triple Your Ores"
	quest.3C2424D4625EDF33.quest_desc: [
		"Give the bush time and it ripens into &eOreberries&r."
		""
		"Smelt them for nuggets of their metal. It's slow, but it never runs out, and a closet full of bushes adds up."
	]
	quest.3C2424D4625EDF33.title: "First Harvest"
	quest.3C4BC56DF9C9E69A.quest_desc: [
		"5,000 Lead in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.3C4BC56DF9C9E69A.title: "Lead Singularity"
	quest.3C5664E1650BDE50.quest_desc: [
		"Grows &eIron Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Iron Ingots and four Tertium Essence on the pedestals."
	]
	quest.3C5664E1650BDE50.title: "Iron Seeds"
	quest.3CCA467D0915314B.quest_desc: ["The last of the metal furnaces."]
	quest.3CCA467D0915314B.title: "Unobtainium Furnace"
	quest.3CE585E4B4A78412.quest_desc: [
		"Some caves are made almost entirely of one stone: &eGranite&r, &eDiorite&r or &eAndesite Caves&r."
		""
		"Handy when you want a lot of one color for a build."
	]
	quest.3CE585E4B4A78412.title: "Three Kinds of Stone"
	quest.3CFD7811CEC9356F.quest_desc: [
		"Terralith has cherry groves, lavender fields, orchid swamps, deserts with grass in them, and far more."
		""
		"Visit all ten. Each one ticks off its own quest in the rows above too. Your Nature's Compass finds any of them, and &eSearch for Next&r skips to another one if the first is too far."
		""
		"Keep an eye out on the way: villages, ruins and waystones turn up where you least expect them. Take this &eExplorer's Compass&r for the structures you'll want to find next."
	]
	quest.3CFD7811CEC9356F.title: "Ten Corners of the World"
	quest.3D35156C3E3C8B71.quest_desc: [
		"Infuse &eInfused Alloy&r with diamond for &eReinforced Alloy&r, the second of the three alloys."
		""
		"Two of them and an Advanced Control Circuit make the next circuit up."
	]
	quest.3D35156C3E3C8B71.title: "Reinforced Alloy"
	quest.3D5510522128253D.quest_desc: [
		"Right-click Farmland with an essence to turn it into &eEssence Farmland&r of that tier, or craft it from Farmland and the essence."
		""
		"Inferium Seeds yield more essence on higher tier farmland. In a Botany Pot, Mystical crops need farmland of their own tier or better to grow at all."
	]
	quest.3D5510522128253D.title: "Essence Farmland"
	quest.3D632C8DFD66A065.quest_desc: [
		"Grows &eEarth Essence&r, one of the four elemental essences the Awakening Altar needs."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Earth Agglomeratio and four Inferium Essence on the pedestals."
	]
	quest.3D632C8DFD66A065.title: "Earth Seeds"
	quest.3DA2D9FFD9251C31.quest_desc: [
		"&ePacking Tape&r is a slimeball and a sheet of paper. Use it on a Sophisticated chest or barrel, then break it: it drops as one item with everything still packed inside."
		""
		"Try to break a stuffed chest without tape and the game stops you, so you don't spray hundreds of items across the floor. Sneak if you really mean it."
	]
	quest.3DA2D9FFD9251C31.title: "Moving Day"
	quest.3E15739EE9969909.quest_desc: ["Diamonds and redstone blocks around an Improved upgrade, and faster again."]
	quest.3E15739EE9969909.title: "Advanced Pipe Upgrade"
	quest.3E32D73E8694CEBA.quest_desc: [
		"The &eBig Solar Panel&r is a 3x3 multiblock that unfolds in daylight and folds away at night. It makes 32 RF a tick, more with better machine cores."
		""
		"No fuel, no upkeep. Just give it open sky."
	]
	quest.3E32D73E8694CEBA.title: "Here Comes the Sun"
	quest.3E3A18A6D93159F3.quest_desc: [
		"Your first energizing recipe: an iron ingot and a gold ingot in the orb come out as two &eEnergized Steel&r."
		""
		"Wrapped around a large basic capacitor, it makes a &eHardened Capacitor&r: the key to Powah's hardened tier."
	]
	quest.3E3A18A6D93159F3.quest_subtitle: "Hardened tier"
	quest.3E3A18A6D93159F3.title: "Energized Steel"
	quest.3E60540A0EE7413F.quest_desc: ["64 FE/t, and thriftier with fuel again. Diamond is where the line branches out."]
	quest.3E60540A0EE7413F.title: "Diamond Generator"
	quest.3EB0FFC5F8A26280.quest_desc: [
		"Fly, as in creative mode. The best one there is."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.3EB0FFC5F8A26280.title: "Flight Augment"
	quest.3EBE29B0EF89E033.quest_desc: [
		"A &eWireless Transmitter&r lets a &eWireless Grid&r reach the network from 16 blocks away."
		""
		"Use the Wireless Grid on any device in the network to bind it, then open it anywhere in range."
		""
		"It runs on a battery, so charge it like any other FE item."
	]
	quest.3EBE29B0EF89E033.title: "Storage on the Go"
	quest.3ECE66DE6744CB4E.quest_desc: [
		"Flux Networks starts in an odd place: the bottom of the world."
		""
		"Set a block of obsidian on top of bedrock, drop some redstone on it, and left-click the obsidian. The redstone gets crushed into &eFlux Dust&r."
		""
		"Bring plenty of redstone. You'll want a lot of dust."
	]
	quest.3ECE66DE6744CB4E.title: "Flux Dust"
	quest.3EDA362D1AC61C2E.quest_desc: [
		"5,000 Glowstone in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.3EDA362D1AC61C2E.title: "Glowstone Singularity"
	quest.3EFE6467063B2323.quest_desc: [
		"An &eImporter&r pulls from whatever it faces into the network. An &eExporter&r pushes the items you choose back out. Between them they can feed furnaces, machines and farms."
		""
		"A &eRegulator Upgrade&r in an Exporter keeps a set amount in the target instead of emptying the network into it."
	]
	quest.3EFE6467063B2323.title: "In and Out"
	quest.3F127ADF89AFA53C.quest_desc: [
		"The &eCybernetic Augmentation Center&r researches and installs permanent upgrades to your body: more health, more armor, faster mining, longer reach, and stranger things further up the tree."
		""
		"It needs ten machine cores, plus at least one &eCybernetic Research Station&r with three cores of its own. Walk into the center to open its research screen."
		""
		"Research takes materials and a great deal of power, so build it near your best generators."
		""
		"When a research finishes, install it from the center's screen for a one-time fee. Hold &eCtrl+G&r for the augment wheel, to switch any installed augment on or off. Removing one doesn't refund the fee."
	]
	quest.3F127ADF89AFA53C.title: "Better Than Flesh"
	quest.3F6ABD274310DE54.quest_desc: [
		"Four Tertium make &eImperium Essence&r, tier four."
		""
		"Your farm is getting big. A Harvester Pylon or a wall of Hopper Botany Pots will save your wrists."
	]
	quest.3F6ABD274310DE54.title: "Imperium"
	quest.3FA66D3E6228E5F7.quest_desc: [
		"Grows &ePlatinum Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Platinum Ingots and four Supremium Essence on the pedestals."
	]
	quest.3FA66D3E6228E5F7.title: "Platinum Seeds"
	quest.3FBFB60D607AD27A.quest_desc: [
		"Mob seeds need Soul Jars full of souls. The &eSoul Extractor&r fills them from mob drops, so a pile of rotten flesh becomes zombie souls."
		""
		"Slower than a Soulium Dagger, but you don't have to fight anything."
	]
	quest.3FBFB60D607AD27A.title: "Soul Extractor"
	quest.3FD66994E830D38E.quest_desc: [
		"A &eStove&r cooks food set on top of it, like a campfire, and heats a cooking pot or skillet placed on it."
		""
		"It's made from a campfire, bricks and iron, and looks right at home in a kitchen."
	]
	quest.3FD66994E830D38E.title: "The Stove"
	quest.3FDDFD72DAD0EED3.quest_desc: [
		"A diamond, energized. Takes a good deal more power than a blazing crystal, so it's a fair test of your rods."
		""
		"Niotic parts make the tier after blazing."
	]
	quest.3FDDFD72DAD0EED3.quest_subtitle: "Niotic tier"
	quest.3FDDFD72DAD0EED3.title: "Niotic Crystal"
	quest.3FE61B1D76951CD4.quest_desc: ["&eAugments&r fit inside a module and change how it works: more range or less, bigger stacks, redstone control, and more. Each module lists the ones it takes."]
	quest.3FE61B1D76951CD4.title: "Fine Tuning"
	quest.3FEC3275BCBAA28A.quest_desc: ["Wake it on purpose this time."]
	quest.3FEC3275BCBAA28A.quest_subtitle: "Grand Bounty"
	quest.3FEC3275BCBAA28A.title: "The Warden"
	quest.40169165FC020457.quest_desc: ["Another road to gold. Built around a copper or iron furnace."]
	quest.40169165FC020457.title: "Silver Furnace"
	quest.402FF1E4D7717A7D.quest_desc: [
		"Macaw's Bridges builds bridges in rope, wood, stone and iron. Lay the pieces in a line and they connect on their own."
		""
		"Use &ePliers&r on a bridge two or more blocks wide to open a gap in the railing for a side entrance. Bridge lanterns and torches sit on the handrails."
	]
	quest.402FF1E4D7717A7D.title: "Across the River"
	quest.40330ACD0008E5A5.quest_desc: [
		"Cobwebs hang across the passages of the &eInfested Caves&r, and the walls are crawling with spiders."
		""
		"Bring shears for the webs and milk for the poison. Cave spiders bite small, but they bite often."
	]
	quest.40330ACD0008E5A5.title: "Something Is Crawling"
	quest.404930A7EBE6EF17.quest_desc: ["And eight of those around a &econduit&r make a &e64x generator&r."]
	quest.404930A7EBE6EF17.title: "Sixty-Four in One"
	quest.4060268902081616.quest_desc: ["Two hundred and sixty-two million items. At this point it's a matter of pride."]
	quest.4060268902081616.title: "262m Storage Disk"
	quest.40901FB0F4228BF8.quest_desc: [
		"Grows &eGlowstone Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Glowstone Dust and four Tertium Essence on the pedestals."
	]
	quest.40901FB0F4228BF8.title: "Glowstone Seeds"
	quest.40D38846E5E836EC.quest_desc: [
		"Cable Tiers makes Autocrafters too, in Elite, Ultra and Mega. They're faster than a plain one and take more patterns."
		""
		"Their menu has an import mode, so a tiered crafter facing a machine can pull back what it made."
	]
	quest.40D38846E5E836EC.title: "Tiered Autocrafters"
	quest.40DD0279CF0D6C17.quest_desc: [
		"Grows &eSulfur Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Sulfur and four Prudentium Essence on the pedestals."
	]
	quest.40DD0279CF0D6C17.title: "Sulfur Seeds"
	quest.40E8C5A0930086CC.quest_desc: [
		"Most Oritech machines are multiblocks. Place the machine, then right-click it: the spots that need &emachine cores&r light up for a few seconds."
		""
		"Right-click the machine with a core in hand and it places the next one for you, as long as the spot is clear. The &ePrimitive Machine Core&r is just planks around a crafting table."
		""
		"Better cores don't make a machine faster. They raise its quality, which decides how many addons it can take."
	]
	quest.40E8C5A0930086CC.title: "Machine Cores"
	quest.41290032827AC583.quest_desc: [
		"Iron Furnaces take augments. Right-click a furnace with an augment to fit it."
		""
		"The &eGenerator&r augment turns the furnace's heat into power, though it can't smelt any more. Better furnaces make more."
	]
	quest.41290032827AC583.title: "A Furnace That Makes Power"
	quest.412CFF44A2A1601C.quest_desc: [
		"Totems of Undying and emeralds."
		""
		"Right-click an Evoker with a &eModel Framework&r to attune one. Simulating it costs 1,024 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.412CFF44A2A1601C.title: "Evoker Model"
	quest.41505B58F8209DB5.quest_desc: ["Pushes mobs one block further, up to ten."]
	quest.41505B58F8209DB5.title: "Fan: Distance"
	quest.4165FE46ED994646.quest_desc: [
		"Every upgrade starts as a plain &eUpgrade&r: Quartz Enriched Iron and glass around an Improved Processor."
		""
		"Importers, Exporters, Constructors, Destructors and more have slots for them."
	]
	quest.4165FE46ED994646.title: "A Blank Upgrade"
	quest.417C041D143D1FDF.quest_desc: [
		"The second size upgrade widens the beam to 5x5. It takes your 3x3 upgrade, a netherite block, diamond blocks, ender pearls and a netherite pickaxe."
		""
		"Take it to the Mining Dimension, aim at a wall, and watch a room open up in front of you."
		""
		"That's the Hollow, mapped and mastered."
	]
	quest.417C041D143D1FDF.title: "Five by Five"
	quest.41F1B79A7A17023B.quest_desc: ["A &ePortable Teleporter&r takes you to any Teleporter on a frequency you can use, from anywhere. It runs on power, and longer trips cost more."]
	quest.41F1B79A7A17023B.title: "Teleporter in Your Pocket"
	quest.4209C6698BB439F1.quest_desc: [
		"Reactors make more power than anything else in the pack, and they can go very wrong."
		""
		"Nuclear waste is &cradioactive&r. Never dump it into the air: keep it in tanks or a Radioactive Waste Barrel, and wear a Hazmat Suit near anything that leaks."
		""
		"Every multiblock here is shown layer by layer in JEI, thanks to Just Enough Mekanism Multiblocks. Look up the casing or the controller before you build."
	]
	quest.4209C6698BB439F1.title: "Read This First"
	quest.428EA159EB908121.quest_desc: [
		"Rolling high ground of grass and bare stone. Climb a ridge and look around."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.428EA159EB908121.title: "Highlands"
	quest.42C7410E288CE2D5.quest_desc: [
		"Plain deepslate caverns low in the world, with &eamethyst geodes&r tucked into the walls."
		""
		"Light up the floor as you go, or the dark fills with company."
	]
	quest.42C7410E288CE2D5.title: "The Deep Caves"
	quest.42D3CDF4C2603F32.quest_desc: [
		"Terralith builds its own walled villages, including one for the desert."
		""
		"Safe places to spend a night on the road, as long as the gates hold."
	]
	quest.42D3CDF4C2603F32.title: "Behind the Walls"
	quest.42DAFF224C708202.quest_desc: [
		"A &eConstructor&r places blocks from the network into the world in front of it. Set which block in its filter."
		""
		"It's built around a &eConstruction Core&r: a Basic Processor with glowstone dust."
	]
	quest.42DAFF224C708202.title: "Put It Down"
	quest.42DB6A9AC763305B.quest_desc: [
		"Oritech's &eItem Pipes&r are planks and nickel. They move eight items every quarter second from any inventory you set them to pull from."
		""
		"Right-click where a pipe meets a machine to make that end pull items out."
	]
	quest.42DB6A9AC763305B.title: "Pipes"
	quest.43171CA0A21CD96E.quest_desc: ["An &eEntity Conveyor&r carries mobs and items along in a straight line. Mobs can spawn on it, too, so a floor of them makes a spawning pad that delivers itself."]
	quest.43171CA0A21CD96E.title: "Entity Conveyor"
	quest.434D5E42347BF4ED.quest_desc: ["Lets the Meka-Tool break a whole vein of ore, or a whole tree, at once."]
	quest.434D5E42347BF4ED.title: "Vein Mining Unit"
	quest.436D95697CAFF8B1.quest_desc: [
		"Break a wider patch of blocks with each swing. It comes in 4 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.436D95697CAFF8B1.title: "Mining Area Augments"
	quest.4373C2DC0D6258C0.quest_desc: ["A backpack &eStack Upgrade&r lets each slot hold more than a stack. The Starter Tier is the cheap first step."]
	quest.4373C2DC0D6258C0.title: "Stack Upgrade Starter Tier"
	quest.4375905579A50B3B.quest_desc: ["Burns enchanted books. Every unwanted Bane of Arthropods finally pays its way."]
	quest.4375905579A50B3B.title: "Enchantment Generator"
	quest.43A81E26E49AE8D1.quest_desc: ["Burns ender pearls for 96 FE/t, or eyes of ender, which last twice as long at 80."]
	quest.43A81E26E49AE8D1.title: "Ender Generator"
	quest.43AD3C86F51A4326.quest_desc: ["An &eActivator Module&r right-clicks blocks and mobs with whatever is in the buffer, like a player would. Shear sheep, milk cows, fill bottles."]
	quest.43AD3C86F51A4326.title: "Activator Module"
	quest.43CDE3A7C43C257D.quest_desc: [
		"&eLush Caves&r grow moss, azaleas and dripleaf, with &eglow berries&r hanging from the roof. Axolotls swim in the pools."
		""
		"Glow berries light up when they're ripe, and you can eat them straight off the vine."
	]
	quest.43CDE3A7C43C257D.title: "Green Underground"
	quest.43F0E240C807DA14.quest_desc: [
		"Stay under water as long as you like."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.43F0E240C807DA14.title: "Water Breathing Augment"
	quest.43FC015E34776F75.quest_desc: [
		"Aquaculture fills the water with real fish: bass and trout in rivers and lakes, tuna and halibut at sea, piranha in the jungle, and plenty more."
		""
		"An &eIron Fishing Rod&r is the first rod that takes upgrades. Every kind of water has its own catch, so fish everywhere you go."
	]
	quest.43FC015E34776F75.title: "Gone Fishing"
	quest.44827C5C087DBCAA.quest_desc: [
		"The first night is the longest. Put up four walls, a door and a bed before the sun goes down, and the mobs will have to wait until tomorrow."
		""
		"Sleeping in a bed sets your spawn point, so it's also how you find your way home after a bad fall."
		""
		"Then make it yours: press &eM&r and drag over the land around your base to claim it, so nobody outside your team can break anything there. Hold &eShift&r while you drag to force-load those chunks instead, and furnaces and farms keep running while you're away."
	]
	quest.44827C5C087DBCAA.title: "A Roof Over Your Head"
	quest.4491DE4DCDDF00A4.quest_desc: [
		"Gear you've outgrown is still worth something. The &eSalvaging Table&r breaks affix items down into &eRarity Materials&r, one kind per rarity."
		""
		"Common gear gives Mysterious Scrap Metal, Uncommon gives Timeworn Fabric, Rare gives Luminous Crystal Shards, and up from there."
		""
		"Those materials pay for reforging, gem cutting and more."
	]
	quest.4491DE4DCDDF00A4.title: "Waste Not"
	quest.449AD8F163FAB64B.quest_desc: [
		"Jump higher. It comes in 3 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.449AD8F163FAB64B.title: "Jump Boost Augments"
	quest.45066EC603C79B12.quest_desc: ["A jetpack built into an elytra. Its engine only fires while you're already gliding, so jump, spread your wings, then hold jump."]
	quest.45066EC603C79B12.title: "Wings and Thrust"
	quest.451DF985F50E8E59.quest_desc: ["Sixty-five thousand buckets: a lake's worth, near enough."]
	quest.451DF985F50E8E59.title: "65536B Fluid Storage Disk"
	quest.45423E939EF42180.quest_desc: [
		"A &eFish Mount&r hangs on the wall and shows off a fish of your choosing. You'll need an Iron Hook to make one."
		""
		"Every proper cabin has one over the fireplace."
	]
	quest.45423E939EF42180.title: "Mount Your Catch"
	quest.4545BC108AF73330.quest_desc: [
		"The &eDestruction Gadget&r clears a whole box of blocks in front of you: a hillside in the way, a wall you changed your mind about, the dirt hut from your first night."
		""
		"Hold &eG&r to set how wide, tall and deep it digs. The preview shows exactly what goes before you commit."
		""
		"If you clear the wrong thing, &eUndo&r in its menu puts it back."
	]
	quest.4545BC108AF73330.title: "Clear the Site"
	quest.458E44B277264570.quest_desc: [
		"The &eTemplate Manager&r saves a copied build onto paper, so you can keep a library of designs and load one back onto the gadget later."
		""
		"It can also copy a design to your clipboard as text, to share with friends in another world. They paste it in, and it's theirs."
	]
	quest.458E44B277264570.title: "Blueprints"
	quest.4594BDB045D00ED7.quest_desc: [
		"The &eLava Generator&r burns lava for 64 RF a tick. It's a Basic Generator with electrum, a magnetic coil and plating, and it needs two machine cores."
		""
		"A Pump over a lava lake keeps it fed for a very long time."
	]
	quest.4594BDB045D00ED7.title: "Lava Generator"
	quest.4597B13902E39790.quest_desc: ["A faster step up from diamond."]
	quest.4597B13902E39790.title: "Emerald Furnace"
	quest.45E3776247E65942.quest_desc: [
		"Bosses drop bigger hearts. Beat one and you'll find a &eMiniature Yellow Heart&r."
		""
		"A &eYellow Heart Canister&r is a Red Heart Canister, a yellow heart and an Enchanted Golden Apple. In this pack you can craft that apple from an apple and eight gold blocks."
		""
		"Stronger hearts come from stronger foes: the Ender Dragon and the Warden have their own. Your collection is only getting started."
	]
	quest.45E3776247E65942.title: "Heart of a Champion"
	quest.45EEDEA4E459E29C.quest_desc: [
		"The top tier. A nether star, two redstone blocks and a block of blazing crystal, energized, come out as sixteen &eNitro Crystals&r."
		""
		"It takes 20 million FE, so a ring of good rods earns its keep here."
	]
	quest.45EEDEA4E459E29C.quest_subtitle: "Nitro tier"
	quest.45EEDEA4E459E29C.title: "Nitro Crystal"
	quest.45F5D1639569BC0F.quest_desc: [
		"Every so often the line comes up heavy with treasure instead of a fish. The best of it is &eNeptune's Bounty&r, a chest full of a sea god's loot."
		""
		"Better rods and the right hooks help. After that it's patience, and a comfortable chair."
		""
		"Here's a tuna for the wall. It won't spoil."
	]
	quest.45F5D1639569BC0F.title: "Neptune's Bounty"
	quest.461985C26EEC198A.quest_desc: ["A &eWireless Block Charger&r powers the machines around it, no cables needed."]
	quest.461985C26EEC198A.title: "Wireless Block Charger"
	quest.4633954BA316E366.quest_desc: [
		"Rotten flesh, iron, carrots and potatoes."
		""
		"Right-click a Zombie with a &eModel Framework&r to attune one. Simulating it costs 128 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.4633954BA316E366.title: "Zombie Model"
	quest.46378A14A28455C5.quest_desc: [
		"Seeds for mob drops, like zombie or skeleton seeds, need a &eSoul Jar&r full of that mob's souls."
		""
		"Carry an empty Soul Jar and kill the mob with a &eSoulium Dagger&r to fill it. Soulium Ore hides in Soulstone veins in the Nether."
		""
		"A Soul Extractor can fill jars from spare mob drops too, though more slowly."
	]
	quest.46378A14A28455C5.title: "Mob Seeds"
	quest.464331F2EC5BB489.quest_desc: [
		"The Allthemodium Alloy Paxel is a pickaxe, axe and shovel in one, forged from the three endgame metals and a finished piece of everything else you've built."
		""
		"It's a long road, and that's the point:"
		""
		"&e1.&r Piglich Hearts, to bind the metals"
		"&e2.&r Three alloy ingots, from the Energizing Orb"
		"&e3.&r Four alloy tools, on an Advanced Crafting Table"
		"&e4.&r One piece from each tech line"
		"&e5.&r The paxel, on an Elite Crafting Table"
		""
		"Every recipe is in JEI. Press &eU&r on an alloy ingot to see where it goes."
		""
		"To start, bring one ingot of each metal and the &eEnergizing Orb&r that will fuse them."
	]
	quest.464331F2EC5BB489.title: "The Alloy Paxel"
	quest.46A00DCC00396BA0.quest_desc: ["Each Fluid Storage Part is three parts of the size below, a bucket, a Quartz Enriched Iron and four processors."]
	quest.46A00DCC00396BA0.title: "256B Fluid Storage Disk"
	quest.46D842909B51EC15.quest_desc: [
		"A &eTeleporter&r sends you to any other Teleporter on the same frequency. Build it into a frame of &eTeleporter Frames&r and set a frequency in its screen."
		""
		"JEI shows the frame. It takes power for every trip, more for longer ones."
	]
	quest.46D842909B51EC15.title: "The Teleporter"
	quest.46D8D8490278ACF7.quest_desc: ["A &eFortune&r upgrade gives the gadget's beam the same luck as an enchanted pickaxe. Each tier costs a little more power per block."]
	quest.46D8D8490278ACF7.title: "Lucky Beam"
	quest.46DC709AAC0E9FE3.quest_desc: [
		"Grows &eQuartz Enriched Iron Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Quartz Enriched Iron and four Tertium Essence on the pedestals."
	]
	quest.46DC709AAC0E9FE3.title: "Quartz Enriched Iron Seeds"
	quest.471612BCC2422437.quest_desc: [
		"Grows &eDragon Egg Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Dragon Scales and four Insanium Essence on the pedestals."
		""
		"It only grows with a &eDragon Egg Crux&r under its farmland."
	]
	quest.471612BCC2422437.title: "Dragon Egg Seeds"
	quest.473B845B86B822CE.quest_desc: [
		"Eating the same steak forever keeps you alive. Eating a little of everything makes you stronger."
		""
		"Spice of Life counts every hearty food you've tried, and each milestone adds &c3 hearts&r. The first comes at 25 foods and the last at 500. Hearts you've earned stay when you die."
		""
		"Only filling food counts: at least four drumsticks of hunger, so snacks won't do. Farmer's Delight and Croptopia have hundreds of meals that qualify."
		""
		"The Food Book shows what you've eaten and how far it is to the next milestone."
	]
	quest.473B845B86B822CE.title: "A Varied Diet"
	quest.474A00541A29B9A8.quest_desc: [
		"Feed FE to a &eWireless Heat Transmitter&r, and place a &eWireless Heat Receiver&r in it to bind them."
		""
		"Then put the receiver in a furnace's fuel slot, and the furnace runs on that power. Iron tier and up."
	]
	quest.474A00541A29B9A8.title: "Heat Without Fuel"
	quest.4778D7EEE5C47D49.quest_desc: [
		"Porkchops and leather."
		""
		"Right-click a Hoglin with a &eModel Framework&r to attune one. Simulating it costs 256 FE a tick, and every run makes a &eGeneralized Nether Prediction&r as well."
	]
	quest.4778D7EEE5C47D49.title: "Hoglin Model"
	quest.4792FFB4325B8F0C.quest_desc: [
		"Four walls keep the rain off. This chapter is about making them feel like home, and it all starts at a &ecrafting table&r."
		""
		"Each quest shows you one family of blocks from the pack's building mods and hands you a few to try. Do them in any order, or skip the ones that don't suit your style."
		""
		"Most of these blocks are made from everyday materials. Hover over one and press &eR&r to see how. Many also have a second trick when you right-click them, so poke at everything."
	]
	quest.4792FFB4325B8F0C.title: "The Builder's Bench"
	quest.47E50B85ED685F60.quest_desc: ["A &eCompacting Upgrade&r squeezes items into their compressed forms as they come in: nuggets into ingots, ingots into blocks."]
	quest.47E50B85ED685F60.title: "Pack It Down"
	quest.47F843839BF823A9.quest_desc: [
		"The &eGas-Burning Generator&r runs on gases like &ehydrogen&r and ethylene."
		""
		"Your Electrolytic Separator makes hydrogen from water, so a separator and this generator side by side turn water into power. It's not free: the separator needs some of that power back."
	]
	quest.47F843839BF823A9.title: "Burning Gas"
	quest.4827ABD9C3930FFE.quest_desc: [
		"The &eElectric Pump&r pulls fluid up from the world: water for your Chemical Washer, or lava from the Nether."
		""
		"It works its way outward through connected fluid, so one pump over a lake goes a long way."
	]
	quest.4827ABD9C3930FFE.title: "Drain the Lake"
	quest.482AE3D49B0CD859.quest_desc: [
		"Blue ice walls, patches of netherrack and sculk, and soul lanterns burning cold. The &eFrostfire Caves&r are the strangest place underground."
		""
		"Only Strays haunt them. Their arrows slow you down, so keep a shield up."
	]
	quest.482AE3D49B0CD859.title: "Frost and Fire"
	quest.487B7226DAD01AE2.quest_desc: [
		"&eFission Reactor Ports&r move fuel and coolant in and waste and steam out. A &eLogic Adapter&r lets redstone watch the reactor and switch it off."
		""
		"Set a Logic Adapter to trip when the reactor is damaged, and wire it so the reactor stops. Start the burn rate low and raise it slowly while you watch the heat."
		""
		"Cooled with water, it makes steam. The turbine on the next line turns that steam into power."
	]
	quest.487B7226DAD01AE2.title: "Critical"
	quest.489918314A63604D.quest_desc: ["A golden apple ringed with four essence becomes an &eessence apple&r. Eat one for a handful of effects: the tooltip lists them."]
	quest.489918314A63604D.title: "An Apple a Day"
	quest.49241F3629B5F1E7.quest_desc: [
		"Hostile Neural Networks grows mob drops from simulations instead of seeds."
		""
		"Craft a &eDeep Learner&r and a &eModel Framework&r. Right-click a mob with the framework to attune it, put the model in the learner, and wear the learner in its Curios slot. &eShift+U&r opens it."
		""
		"Then go fight. Every kill of that mob teaches the model a little more."
	]
	quest.49241F3629B5F1E7.title: "Deep Learner"
	quest.492C3906176473DF.quest_desc: [
		"A Grid, an Advanced Processor and a crafting table make a &eCrafting Grid&r: a Grid with a crafting area that pulls ingredients straight from storage."
		""
		"JEI's recipe transfer button fills it for you."
	]
	quest.492C3906176473DF.title: "Craft in Place"
	quest.49322E8D105D2E0B.quest_desc: [
		"The &eMeka-Tool&r is the Atomic Disassembler grown up: a pick, axe, shovel, hoe, shears and sword in one, made better with modules."
		""
		"It needs Polonium Pellets, so it waits for a fission reactor. See the Reactors chapter."
	]
	quest.49322E8D105D2E0B.title: "The Meka-Tool"
	quest.496A9777A921F518.quest_desc: [
		"Walk and run faster. It comes in 3 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.496A9777A921F518.title: "Speed Augments"
	quest.4A2D493AC7A46C5C.quest_desc: [
		"Till a wide patch of farmland at once. It comes in 4 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.4A2D493AC7A46C5C.title: "Tilling Area Augments"
	quest.4A3EC994756078B7.quest_desc: [
		"The paxel takes a well-advanced piece from each tech line, the kind you'll have once that line is running. You'll get them all back when you craft the paxel."
		""
		"&eMekanism:&r an Elite Control Circuit"
		"&eOritech:&r an Elite Machine Core"
		"&eRefined Storage:&r a 16K Storage Disk"
		"&eMystical Agriculture:&r Supremium Essence"
		"&eHostile Neural Networks:&r a Wither Prediction"
		""
		"The recipe takes four Supremium Essence, so grow a few more."
	]
	quest.4A3EC994756078B7.title: "A Piece of Everything"
	quest.4A43186E8348E9F4.quest_desc: ["Gives pipes access to one chosen slot of the machine. Handy for the Assembler, where each input slot wants something different."]
	quest.4A43186E8348E9F4.title: "Inventory Proxy Addon"
	quest.4A440CD3C7BF5EBB.quest_desc: [
		"A &eWarp Plate&r links to exactly one other plate. Step on one and you arrive at its partner."
		""
		"To pair them, put a &eDormant Shard&r into the first plate. It comes out attuned. Carry the &eAttuned Shard&r to the second plate and slot it in."
		""
		"Plates carry animals too, so they're perfect for moving a herd to the new barn."
	]
	quest.4A440CD3C7BF5EBB.title: "Warp Plates"
	quest.4AF5AA62125900CB.quest_desc: [
		"A bare pipe is slow. Right-click the pulling end of a pipe to open it, and slot in an upgrade."
		""
		"Upgrades move more at once and more often. Better ones also unlock filters, redstone control and how items are shared out, such as round robin across all your furnaces."
		""
		"They go Basic, Improved, Advanced and Ultimate, each built around the one before."
	]
	quest.4AF5AA62125900CB.title: "Faster Pipes"
	quest.4B09C5BECB3F617A.quest_desc: [
		"The &eAtomic Forge&r makes Oritech's best parts: computing engines, AI chips, duratium and, at the very end, prometheum."
		""
		"It needs eight machine cores, and no cable can power it. Only an &eEnderic Laser&r can, and each recipe charges it up before it finishes, so more lasers mean faster work."
	]
	quest.4B09C5BECB3F617A.title: "The Atomic Forge"
	quest.4B899A92E5967D1D.quest_desc: ["A jetpack and an Exo Chestplate fused with ion thrusters and a tank: much more power, much more speed, and it still charges your gear."]
	quest.4B899A92E5967D1D.title: "Exo Jetpack"
	quest.4BC9D4CA74A6568C.quest_desc: [
		"The &esmithing table&r is where diamond gear becomes netherite, and where armor trims are applied."
		""
		"Each upgrade uses a &eNetherite Upgrade&r template. You'll find them in bastion chests in the Nether."
		""
		"Found one? Copy it: seven diamonds, a block of netherrack and the template make two."
	]
	quest.4BC9D4CA74A6568C.title: "The Smithing Table"
	quest.4C099DAA5AC4678D.quest_desc: ["The &eWireless Crafting Grid&r is a Crafting Grid you carry. It's built like the Wireless Grid, around a Crafting Grid instead."]
	quest.4C099DAA5AC4678D.title: "Craft Anywhere"
	quest.4C1EE078836EAA3A.quest_desc: ["Eight Basic Control Circuits for somebody's new factory."]
	quest.4C1EE078836EAA3A.quest_subtitle: "Commission"
	quest.4C1EE078836EAA3A.title: "Circuit Order"
	quest.4C314A69421AD2AC.quest_desc: [
		"Grows &eUranium Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Uranium Ingots and four Imperium Essence on the pedestals."
	]
	quest.4C314A69421AD2AC.title: "Uranium Seeds"
	quest.4C48B47AAEB05307.quest_desc: [
		"Monsters very occasionally drop a &eTrophy&r of themselves. Bosses drop them far more often, and the Ender Dragon always does."
		""
		"Place one, then right-click it with an empty hand to change its size, rotation and pose: standing, sitting or flying. Right-click it with any slab to swap the stand it sits on, or with armor to dress it up."
		""
		"A wall of trophies makes a fine record of your adventures."
	]
	quest.4C48B47AAEB05307.title: "Something for the Mantel"
	quest.4C49B043F29B0D93.quest_desc: ["Tier 3 Battery Upgrades and Ultimate Induction Cells make a Creative Battery for the Mining Gadget."]
	quest.4C49B043F29B0D93.title: "A Gadget That Never Tires"
	quest.4C513A7AE7FC93F6.quest_desc: ["The fortress has gotten crowded again."]
	quest.4C513A7AE7FC93F6.quest_subtitle: "Commission"
	quest.4C513A7AE7FC93F6.title: "Blaze Hunt"
	quest.4C5BB78EF524AC5B.quest_desc: [
		"A &eStack Upgrade&r lets each slot hold more than a stack. Tier 1 doubles it, and every tier after holds more again."
		""
		"Upgrade slots are few, so it's usually the first thing worth putting in a chest."
	]
	quest.4C5BB78EF524AC5B.title: "Deeper Slots"
	quest.4C6B33B00966495A.quest_desc: [
		"The &eEnrichment Chamber&r turns one ore into two dusts. Smelt them and every ore you mine is worth two ingots."
		""
		"Raw ore works too, at a lower rate: three raw ores make four dusts. Ore blocks get the full deal."
		""
		"That's the first tier of five. Keep going."
	]
	quest.4C6B33B00966495A.title: "Double Your Ores"
	quest.4C96A0F8665954F6.quest_desc: [
		"Use fertilizer on farmland and it stays fertilized."
		""
		"&cRed&r makes crops grow faster. &aGreen&r gives a bigger harvest. &eYellow&r stops the soil being trampled."
		""
		"Craft them from dye, seeds and a few gold nuggets."
	]
	quest.4C96A0F8665954F6.title: "Better Dirt"
	quest.4CA5BD885E464469.quest_desc: [
		"Strongholds are huge here: libraries, armories, prisons, crypts and long, dark corridors, all around the End Portal room."
		""
		"You don't have to go through the portal yet. But it's worth knowing where it is."
	]
	quest.4CA5BD885E464469.title: "The Stronghold"
	quest.4CA601136464C123.quest_desc: [
		"A &eFactory&r is a machine with several lanes, so it works on more than one stack at a time."
		""
		"Craft one from the machine it replaces, or upgrade a machine where it stands with a &eTier Installer&r. Installers run from Basic up to Ultimate, and each step adds lanes."
	]
	quest.4CA601136464C123.title: "More Lanes"
	quest.4CDCAAADA0BE1D67.quest_desc: [
		"64k not cutting it? Extra Disks and ExtraStorage both go far past it, starting at &e256k&r with parts built from 64k parts and Advanced Processors."
		""
		"Either mod's disk counts for these quests, and they upgrade the same way."
	]
	quest.4CDCAAADA0BE1D67.title: "Bigger Disks"
	quest.4CDEC2B59132FFD1.quest_desc: [
		"Mekanism machines have upgrade slots. &eSpeed Upgrades&r make a machine work faster and use more power, and &eEnergy Upgrades&r bring the power bill back down."
		""
		"The slowest machine in your line sets the pace for the whole thing, so upgrade that one first."
	]
	quest.4CDEC2B59132FFD1.title: "Faster, Please"
	quest.4CE0F1A6F940F613.quest_desc: [
		"A &eBin&r holds a huge stack of one item. Left-click to take a stack, right-click to put in what you're holding."
		""
		"Bins come in tiers, each holding more than the last."
	]
	quest.4CE0F1A6F940F613.title: "Bins"
	quest.4D043AF9B6243935.quest_desc: [
		"Grows &eIce Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Ice and four Inferium Essence on the pedestals."
	]
	quest.4D043AF9B6243935.title: "Ice Seeds"
	quest.4D17C75658589C4A.quest_desc: ["A stack of cobblestone for the new road."]
	quest.4D17C75658589C4A.quest_subtitle: "Odd Job"
	quest.4D17C75658589C4A.title: "Quarry Run"
	quest.4D181A9753CCF516.quest_desc: [
		"The &eMetallurgic Infuser&r soaks an item in an infusion: carbon from coal, redstone, diamond and more. It's where Mekanism's alloys, circuits and steel come from."
		""
		"The infusion is stored in a gauge, so you can top it up ahead of time and let it work through a stack."
		""
		"Hover over the infuser and press &eU&r to see everything it makes."
	]
	quest.4D181A9753CCF516.title: "The Metallurgic Infuser"
	quest.4D515BD2ADEEDAE0.quest_desc: [
		"The &eAtomic Disassembler&r is a powered tool that mines, chops and digs anything. Its modes trade speed for power use."
		""
		"It also has a vein mode for ores and logs. Charge it like any other powered tool."
	]
	quest.4D515BD2ADEEDAE0.title: "The Atomic Disassembler"
	quest.4D56050E73039436.quest_desc: [
		"Why mine iron when you can grow it? Mystical Agriculture has seeds that grow real resources. This chapter climbs the essence ladder, and &eA Seed for Everything&r has a quest for every seed."
		""
		"It all starts with &eInferium Essence&r. Grass and mobs don't drop it in this pack, so dig for it: &eInferium Ore&r is common underground in the Overworld, from about Y 64 down to Y -32, and each one drops two to four essence. Fortune helps."
		""
		"The Nether and the End have Inferium Ore of their own, too."
	]
	quest.4D56050E73039436.title: "Mystical Agriculture"
	quest.4D67700D3BBF9BEB.quest_desc: [
		"A pot on the stove and whatever the garden gave you today."
		""
		"Farmer's Delight soups simmer in the &eCooking Pot&r. Croptopia's come together in the crafting grid."
	]
	quest.4D67700D3BBF9BEB.title: "Soup Night"
	quest.4D71FB47FC70EFB3.quest_desc: [
		"&eFlux Storage&r holds power for the whole network and evens out the peaks."
		""
		"The &eBasic Flux Storage&r holds 2 million FE."
	]
	quest.4D71FB47FC70EFB3.title: "A Battery for the Network"
	quest.4D793935DDBB2B76.quest_desc: [
		"A diamond, four Prosperity Shards and four Inferium Essence make an &eInfusion Crystal&r."
		""
		"Four essences of one tier around the crystal make one essence of the next tier up. The crystal comes back each time with one use fewer, and it's good for a thousand."
	]
	quest.4D793935DDBB2B76.title: "Infusion Crystal"
	quest.4DAFC1C3473CD8B0.quest_desc: ["The &eCrafting Upgrade&r adds a crafting table to the backpack, in a tab down its side."]
	quest.4DAFC1C3473CD8B0.title: "Craft on the Go"
	quest.4DB8FFC84F331577.quest_desc: [
		"Grows &eLapis Lazuli Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Lapis Lazuli and four Imperium Essence on the pedestals."
	]
	quest.4DB8FFC84F331577.title: "Lapis Lazuli Seeds"
	quest.4DBADCA721BDEC7F.quest_desc: [
		"The &eDigital Miner&r mines whatever blocks you tell it to, in a radius around it, without you lifting a finger. Set filters for the ores you want and leave the stone in place."
		""
		"It's hungry for power, and it needs somewhere to put what it finds. A chest or a transporter on top will do."
	]
	quest.4DBADCA721BDEC7F.title: "The Digital Miner"
	quest.4DC4179E7D8F319B.quest_desc: [
		"The &eCentrifuge&r spins ore clumps into dust and coal dust into &eCarbon Fibre Strands&r, which you'll need for better machine cores."
		""
		"Attach a &eFluid Addon&r and it handles liquids too. Open the machine once after placing the addon so it notices."
	]
	quest.4DC4179E7D8F319B.title: "Spin Cycle"
	quest.4DC5D14811471696.quest_desc: [
		"In the Other's Soul Sand Valleys stand &eAncient Pyramids&r."
		""
		"They're full of loot and guarded by something worse than piglins."
	]
	quest.4DC5D14811471696.title: "Ancient Pyramid"
	quest.4DCA03B18352ECB1.quest_desc: [
		"Phantom membrane, without the sleepless nights."
		""
		"Right-click a Phantom with a &eModel Framework&r to attune one. Simulating it costs 128 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.4DCA03B18352ECB1.title: "Phantom Model"
	quest.4DD0768E9FF2E9AD.quest_desc: [
		"Craft any Sophisticated chest, barrel or shulker box together with a minecart or a boat, and it rides along."
		""
		"A storage minecart is handy at the end of a long rail line, and a storage boat makes a fine floating pantry for river trips."
	]
	quest.4DD0768E9FF2E9AD.title: "Storage on the Move"
	quest.4DD5DC3C6F9063D0.quest_desc: [
		"Getting around is half of exploring. A few keepsakes make it much more fun:"
		""
		"&eRunning Shoes&r speed up your sprint, &eBunny Hoppers&r launch you skyward, the &eHelium Flamingo&r lets you swim through the air, and &eAqua-Dashers&r run across water."
		""
		"Any one of them will do."
	]
	quest.4DD5DC3C6F9063D0.title: "Fleet of Foot"
	quest.4E2D24400FE1977B.quest_desc: [
		"Machines want power, measured in FE. Every bit of it starts with a generator."
		""
		"The &eCopper Generator&r burns coal and other furnace fuel. Powah's &eFurnator&r does the same job."
		""
		"Feed it, connect it to a machine, and you've got a spark. This chapter has a line each for Generator Galore, Powah, Flux Networks and charging your gear. Faster furnaces have a chapter of their own."
	]
	quest.4E2D24400FE1977B.title: "Sparks"
	quest.4E4EDA230B97EFA0.quest_desc: [
		"Sulfur Ore drops Sulfur straight out of the ground."
		""
		"A &eChemical Oxidizer&r turns it into sulfur dioxide. A Chemical Infuser adds oxygen to make sulfur trioxide, and a second infuser mixes that with water vapor for &esulfuric acid&r. A &eRotary Condensentrator&r turns water into water vapor."
		""
		"It's a long chain, so build it once and leave it running."
	]
	quest.4E4EDA230B97EFA0.title: "Sulfuric Acid"
	quest.4E532DF50059A780.quest_desc: [
		"Ghast tears, the hardest drop in the Nether to collect by hand, and gunpowder."
		""
		"Right-click a Ghast with a &eModel Framework&r to attune one. Simulating it costs 256 FE a tick, and every run makes a &eGeneralized Nether Prediction&r as well."
	]
	quest.4E532DF50059A780.title: "Ghast Model"
	quest.4E5916FA573E8B4E.quest_desc: [
		"A &eDisk Drive&r holds storage disks and adds their space to the network. A &e1k Storage Disk&r holds a thousand items of any kind."
		""
		"When you outgrow a disk, craft it with a bigger Storage Part to upgrade it. An empty disk used in your hand gives its part back."
		""
		"The second line is the whole disk ladder, from 4k to infinite."
	]
	quest.4E5916FA573E8B4E.title: "Disks and Drives"
	quest.4E858FA51E7EE948.quest_desc: ["Adds a level of &eBane of Arthropods&r to the Mob Masher. Stack a few for more."]
	quest.4E858FA51E7EE948.title: "Masher: Bane of Arthropods"
	quest.4EAE2D8613BB9B79.quest_desc: ["Plating around &eEnderic Compound&r, which the Pulverizer grinds out of ender pearls or end stone."]
	quest.4EAE2D8613BB9B79.title: "Advanced Machine Core"
	quest.4EB6672AAA138F13.quest_desc: [
		"A full set of &eiron armor&r turns a creeper ambush into a bad afternoon instead of a trip back to bed."
		""
		"Iron gear also repairs cheaply: combine two worn pieces in a crafting grid, or patch one up with ingots on an anvil."
	]
	quest.4EB6672AAA138F13.title: "Suit of Iron"
	quest.4EBAF99BC5CF9AAA.quest_desc: [
		"Grows &eSignalum Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Signalum Ingots and four Imperium Essence on the pedestals."
	]
	quest.4EBAF99BC5CF9AAA.title: "Signalum Seeds"
	quest.4EC4115450CD8A2F.quest_desc: [
		"Build a wall of Sophisticated chests and barrels touching each other, then add a &eStorage Controller&r touching the wall."
		""
		"The whole wall now acts as one. Pipe items into the controller and they spread across every chest in the group; pull from it and you can reach them all."
		""
		"It's not a full storage network, but it ends a lot of chest-hunting. A gap in the wall? &eStorage Connectors&r bridge it."
	]
	quest.4EC4115450CD8A2F.title: "One Chest to Rule Them"
	quest.4ECF4F6673C702D7.quest_desc: [
		"A &ePlayer Transmitter&r charges your gear wherever you are in the same dimension, armor and off hand included."
		""
		"It takes a &eBinding Card&r: right-click it to bind it to yourself, then slot it in. A Dimensional Binding Card works from anywhere."
	]
	quest.4ECF4F6673C702D7.title: "Player Transmitter"
	quest.4EF0489944EF83A2.quest_desc: [
		"The &eDecoration Table&r gives chests and barrels the look of other materials, with a main and an accent color."
		""
		"The &ePaintbrush&r applies a design to storage that's already placed, so you don't have to empty it first."
	]
	quest.4EF0489944EF83A2.title: "Dress It Up"
	quest.4F1908AA3DFF27E5.quest_desc: [
		"Netherite starts as &eancient debris&r, buried near the bottom of the Nether. It shrugs off explosions and lava, and only a diamond pickaxe or better can mine it."
		""
		"Smelt it into netherite scrap. Bring a fire resistance potion and some blocks to wall off the lava."
	]
	quest.4F1908AA3DFF27E5.title: "Ancient Debris"
	quest.4F1F15B6CB784DCB.quest_desc: [
		"The &eMaster Infusion Crystal&r never wears out. It's made from a Supremium Gemstone, Supremium Essence and Prosperity Shards."
		""
		"Once you have one, your old crystals can retire."
	]
	quest.4F1F15B6CB784DCB.title: "Master Infusion Crystal"
	quest.4F3C2E364A1A6F9E.quest_desc: [
		"Whole caverns of &etuff&r, the soft grey stone you usually only see in patches."
		""
		"It makes a lovely building stone, polished or as bricks, so bring a few stacks home."
	]
	quest.4F3C2E364A1A6F9E.title: "Grey on Grey"
	quest.4FBBBE8BA758801D.quest_desc: [
		"Grows &eRabbit Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of rabbit souls and four Tertium Essence on the pedestals."
	]
	quest.4FBBBE8BA758801D.title: "Rabbit Seeds"
	quest.4FBF3A88A9C27809.quest_desc: [
		"5,000 Lapis Lazuli in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.4FBF3A88A9C27809.title: "Lapis Lazuli Singularity"
	quest.4FDDDCB57B5D7E7B.quest_desc: ["The fastest of the vanilla metals."]
	quest.4FDDDCB57B5D7E7B.title: "Netherite Furnace"
	quest.4FDFFEF48D1A7DA3.quest_desc: ["The best speed addon: three quarters faster, for only a little more power. Once you can make these, the Speed Addon retires."]
	quest.4FDFFEF48D1A7DA3.title: "Synergy Matrix"
	quest.508F80BEEF680438.quest_desc: [
		"Eight iron ingots around a furnace make an &eIron Furnace&r, which smelts faster than the stone one. Copper ingots make a &eCopper Furnace&r, a smaller step up."
		""
		"Already built a row of vanilla furnaces? Sneak and right-click one with a &eStone to Iron Furnace Upgrade&r and it changes on the spot. Every tier on this line works that way."
		""
		"Every furnace in the pack runs a little lighter on your computer, too."
	]
	quest.508F80BEEF680438.title: "Iron Furnaces"
	quest.50923A38F1212EF9.quest_desc: [
		"A &eBotany Pot&r grows a crop on a single block. Give it soil and a seed and it grows right there, with no farmland to trample and no field to fence in."
		""
		"Mystical seeds need Essence Farmland as their soil, of their own tier or better. Essence Farmland makes them grow a little faster, too."
	]
	quest.50923A38F1212EF9.title: "A Garden in a Pot"
	quest.50AD5140D01BB781.quest_desc: [
		"Desert temples here are deep tombs, and the curse is real: you get &cMining Fatigue&r inside until the temple is cleared, so digging is slow going."
		""
		"Find the Pharaoh at its heart and put him to rest. The curse lifts with him."
	]
	quest.50AD5140D01BB781.title: "The Pharaoh's Curse"
	quest.50BB11EFD51901DB.quest_desc: ["The last disk with a number on it. The next one doesn't need one."]
	quest.50BB11EFD51901DB.title: "1048m Storage Disk"
	quest.50C07FD3C57F42D2.quest_desc: [
		"Every boss in the world belongs on the wall. Defeat each one and this page gives you its &eTrophy&r to mount."
		""
		"Start with an &eElder Guardian&r, deep in an ocean monument. They'll tire you out before you see them: bring milk for the fatigue."
	]
	quest.50C07FD3C57F42D2.title: "Something from the Deep"
	quest.510AC4AB92CFC70D.quest_desc: ["Ultimate Fluid Tanks and Atomic Alloy make a Creative Fluid Tank. Fill it once with any fluid and it never empties."]
	quest.510AC4AB92CFC70D.title: "An Endless Well"
	quest.510FEAB9BF6E65A2.quest_desc: ["The biggest of ExtraStorage's crafters, built around a Diamond one with netherite blocks."]
	quest.510FEAB9BF6E65A2.title: "Netherite Autocrafter"
	quest.51149F68C2F5E075.quest_desc: ["Each piece of the &eExo Suit&r does one thing: the helmet gives night vision, the chestplate charges your powered gear, the leggings make you faster, and the boots stop all fall damage."]
	quest.51149F68C2F5E075.title: "The Exo Suit"
	quest.511C1A8252391199.quest_desc: [
		"Grows &eTin Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Tin Ingots and four Tertium Essence on the pedestals."
	]
	quest.511C1A8252391199.title: "Tin Seeds"
	quest.512A1D4995618B6F.quest_desc: ["Adds a level of &eFire Aspect&r to the Mob Masher. Stack a few for more."]
	quest.512A1D4995618B6F.title: "Masher: Fire Aspect"
	quest.516C2476AA7CD9EB.quest_desc: ["One Cobblestone 3x: that's 729 cobblestone, compressed three times."]
	quest.516C2476AA7CD9EB.quest_subtitle: "Grand Bounty"
	quest.516C2476AA7CD9EB.title: "The Mountain"
	quest.5175594AC95238CD.quest_desc: ["Place an &eItem Filter&r against an inventory and it only lets matching items through. It doesn't pull on its own, so pipe items into it."]
	quest.5175594AC95238CD.title: "Item Filter"
	quest.5181177C35182E7E.quest_desc: ["The biggest fluid disk Refined Storage makes on its own."]
	quest.5181177C35182E7E.title: "4096B Fluid Storage Disk"
	quest.51B1C7B11F2C5AFD.quest_desc: [
		"Found a great enchantment on a rubbish pickaxe? The &eDis-Enchanting Table&r lifts the enchantments off an item and onto a book, for a little experience."
		""
		"The item's anvil cost resets too, which makes it cheap to work on again."
	]
	quest.51B1C7B11F2C5AFD.title: "Take It Back"
	quest.51BCBEA71F2A6F1D.quest_desc: [
		"A &eConfiguration Card&r copies a machine's side configuration. Sneak and right-click one machine to copy, then right-click another to paste."
		""
		"Set up one factory the way you like and stamp the rest."
	]
	quest.51BCBEA71F2A6F1D.title: "Copy the Settings"
	quest.51BED4F4140F3C49.quest_desc: [
		"Shrug off one bad effect: blindness, fire, hunger, mining fatigue, nausea, poison, slowness, weakness or wither."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.51BED4F4140F3C49.title: "Resistance Augments"
	quest.51C7E2D472ECE61B.quest_desc: [
		"Fifty chests opened, from villages to tombs to islands in the sky. You've seen more of this world than most."
		""
		"There's always another horizon. Keep your compass handy and your waystones close."
	]
	quest.51C7E2D472ECE61B.title: "Seasoned Traveler"
	quest.51F849E524A21C4C.quest_desc: ["Turns an Enderic Laser on living things instead of blocks. Each extra Hunter Addon reaches further. A mob farm with no moving parts."]
	quest.51F849E524A21C4C.title: "Hunter Addon"
	quest.5213D55201CE5D73.quest_desc: ["Makes the Mob Fan's push one block taller, up to three."]
	quest.5213D55201CE5D73.title: "Fan: Height"
	quest.521DD97A3D5968F0.quest_desc: [
		"Grows &ePrismarine Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Prismarine Agglomeratio and four Tertium Essence on the pedestals."
	]
	quest.521DD97A3D5968F0.title: "Prismarine Seeds"
	quest.521E5F0A7211E58A.quest_desc: ["An emerald generator makes 256 FE/t from ordinary furnace fuel."]
	quest.521E5F0A7211E58A.title: "Emerald Generator"
	quest.523AC9E14369AEE2.quest_desc: [
		"Echo shards, a warden tendril and sculk catalysts."
		""
		"Right-click a Warden with a &eModel Framework&r to attune one. Simulating it costs 2,560 FE a tick, and every run makes a &eGeneralized Ender Prediction&r as well."
	]
	quest.523AC9E14369AEE2.title: "Warden Model"
	quest.524F77AB95346DE6.quest_desc: ["Makes the Mob Fan's push one block wider, up to three."]
	quest.524F77AB95346DE6.title: "Fan: Width"
	quest.529EB9E5D8A11071.quest_desc: [
		"A &eTeleport Pad&r is an ender pearl ringed with four Allthemodium Nuggets. Place it in the Overworld, then sneak and right-click it with both hands empty."
		""
		"It takes you to the &eMining Dimension&r: flat layers of stone, deepslate, netherrack and end stone, packed with ore and made to be dug up."
		""
		"Allthemodium turns up in the deepslate layer, and there's plenty of everything else besides."
	]
	quest.529EB9E5D8A11071.title: "The Mining Dimension"
	quest.52BF5C21899642FA.quest_desc: [
		"Prismarine crystals and fish."
		""
		"Right-click a Guardian with a &eModel Framework&r to attune one. Simulating it costs 256 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.52BF5C21899642FA.title: "Guardian Model"
	quest.52E482C149D7265D.quest_desc: [
		"The next metal hides in the &eDeep Dark&r, the hushed sculk caves near the bottom of the world."
		""
		"Walk softly. Sculk shriekers call the Warden, and you don't want to meet it today. Sneak everywhere and keep the noise down."
	]
	quest.52E482C149D7265D.title: "Somewhere Quiet"
	quest.52EF6064FBE39C39.quest_desc: [
		"Grows &ePig Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of pig souls and four Prudentium Essence on the pedestals."
	]
	quest.52EF6064FBE39C39.title: "Pig Seeds"
	quest.52FC1296570F76B8.quest_desc: [
		"Each Storage Part is three parts of the size below, a redstone, a Quartz Enriched Iron and four processors: Basic for 4k, Improved for 16k and Advanced for 64k."
		""
		"Put the part in a Storage Housing for a new disk, or craft it with an old disk to upgrade."
	]
	quest.52FC1296570F76B8.title: "Room to Grow"
	quest.533E9A11E9D7F019.quest_desc: [
		"Croptopia adds dozens more crops, each growing wild in its own kind of biome: lettuce in one place, garlic or strawberries in another."
		""
		"Found one? Put the crop in a crafting grid to turn it into seeds, and start a patch at home."
	]
	quest.533E9A11E9D7F019.title: "A Bigger Garden"
	quest.536953251C697A08.quest_desc: ["Voids fluids and gases, with a filter for up to nine fluids."]
	quest.536953251C697A08.title: "Liquid Trash Can"
	quest.53941AE5A791BEB5.quest_desc: ["Diamonds around gold. Bigger again, and it goes everywhere you do."]
	quest.53941AE5A791BEB5.title: "Diamond Backpack"
	quest.53ABC487E6955F61.quest_desc: [
		"ExtraStorage's &eAdvanced Importer&r and &eAdvanced Exporter&r are the plain ones with an Improved Processor and redstone torches, and many more filter slots."
		""
		"One advanced exporter can stock a whole row of machines."
	]
	quest.53ABC487E6955F61.title: "More Filters"
	quest.5400B57216D6FB2B.quest_desc: ["Eight diamonds, no questions asked."]
	quest.5400B57216D6FB2B.quest_subtitle: "Commission"
	quest.5400B57216D6FB2B.title: "Diamond Order"
	quest.5401516BC00BF512.quest_desc: ["The last tier is made on a smithing table: a netherite upgrade template, your diamond backpack and a netherite ingot."]
	quest.5401516BC00BF512.title: "Netherite Backpack"
	quest.540741D4DD608444.quest_desc: [
		"Mekanism's gases, acids and slurries can live on the network too. &eChemical Storage Disks&r start at 64B, and their parts use osmium where the item parts use iron."
		""
		"Extra Disks carries chemical disks all the way up to infinite."
	]
	quest.540741D4DD608444.title: "Gas and Slurry"
	quest.5409135A38E1707B.quest_desc: [
		"The &eElectrolytic Separator&r splits water into &ehydrogen&r and &eoxygen&r. Pipe water in, and run Pressurized Tubes from the oxygen side to your Purification Chamber."
		""
		"Each output has a button to dump what you don't need, but don't throw the hydrogen away for long. Tier four wants it."
	]
	quest.5409135A38E1707B.title: "Splitting Water"
	quest.544179BC4E2025D2.quest_desc: [
		"Grows &eEnderium Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Enderium Ingots and four Supremium Essence on the pedestals."
	]
	quest.544179BC4E2025D2.title: "Enderium Seeds"
	quest.544AAD2E2A678816.quest_desc: [
		"A campfire cooks four pieces of food at once with no fuel, keeps bees calm while you take their honey, and looks right in front of any cottage."
		""
		"Set it on a hay bale and the smoke climbs high enough to see from far off. That makes a fine beacon home."
	]
	quest.544AAD2E2A678816.title: "Keep the Fire Lit"
	quest.544D6A15C87339ED.quest_desc: [
		"Three metals, three dimensions, and a table big enough for anything. That's the long climb done."
		""
		"What's left is putting them together. The alloys, the alloy tools and the &eAllthemodium Alloy Paxel&r are waiting in &eThe Alloy Paxel&r chapter. Bring Piglich Hearts."
	]
	quest.544D6A15C87339ED.title: "The Summit"
	quest.546B354661789F7F.quest_desc: ["&eChemical Upgrades&r make a machine go further on its gas, like the oxygen in a Purification Chamber."]
	quest.546B354661789F7F.title: "Chemical Upgrade"
	quest.546CCF6A28117AEA.quest_desc: ["The &ePlacer&r puts blocks from its inventory onto the layer below its frame. It plants seeds in farmland and saplings in dirt, and skips spots where the item won't go."]
	quest.546CCF6A28117AEA.title: "Placer"
	quest.547881E0F1DBF4B7.quest_desc: [
		"Plenty of mods come with a guide book, and they pile up fast."
		""
		"The Akashic Tome holds them all. Craft a guide book together with the tome to tuck it inside, then right-click the tome to pick which one to read."
		""
		"For anything else, hover over an item and press &eR&r to see its recipe or &eU&r to see what it's used in."
	]
	quest.547881E0F1DBF4B7.title: "Every Book in One"
	quest.549EDCE390DC120F.quest_desc: [
		"The &ePulverizer&r crushes ore into dust, and dust smelts into more metal than raw ore does. It's slow and simple, and it earns its keep from day one."
		""
		"It also grinds plants into &ebiomass&r for generators, and coal into coal dust for carbon parts later on."
	]
	quest.549EDCE390DC120F.title: "Crush It"
	quest.54AE7316B0A452D1.quest_desc: [
		"Torches keep monsters away. Macaw's Lights does it with style: chandeliers, street lamps, candle holders, paper lamps, garden lights and a dozen kinds of lantern."
		""
		"Tiki torches stack: put one on top of another for a taller one. Some lamps take a dye to change color, and the tooltip tells you which."
	]
	quest.54AE7316B0A452D1.title: "Lamps and Lanterns"
	quest.54F1AEA280C30276.quest_desc: ["The Allthemodium Mace, a Vibranium Smithing Template and a &eBlock of Vibranium&r."]
	quest.54F1AEA280C30276.title: "Vibranium Mace"
	quest.550CC753646BC765.quest_desc: [
		"Keep a &eWarp Stone&r of your own instead of setting it in a waystone. Hold right-click to charge it up, and you can jump to any waystone you know from wherever you're standing."
		""
		"It wears out with use, so carry a spare on long trips."
	]
	quest.550CC753646BC765.title: "Waystones in Your Pocket"
	quest.5524BBF09C99175C.quest_desc: [
		"&eCrystaltine Ingots&r are made from diamonds, lapis, iron, gold and a &enether star&r, laid out seven columns wide. Only an Elite table or bigger can fit them."
		""
		"One craft makes four."
	]
	quest.5524BBF09C99175C.title: "Your First Elite Recipe"
	quest.55274C15951A8044.quest_desc: [
		"Out in the world, gear isn't just iron or diamond. A sword can roll with bonus damage, a chestplate with extra health, boots with a burst of speed. Some even carry sockets for gems."
		""
		"How strong that loot gets, and how strong the monsters guarding it are, depends on your &eWorld Tier&r. Press &eCtrl+T&r to see them."
		""
		"The top line climbs the World Tiers. The middle one is a guide to gems and the workbenches, and the bottom ones are fights worth seeking out. Follow whichever you're in the mood for."
		""
		"Harder fights mean the odd death. Your things go into a &eGrave&r where you fell, which only you can open, and the chat tells you where. Items with the &eSoulbound&r enchantment stay with you instead: World Tier Haven gives you a book of it."
	]
	quest.55274C15951A8044.title: "Monsters \\& Mettle"
	quest.55293F079519C979.quest_desc: [
		"Mekanism has its own storage network, &eQIO&r: a Drive Array full of QIO Drives, reached from a Dashboard anywhere on the same frequency."
		""
		"Refined Storage does the same job here, so this is for anyone who'd rather keep it all Mekanism."
	]
	quest.55293F079519C979.title: "Quantum Item Orchestration"
	quest.55359CA561423DA9.quest_desc: ["Energy Cubes go from Basic up to Ultimate, each holding far more than the one before. Craft each tier from the one below."]
	quest.55359CA561423DA9.title: "A Bigger Battery"
	quest.5570ACD15D5BFA78.quest_desc: [
		"Grows &eGhast Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of ghast souls and four Imperium Essence on the pedestals."
	]
	quest.5570ACD15D5BFA78.title: "Ghast Seeds"
	quest.5585BE782A3BDA1A.quest_desc: [
		"The &ePressurized Reaction Chamber&r takes an item, a fluid and a gas all at once, and gives an item and a gas back."
		""
		"Feed it Bio Fuel, water and hydrogen and you get &eSubstrate&r and ethylene. That's the road to plastic."
	]
	quest.5585BE782A3BDA1A.title: "Pressurized Reactions"
	quest.55B7158AF0C339BC.quest_desc: ["Every simulation uses up one &ePrediction Matrix&r, so the chamber needs a steady supply. Make them in bulk."]
	quest.55B7158AF0C339BC.title: "Prediction Matrix"
	quest.55DB193B18AAC6F4.quest_desc: ["An Unobtainium Jetpack with Ultimate Induction Cells and Atomic Alloy becomes a Creative Jetpack. It never needs charging."]
	quest.55DB193B18AAC6F4.title: "Fly Forever"
	quest.55E37AD0FF63A6DC.quest_desc: [
		"Grows &eZinc Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Zinc Ingots and four Tertium Essence on the pedestals."
	]
	quest.55E37AD0FF63A6DC.title: "Zinc Seeds"
	quest.561E53F418E4C692.quest_desc: [
		"The &eChemical Injection Chamber&r uses &ehydrogen chloride&r to break each ore into four &eShards&r."
		""
		"Send the shards through the Purification Chamber to make clumps, then on through the Crusher, the Enrichment Chamber and the furnace. Four ingots per ore."
		""
		"Hydrogen chloride takes a little chemistry: see the chemistry line below."
	]
	quest.561E53F418E4C692.title: "Quadruple Your Ores"
	quest.563167ECB4BC0935.quest_desc: ["A &eBattery&r charges the gear in your inventory while you carry it. Shift-click one into an Ender Cell to grow its channel."]
	quest.563167ECB4BC0935.title: "Battery"
	quest.5642D750C58BD75A.quest_desc: [
		"The &eExchanging Gadget&r replaces blocks that are already there. Shift-right-click the block you want, then right-click a wall or floor to swap a whole area for it."
		""
		"You get the old blocks back. Put Silk Touch on the gadget if you want grass back as grass rather than dirt."
	]
	quest.5642D750C58BD75A.title: "Swap It Out"
	quest.56510ACDC6D66C53.quest_desc: [
		"Infuse Reinforced Alloy with refined obsidian for &eAtomic Alloy&r, the top of the alloy ladder."
		""
		"Two Atomic Alloys around an Elite Control Circuit make an &eUltimate Control Circuit&r. Each machine in the last tier needs two, so make plenty."
	]
	quest.56510ACDC6D66C53.title: "Atomic Alloy"
	quest.567781E9664542EF.quest_desc: [
		"The showpiece. One each of the copper, iron, silver, gold, diamond, emerald, crystal and obsidian furnaces make eight &eRainbow Plating&r."
		""
		"Wrap the plating around a &eRainbow Core&r, made from netherite furnaces and stained glass in every color of the rainbow."
	]
	quest.567781E9664542EF.title: "The Rainbow Furnace"
	quest.56AF8269532901B1.quest_desc: [
		"Glass panes are fine. Macaw's Windows has framed windows in every wood and stone, and many of them open with a right-click."
		""
		"Stack windows together and they join into one bigger window. A &eWindow Hammer&r changes a window's shape, and a &eWindow Key&r locks it."
		""
		"Shutters, blinds and parapets come in the same woods."
	]
	quest.56AF8269532901B1.title: "Let the Light In"
	quest.56BEDBCEE539CC71.quest_desc: [
		"Cherry trees in full bloom, and pink petals drifting over everything."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.56BEDBCEE539CC71.title: "Sakura Grove"
	quest.56E562F5985B73AF.quest_desc: [
		"A &epaxel&r is a pickaxe, an axe and a shovel in one tool. No more swapping every time you hit dirt."
		""
		"Craft one from a matching pickaxe, axe and shovel with two sticks underneath. There's one for every tier from wood to diamond, plus all of Mekanism's metals. A netherite paxel is upgraded from a diamond one in a smithing table."
	]
	quest.56E562F5985B73AF.title: "Pick, Axe and Shovel"
	quest.56EA5666F227D310.quest_desc: ["A million buckets, and one step short of the end."]
	quest.56EA5666F227D310.title: "1048kB Fluid Storage Disk"
	quest.5709E9EE049F880B.quest_desc: [
		"Iron ingots and poppies."
		""
		"Right-click an Iron Golem with a &eModel Framework&r to attune one. Simulating it costs 1,024 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.5709E9EE049F880B.title: "Iron Golem Model"
	quest.5746D988A1816436.quest_desc: ["A Fortune III book makes the best one. Put it on a Destructor facing an ore block and see what comes out."]
	quest.5746D988A1816436.title: "The Best of Luck"
	quest.57CFE8378E7F3BE5.quest_desc: [
		"A &eGoddess Statue&r stands in some villages, and now and then on its own out on the plains. Bring her four Spirit Orbs and she'll trade them for a gift:"
		""
		"A &cHeart Container&r gives you one more heart, up to 20 extra."
		"A &eStamina Vessel&r grows your stamina wheel for longer flights, up to 10 of them."
		""
		"Winning a raid, or beating the Wither or the Ender Dragon, gives you a Heart Container as well."
	]
	quest.57CFE8378E7F3BE5.title: "Pray to the Goddess"
	quest.57D58CBCC225CD17.quest_desc: [
		"Under every hill there's another world: mossy grottos, ice halls lit by soul lanterns, warm pools, jungles that never see the sun, and rivers of lava near the bottom."
		""
		"Step into any cave and this chapter opens up. The rows below are a tour of the caves themselves, then the ores and what's buried with them. The lines underneath follow the ores down to a dimension of their own, and build a gadget that clears a tunnel in seconds."
		""
		"Take these torches. It's dark down there."
	]
	quest.57D58CBCC225CD17.title: "Into the Hollow"
	quest.580EB79C40EEF010.quest_desc: ["Respawn the dragon with four End Crystals and do it all over again."]
	quest.580EB79C40EEF010.quest_subtitle: "Grand Bounty"
	quest.580EB79C40EEF010.title: "The Dragon, Again"
	quest.581E9572D231D818.quest_desc: [
		"Every so often a &eGoblin Trader&r turns up in the caves. They don't stay long, so trade while you can."
		""
		"Goblins want odds and ends: apples, raw ore, gravel, even rotten flesh. In return they sell things you can't easily make: Goblin Tuned tools, music discs, and maps to hidden places. Every goblin carries different stock."
		""
		"Hit one and it hits back. In the Nether, its cousin the &eVein Goblin&r deals in Nether goods."
	]
	quest.581E9572D231D818.title: "A Goblin Market"
	quest.583466212BCF360A.quest_desc: [
		"A &eModular Router&r is a tiny block with one slot of buffer and room for modules. Each module does one job."
		""
		"A &ePuller Module&r takes items from the inventory beside it. A &eSender Module&r ships them to an inventory in a straight line; the Mk2 doesn't need line of sight."
		""
		"Hover a module and press &eCtrl+C&r to set its direction and filter."
	]
	quest.583466212BCF360A.title: "Route It"
	quest.584BA33364A3188B.quest_desc: [
		"Fission starts with uranium. Run it through an Enrichment Chamber for &eYellow Cake Uranium&r."
		""
		"From there the chemistry gets long: the cake becomes uranium oxide, then uranium hexafluoride with hydrofluoric acid, and finally &efissile fuel&r. JEI walks you through each step."
	]
	quest.584BA33364A3188B.title: "Look, Don't Eat"
	quest.586E7BDC91396CCA.quest_desc: [
		"Grows &eWither Skeleton Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of wither skeleton souls and four Supremium Essence on the pedestals."
	]
	quest.586E7BDC91396CCA.title: "Wither Skeleton Seeds"
	quest.5884C4A63513DFB7.quest_desc: [
		"Hearth \\& Hollow is a cozy-adjacent kitchen-sink pack: a big, pretty world to explore, curated quality of life, tech to automate the boring stuff, and building mods to make it all feel like home. No magic."
		""
		"Take your time. Nothing in the pack is locked behind a quest and there's no wrong order to do things in."
		""
		"Found a bug or a crash? Open an issue at &9github.com/cosmicspork/hearth-and-hollow&r."
		""
		"Take a sleeping bag and something to eat. Night is coming."
	]
	quest.5884C4A63513DFB7.title: "Welcome to Hearth \\& Hollow!"
	quest.58B1A49E08CE631A.quest_desc: ["Thin out the shamblers around the farms."]
	quest.58B1A49E08CE631A.quest_subtitle: "Odd Job"
	quest.58B1A49E08CE631A.title: "Night Watch"
	quest.58CF101FCF38A937.quest_desc: [
		"Two upgrades keep the mess down."
		""
		"&eMagnet&r pulls the drops straight to you. &eVoid Junk&r throws away the blocks you've marked as junk, like stone and dirt, before they ever reach your pack."
	]
	quest.58CF101FCF38A937.title: "Tidy Mining"
	quest.58D3F3C3A75952A5.quest_desc: [
		"The &eCut Paste Gadget&r picks a build up and puts it down somewhere else, chests and their contents included. No blocks needed."
		""
		"Mark the corners as you would with the Copy Paste Gadget, press &eCut&r in its menu, then paste."
		""
		"&cIt has no undo&r, and it only holds one build at a time. Check where you're pasting before you click."
	]
	quest.58D3F3C3A75952A5.title: "Moving House"
	quest.58EB67BD5F0ED8AF.quest_desc: ["16 million FE for the network."]
	quest.58EB67BD5F0ED8AF.title: "Herculean Flux Storage"
	quest.590C3728FC31D0BA.quest_desc: ["Lets the Centrifuge work with liquids, and lets a Drone Port carry them."]
	quest.590C3728FC31D0BA.title: "Fluid Addon"
	quest.59687D3C5A7A4C38.quest_desc: ["Doubles the bonus clumps from a Fragment Forge, and raises what a Destroyer or Enderic Laser gets from the blocks it breaks."]
	quest.59687D3C5A7A4C38.title: "Yield Addon"
	quest.596B7B19800D1766.quest_desc: [
		"Not every long road runs through a reactor. This one runs through rivers, kitchens, far-off biomes and the occasional boss fight."
		""
		"The Almanac has four pages: a &ecookbook&r, an &eangler's log&r, &efield notes&r and a &etrophy wall&r. Finish all four and the book is complete."
		""
		"Each page is a handful of quests in any order, fanning in to a finale that gives you a glowing &6Almanac Page&r. Bring all four to the middle of the book."
		""
		"None of it is needed for anything else. Take your time, and bring friends: it goes faster with a fisher, a cook and an explorer."
	]
	quest.596B7B19800D1766.title: "The Almanac"
	quest.596C66DE5BD8D0F3.quest_desc: ["The &eVoid Upgrade&r deletes whatever you put in its filter as it arrives. Pipe in a quarry's output and keep only what you want."]
	quest.596C66DE5BD8D0F3.title: "Into the Void"
	quest.59737F6289621673.quest_desc: [
		"Chests in dungeons, villages and ruins are &eLoot Chests&r here. Everyone who opens one gets their own fresh loot, so you never find a chest a friend already emptied."
		""
		"Barrels, minecarts with chests and decorated pots work the same way."
	]
	quest.59737F6289621673.title: "Everyone's Share"
	quest.5981048DC24CF0EB.quest_desc: [
		"Mekanism's own ores are switched off here. Osmium, tin, lead, uranium and fluorite come from the same AllTheOres veins as everything else, and Mekanism's machines take them happily."
		""
		"Save some ore blocks whole with &eSilk Touch&r. Every machine in this chapter pays out more for an ore block than for raw ore."
	]
	quest.5981048DC24CF0EB.title: "Where the Osmium Is"
	quest.599BD5103E509CD0.quest_desc: [
		"Sand in a Centrifuge with a Fluid Addon and naphtha makes &ePolymer Resin&r, and resin smelts into &ePlastic&r."
		""
		"No oil yet? Packed wheat spun with water makes raw biopolymer, and spun again it makes plastic too."
	]
	quest.599BD5103E509CD0.title: "Plastic"
	quest.599F03B9A2B63BB6.quest_desc: [
		"Grows &eSoulium Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Soulium Dust and four Imperium Essence on the pedestals."
	]
	quest.599F03B9A2B63BB6.title: "Soulium Seeds"
	quest.59BBA3E3406F55EF.quest_desc: ["Diesel and fluxite in a Centrifuge with a Fluid Addon make &eTurbofuel&r. It burns longest of anything a Fuel Generator takes, and it's what makes jetpacks fly fastest."]
	quest.59BBA3E3406F55EF.title: "Turbofuel"
	quest.59EC7BD5FE16B14B.quest_desc: [
		"The &cPiglich&r haunts the pyramids, and each one drops a &ePiglich Heart&r."
		""
		"Hold on to the hearts. The alloys at the end of this road need them."
	]
	quest.59EC7BD5FE16B14B.title: "The Piglich"
	quest.5A09B156EB2B595F.quest_desc: [
		"A &eDisk Interface&r moves resources between the network and the disks you put in it, in either direction."
		""
		"Use it to empty an old disk into the network, or to fill a disk with something to carry away."
	]
	quest.5A09B156EB2B595F.title: "Disk Interface"
	quest.5A974AA36DDC7B80.quest_desc: [
		"&eThermal Caves&r are warm and wet: pools of water, banks of clay and small dripleaf."
		""
		"The water isn't empty. Drowned like it here, so look before you swim."
	]
	quest.5A974AA36DDC7B80.title: "Hot Springs"
	quest.5A9D3FEB6858C63F.quest_desc: ["Put music discs in a chest with a &eJukebox Upgrade&r and it plays them. The advanced one holds several and plays them in turn."]
	quest.5A9D3FEB6858C63F.title: "A Chest with a Tune"
	quest.5A9E40D30101FD3A.quest_desc: [
		"A &eTarget Dummy&r shows the damage of every hit and your damage per second, so you can tell whether that new affix really is better. Your gear doesn't wear down hitting it."
		""
		"Put a pumpkin on its head and it doubles as a scarecrow: animals keep their distance and monsters won't spawn nearby."
	]
	quest.5A9E40D30101FD3A.title: "Practice Makes Perfect"
	quest.5AAD5AFE2342A321.quest_desc: [
		"Point an Absorption Hopper at a &eSingularity Tank&r and the experience it collects pours in as liquid instead of orbs."
		""
		"An &eXP Tap&r on the side of the tank turns it back into orbs when you want it. The &eJumbo Tank&r holds 1024 buckets."
	]
	quest.5AAD5AFE2342A321.title: "Bottled Experience"
	quest.5AD8924B275D40B4.quest_desc: ["The SPS does strange things to animals that get too close. Try it on a pig. Don't expect much."]
	quest.5AD8924B275D40B4.title: "A Smarter Pig?"
	quest.5AFB73471CB9115E.quest_desc: [
		"The &eBio-Generator&r burns &eBio Fuel&r, which the Crusher makes from almost anything that grows: crops, seeds, saplings, leaves, mushrooms, kelp."
		""
		"Hook it to a farm and your harvest powers your machines."
	]
	quest.5AFB73471CB9115E.title: "Compost Power"
	quest.5B0D97011AAD51FB.quest_desc: ["The &eDropper Module&r drops items from the buffer onto the ground in front of the router."]
	quest.5B0D97011AAD51FB.title: "Dropper Module"
	quest.5B3EA85C5ED7D104.quest_desc: [
		"Rotten flesh and copper."
		""
		"Right-click a Drowned with a &eModel Framework&r to attune one. Simulating it costs 128 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.5B3EA85C5ED7D104.title: "Drowned Model"
	quest.5B78B2141F1E740B.quest_desc: ["Adds a level of &eLooting&r to the Mob Masher. Stack a few for more."]
	quest.5B78B2141F1E740B.title: "Masher: Looting"
	quest.5B7A78F183051B41.quest_desc: [
		"Breeze rods, for wind charges and the mace."
		""
		"Right-click a Breeze with a &eModel Framework&r to attune one. Simulating it costs 256 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.5B7A78F183051B41.title: "Breeze Model"
	quest.5B8915F850F2D439.quest_desc: [
		"Many Croptopia recipes call for a utensil in the crafting grid: a &eFrying Pan&r, &eCooking Pot&r, &eKnife&r, &eMortar and Pestle&r or &eAll Purpose Food Press&r."
		""
		"They're quick to make. Press &eU&r on one to see the dishes it unlocks."
	]
	quest.5B8915F850F2D439.title: "Croptopia's Kitchen"
	quest.5B9CEE28BBEF9AD6.quest_desc: [
		"The rarest water in the world surrounds the mushroom fields, and the &eShroomas&r live nowhere else."
		""
		"Mushroom islands are far out at sea. A Nature's Compass will point the way."
	]
	quest.5B9CEE28BBEF9AD6.title: "Mushroom Island"
	quest.5BAEA4802FBF8642.quest_desc: [
		"Awakened gear is made on the Awakening Altar too: a Supremium piece, Awakened Supremium ingots and gemstones, and forty of each elemental essence."
		""
		"A full set of the armor makes crops grow faster around you as you walk."
	]
	quest.5BAEA4802FBF8642.title: "Wide Awake"
	quest.5BBCAFE8772F71C8.quest_desc: [
		"The &eChemical Crystallizer&r needs two &eFluorite&r gems along with its Ultimate Control Circuits."
		""
		"Fluorite Ore turns up at most depths. It's never plentiful, so pocket every piece you see."
	]
	quest.5BBCAFE8772F71C8.title: "Fluorite"
	quest.5BD9AD94BF7134DC.quest_desc: [
		"Grows &eSpirited Crystal Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Spirited Crystals and four Supremium Essence on the pedestals."
	]
	quest.5BD9AD94BF7134DC.title: "Spirited Crystal Seeds"
	quest.5BE0B9BE960515B6.quest_desc: [
		"Emeralds, and an iron axe now and then."
		""
		"Right-click a Vindicator with a &eModel Framework&r to attune one. Simulating it costs 512 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.5BE0B9BE960515B6.title: "Vindicator Model"
	quest.5C27A27FCA648624.quest_desc: ["&eSaturating Condensers&r above the rotational complex turn spent steam back into water, which you can pipe straight back into the reactor."]
	quest.5C27A27FCA648624.title: "Water Back"
	quest.5C2EFC1448F3F67D.quest_desc: [
		"&eVibranium Ore&r turns up in the Nether, and it needs an Allthemodium pickaxe or better."
		""
		"The Nether only has a little. For more, head through to &eThe Other&r, where &eOther Vibranium Ore&r lines the cave ceilings between Y 0 and 40."
	]
	quest.5C2EFC1448F3F67D.title: "Vibranium"
	quest.5C3F086D39EE3522.quest_desc: ["A &eFilter Upgrade&r sets what may go into the backpack or come out of it when it's placed and piped."]
	quest.5C3F086D39EE3522.title: "Keep It Tidy"
	quest.5CA72705BC29348A.quest_desc: ["Fortune books make &eFortune Upgrades&r, one for each level. In a Destructor they work like a Fortune pickaxe."]
	quest.5CA72705BC29348A.title: "Fortune Upgrade"
	quest.5CAEE453D80469D5.quest_desc: [
		"The &eAdvanced Magnet&r reaches farther, and you can set its range for items and experience separately, from 3 to 11 blocks."
		""
		"It also has an item filter. Set it to a whitelist and it only picks up what you ask for, or a blacklist to leave the cobblestone where it fell."
	]
	quest.5CAEE453D80469D5.title: "A Stronger Pull"
	quest.5CC81A6F093896CE.quest_desc: [
		"A &eLimited Barrel&r trades slots for size: from one slot (I) up to four (IV), and each slot holds many stacks of one item."
		""
		"Perfect for the cobblestone, the dirt and everything else you have far too much of."
	]
	quest.5CC81A6F093896CE.title: "Fewer Slots, Bigger Ones"
	quest.5CD1706347B45FB5.quest_desc: [
		"The &eProtection Pylon&r protects you from yourself: within its range you can't break the blocks or hurt the mobs you've picked with filters."
		""
		"Perfect around a pen of animals or a delicate build."
	]
	quest.5CD1706347B45FB5.title: "Protection Pylon"
	quest.5D03C361BA83F81A.quest_desc: [
		"Relics are rarer keepsakes: mantles, belts, boots, a flute that holds your horse, a ring with seven sins in it."
		""
		"Each one turns up in chests that suit it. Fiery relics hide in Nether chests, others in villages, mineshafts, deserts or the End. Explore widely."
		""
		"In this pack every artifact counts as a relic too, so everything in this chapter can level up."
		""
		"A new relic hides its abilities until you research them: hover over it and hold the research key its tooltip names. Research costs a few of your own levels."
		""
		"Relics earn experience by doing their job, boots by running and claws by digging, and each level gives an &eUpgrade Point&r to spend on the research screen. At the level cap you can &eRank Up&r for a higher cap, though the relic starts again from zero. &eRelic Experience Bottles&r speed it all along."
	]
	quest.5D03C361BA83F81A.title: "A Relic of Your Own"
	quest.5D0664895B5C6CC8.quest_desc: ["The &eSmelting Upgrade&r adds a furnace in a tab on the backpack. Blasting and smoking ones too, and auto versions that smelt as items come in."]
	quest.5D0664895B5C6CC8.title: "A Furnace on Your Back"
	quest.5D0C38B64CE673A3.quest_desc: ["Adds redstone control and comparator output to a machine. Right-click it to set what it does."]
	quest.5D0C38B64CE673A3.title: "Control Unit Addon"
	quest.5D11B0B7FFB9553A.quest_desc: [
		"Wide, open grassland that goes on and on. Good riding country."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.5D11B0B7FFB9553A.title: "Steppe"
	quest.5D30300305202129.quest_desc: [
		"Dry scrub and low bushes. Not much shade, but a long view."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.5D30300305202129.title: "Shrubland"
	quest.5D5482E0506DF402.quest_desc: [
		"Hostile mobs sometimes drop a &cMiniature Red Heart&r. Hold Shift over one to see the odds."
		""
		"Hearts are the start of something lasting: canisters that add &cextra hearts&r for good."
	]
	quest.5D5482E0506DF402.title: "A Heart in Hand"
	quest.5DB6E110E4A92A00.quest_desc: ["A &eCompacting Upgrade&r turns nuggets into ingots and ingots into blocks as you pick them up."]
	quest.5DB6E110E4A92A00.title: "Squeeze It In"
	quest.5DD4B8C411DCA08A.quest_desc: [
		"Wool on a stick makes a &eMob Swab&r. Use it on a mob to collect its 'DNA'."
		""
		"A used swab is the start of a spawn egg, two quests on."
	]
	quest.5DD4B8C411DCA08A.title: "Mob Swab"
	quest.5E0069472D72B496.quest_desc: [
		"Nearly every Mekanism machine needs a &eBasic Control Circuit&r. Infuse an osmium ingot with redstone to make one."
		""
		"Better circuits build on this one, all the way up to Ultimate. Make a few extra while you're here."
	]
	quest.5E0069472D72B496.title: "Basic Control Circuit"
	quest.5E15185300FB6262.quest_desc: [
		"Love a sword but hate its affixes? Reforge it."
		""
		"The &eSimple Reforging Table&r rerolls an item up to Rare. Put in the item, the Rarity Materials for the rarity you want, and &eSigils of Rebirth&r, then pick one of three outcomes, a bit like enchanting."
		""
		"It works on plain gear too, so any good sword can become an affix item."
	]
	quest.5E15185300FB6262.title: "Try, Try Again"
	quest.5E69D6A9480626D4.quest_desc: ["The &ePlayer Module&r moves items between the router and your own inventory, remotely. Armor slots included."]
	quest.5E69D6A9480626D4.title: "Player Module"
	quest.5E6E2522ED0889B4.quest_desc: ["Proper Croptopia meals for a wedding: pizzas, pies, stews and the like."]
	quest.5E6E2522ED0889B4.quest_subtitle: "Commission"
	quest.5E6E2522ED0889B4.title: "Catering Job"
	quest.5EA53D57AFC58156.quest_desc: [
		"A &eParaglider&r is a few sticks and some leather, and it changes how you see a mountain."
		""
		"Hold it in your hand and step off something tall, and you'll glide instead of falling. Gliding uses stamina, shown by the wheel on screen. Land before it runs out."
		""
		"Running and swimming don't use stamina in this pack. Only gliding does."
		""
		"Glide over a lit &eCampfire&r and the rising warm air lifts you up, though it costs stamina too."
	]
	quest.5EA53D57AFC58156.title: "Off the Edge"
	quest.5EC6CBA9F64119C4.quest_desc: ["Somebody has to keep the archers in check."]
	quest.5EC6CBA9F64119C4.quest_subtitle: "Odd Job"
	quest.5EC6CBA9F64119C4.title: "Bone Collector"
	quest.5EF80534532D44CF.quest_desc: ["An apple wrapped in two diamonds and two emeralds. Expensive, but you only need one per canister."]
	quest.5EF80534532D44CF.title: "Relic Apple"
	quest.5F520318C38D225D.quest_desc: [
		"5,000 Platinum in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.5F520318C38D225D.title: "Platinum Singularity"
	quest.5F793A298673F7E9.quest_desc: [
		"Start the cookbook the way you start the day."
		""
		"Croptopia's dishes mostly come together in a crafting grid with a utensil or two. Press &eR&r on any of these to see what it takes."
	]
	quest.5F793A298673F7E9.title: "Farmhouse Breakfast"
	quest.5F8F1CFC350374EF.quest_desc: [
		"Grows &eBlaze Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of blaze souls and four Imperium Essence on the pedestals."
	]
	quest.5F8F1CFC350374EF.title: "Blaze Seeds"
	quest.5FCF791AB95F48E0.quest_desc: ["The reverse: an &eEnergy Discharger&r drains power out of charged items and holds it, for cables to carry off."]
	quest.5FCF791AB95F48E0.title: "Energy Discharger"
	quest.5FDF3E9B33151A38.quest_desc: ["Deeper again. By now one chest can swallow a whole mining trip."]
	quest.5FDF3E9B33151A38.title: "Stack Upgrade Tier 4"
	quest.5FE9CAFF6EB86769.quest_desc: ["Niotic rods move power into the orb faster still."]
	quest.5FE9CAFF6EB86769.title: "Niotic Energizing Rod"
	quest.5FFB46F7B1D9E908.quest_desc: [
		"Enchanting goes deeper here. Every shelf has stats: &eEterna&r sets how high you can enchant, &eQuanta&r makes results swing more, and &eArcana&r brings in rarer enchantments."
		""
		"A &eHellshelf&r adds more Eterna and Quanta than a bookshelf. Your World Tier caps how far Eterna can take you, so the best shelves pay off in higher tiers."
		""
		"The question mark on the enchanting screen shows exactly what you can roll."
	]
	quest.5FFB46F7B1D9E908.title: "Shelves With Heat"
	quest.601B30B6B06C4E0B.quest_desc: [
		"Grows &eSkeleton Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of skeleton souls and four Tertium Essence on the pedestals."
	]
	quest.601B30B6B06C4E0B.title: "Skeleton Seeds"
	quest.601DB237139FA898.quest_desc: [
		"Right-click two &eAllthemodium Ingots&r, two &eVibranium Ingots&r and a &ePiglich Heart&r into an Energizing Orb. It takes 2,000,000 FE and gives you two alloy ingots."
		""
		"That's a lot of power through one orb. More rods, and better ones, fill it faster."
	]
	quest.601DB237139FA898.title: "Vibranium Meets Allthemodium"
	quest.601FF5BC4A18BDE3.quest_desc: [
		"An &eEnergy Cube&r is a battery. It fills up while your generators run and pays it out when they stop."
		""
		"Each face can be set to take power in or push it out, and a cube can charge an item you put in it."
	]
	quest.601FF5BC4A18BDE3.title: "Store the Spare"
	quest.602754F21A6A24E6.quest_desc: ["&ePressurized Tubes&r carry chemicals: gases, slurries and the rest. Oxygen, hydrogen chloride and sulfuric acid all travel in them."]
	quest.602754F21A6A24E6.title: "Moving Gases"
	quest.602941FC879E457D.quest_desc: [
		"Walking is lovely. Flying is faster."
		""
		"Your first &eJetpack&r can be made of wood: planks, a leather strap and a few simple parts. Wear it in your chest slot or a Curios slot (&eShift+G&r), then hold jump to lift off."
		""
		"A wooden jetpack is slow and drinks its charge quickly, but it gets you onto the roof. Better ones are built around the one before."
		""
		"Jetpacks run on FE. Anything that charges items will top one up: a &eWireless Player Charger&r by the door, a Powah &ePlayer Transmitter&r, or a &eFlux Controller&r, all in &eSparks&r. Search \"hover\" in Key Binds for the engine, hover and throttle keys. Hover mode lets you hang in the air while you build."
	]
	quest.602941FC879E457D.title: "Up \\& Away"
	quest.602C37854C65C853.quest_desc: [
		"No more creepers in the garden. The &eInterdiction Pylon&r stops the mobs you choose from spawning, in a range from one chunk up to 5x5. Pick them with &eMob Filters&r."
		""
		"A &eLifeless Filter&r instead stops every natural spawn, over a much bigger area."
	]
	quest.602C37854C65C853.title: "Interdiction Pylon"
	quest.602CCEDB5F28ED21.quest_desc: [
		"A &eChicken Nest&r collects eggs laid by chickens around it, so you don't have to chase them across the coop."
		""
		"Eggs go into a surprising number of recipes. Keep a few chickens."
	]
	quest.602CCEDB5F28ED21.title: "No More Egg Hunts"
	quest.602D1C759C7EFD0E.quest_desc: [
		"A blaze rod, or four blaze powder, energized into a &eBlazing Crystal&r."
		""
		"It's the key to Powah's blazing tier: stronger generators, cells, cables and rods. Each crystal after this one unlocks the next tier the same way."
	]
	quest.602D1C759C7EFD0E.quest_subtitle: "Blazing tier"
	quest.602D1C759C7EFD0E.title: "Blazing Crystal"
	quest.60308AFBA3DB96C6.quest_desc: ["Iron ingots around a copper backpack. More room, and another upgrade slot."]
	quest.60308AFBA3DB96C6.title: "Iron Backpack"
	quest.604F286A4CF9586F.quest_desc: ["A chest with a &eMagnet Upgrade&r pulls in items lying around it. Set it under a tree farm and the saplings come home on their own."]
	quest.604F286A4CF9586F.title: "A Chest That Reaches"
	quest.604F9B0AAE50DCD0.quest_desc: [
		"Substrate with liquid ethylene and oxygen makes &eHDPE Pellets&r in the PRC. Three pellets in an Enrichment Chamber press into an &eHDPE Sheet&r."
		""
		"Sheets go into module bases, the MekaSuit, the Meka-Tool and their workbench."
	]
	quest.604F9B0AAE50DCD0.title: "Plastic"
	quest.606225A066E886EA.quest_desc: [
		"Got a gem you don't need? Drop it on the ground and drop an &eanvil&r on top. It breaks down into &eGem Dust&r."
		""
		"Gem Dust goes into nearly every Apotheosis workbench, so crush your spares rather than tossing them."
	]
	quest.606225A066E886EA.title: "Crushed"
	quest.60AFBBE8E8316C6E.quest_desc: ["Past 8192B, Extra Disks takes the chemical ladder up to infinite. Its parts ask for Atomic Alloy along with the usual Advanced Processors."]
	quest.60AFBBE8E8316C6E.title: "Big Chemical Disks"
	quest.60FE95B6343462DA.quest_desc: [
		"A diamond chest, fully upgraded, fed by pipes and kept tidy by routers. That's a storeroom."
		""
		"When the chests start to feel small again, &eRefined Storage&r turns the whole thing into one searchable network."
	]
	quest.60FE95B6343462DA.title: "A Place for Everything"
	quest.612EE9DE293473FB.quest_desc: [
		"Place a &ePump&r over any liquid and it lowers a trunk until it finds it, then drains the whole body, up to a hundred thousand blocks of it."
		""
		"It costs power for every block it takes. Oil, lava or water, it doesn't mind."
	]
	quest.612EE9DE293473FB.title: "The Pump"
	quest.613D971D345BAD5F.quest_desc: ["The &ePrecision Sawmill&r cuts logs into more planks than a crafting table does, with sawdust on the side."]
	quest.613D971D345BAD5F.title: "The Precision Sawmill"
	quest.613FAEC013BB28F5.quest_desc: [
		"Six scoops, six flavors. Some of them grow on trees in places you'll need to go looking for."
		""
		"A good excuse for a trip somewhere warm."
	]
	quest.613FAEC013BB28F5.title: "The Ice Cream Parlor"
	quest.61517948B15EF2E1.quest_desc: ["Deserts, savannas and badlands look dry, but find water there and these four are waiting in it."]
	quest.61517948B15EF2E1.title: "Rivers in Dry Country"
	quest.616501A9854FC307.quest_desc: ["Real flight, the creative kind, for the MekaSuit's chestplate. It drinks power while you fly."]
	quest.616501A9854FC307.title: "Gravitational Modulating Unit"
	quest.61806F90D6CBB7FB.quest_desc: [
		"A &eWrench&r rotates Refined Storage blocks. Sneak and use it to dismantle one, ready to move."
		""
		"It's Quartz Enriched Iron and a Basic Processor, and it saves a lot of breaking and replacing."
	]
	quest.61806F90D6CBB7FB.title: "The Wrench"
	quest.618B176F170F61CA.quest_desc: [
		"&eAllthemodium Ore&r forms on cave ceilings in Deep Dark biomes, below Y 10. Bring light, walk softly and look up."
		""
		"Smelt the raw ore into ingots. Save a few nuggets: a Teleport Pad needs them."
	]
	quest.618B176F170F61CA.title: "Down in the Deep Dark"
	quest.619E267628A5901B.quest_desc: [
		"A &eStorage Monitor&r shows how much of one item the network holds, right on its face. Sneak and right-click it to choose the item."
		""
		"Left-click takes a stack out, and right-click puts things in. A row of them by the door works like a shop counter."
	]
	quest.619E267628A5901B.title: "On Display"
	quest.61ECA7EF470AE0FC.quest_desc: [
		"Grows &eDiamond Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Diamonds and four Supremium Essence on the pedestals."
	]
	quest.61ECA7EF470AE0FC.title: "Diamond Seeds"
	quest.6208CBB940B7037B.quest_desc: [
		"A rectangle of &eMachine Frames&r, up to 64 blocks a side and empty in the middle, is the base for Oritech's gantry machines."
		""
		"Attach a Destroyer, Placer or Fertilizer to the frame and it rides along the rails, working on the layer of blocks below."
	]
	quest.6208CBB940B7037B.title: "Machine Frames"
	quest.621216B711D6C4DC.quest_desc: ["&eWitherproof Blocks&r, &eBricks&r and &eGlass&r shrug off the Wither's explosions. Build a box out of them and the fight stays in the box."]
	quest.621216B711D6C4DC.title: "A Proper Arena"
	quest.624FBB674E7F2B30.quest_desc: [
		"The &eHarvester&r is two Diamond Scythes and Soulium Ingots on a Machine Frame. It harvests ripe crops in an area around it, burning fuel as it goes."
		""
		"Upgrades widen the area. Hover over it to see how far it reaches."
	]
	quest.624FBB674E7F2B30.title: "The Harvester"
	quest.6250A25C1A8F4027.quest_desc: [
		"Essence tools and armor start from diamond. A diamond tool or armor piece between two &eInferium Ingots&r and two &eInferium Gemstones&r comes out as Inferium gear, enchantments and all."
		""
		"An ingot is a Prosperity Ingot and two essence, a gemstone a Prosperity Gemstone and two essence. There's a set of tools, weapons and armor for every tier."
	]
	quest.6250A25C1A8F4027.title: "Essence Gear"
	quest.6269BD5E294CD53A.quest_desc: [
		"A &eMilk Jar&r stores milk for recipes. A Cow in a Jar makes its own."
		""
		"Lead a cow over a Milk Jar and drop an anvil on it. Don't ask how it fits."
	]
	quest.6269BD5E294CD53A.title: "Cow in a Jar"
	quest.6278C057B3D87B2C.quest_desc: [
		"A &egrindstone&r strips the enchantments from an item and hands back some of the experience. Curses stay put."
		""
		"It also combines two worn tools of the same kind into one, with the durability added together."
	]
	quest.6278C057B3D87B2C.title: "Start Fresh"
	quest.627CB43059F48766.quest_desc: [
		"Each tier is built on the one below: an Prudentium piece between two &eTertium Ingots&r and two &eTertium Gemstones&r."
		""
		"Damage and enchantments carry over, so nothing you put into the old piece is lost."
	]
	quest.627CB43059F48766.title: "Tertium Gear"
	quest.62935F01AE8F7AB6.quest_desc: [
		"Each tier is built on the one below: an Tertium piece between two &eImperium Ingots&r and two &eImperium Gemstones&r."
		""
		"Damage and enchantments carry over, so nothing you put into the old piece is lost."
	]
	quest.62935F01AE8F7AB6.title: "Imperium Gear"
	quest.631288BFB2AD915D.quest_desc: [
		"Grows &eSilver Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Silver Ingots and four Tertium Essence on the pedestals."
	]
	quest.631288BFB2AD915D.title: "Silver Seeds"
	quest.6327524005753A2A.quest_desc: [
		"Grows &eInvar Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Invar Ingots and four Imperium Essence on the pedestals."
	]
	quest.6327524005753A2A.title: "Invar Seeds"
	quest.633C01D84DB7729C.quest_desc: ["A &eJukebox Upgrade&r plays music discs from your backpack while you walk. The advanced one holds a whole playlist."]
	quest.633C01D84DB7729C.title: "Bring the Music"
	quest.63B7777813217FB5.quest_desc: [
		"Creepers and endermen here dress for the biome they live in, and they don't all fight the same way. Endermen out in the End can throw you somewhere else with a single hit."
		""
		"Many endermen drop a pearl of their own. Snowy ones drop the &eIcy Pearl&r, which freezes whatever it hits, a &eBubble Pearl&r flies straight with no drop, and an &eAncient Pearl&r calls a friendly enderman to fight for you."
	]
	quest.63B7777813217FB5.title: "Locals With Attitude"
	quest.63BF0EE6E676E66E.quest_desc: [
		"Blackstone, basalt and magma, with lava dripping from the roof. The &eMantle Caves&r feel like the Nether broke through."
		""
		"Watch where you step, and keep a bucket of water handy. The potion should help."
	]
	quest.63BF0EE6E676E66E.title: "Close to the Core"
	quest.63E0ADA390159C38.quest_desc: [
		"Every window deserves curtains. Macaw's Windows has them in all sixteen colors, plus curtain rods to hang them from."
		""
		"Right-click a curtain to tie it back to one side."
	]
	quest.63E0ADA390159C38.title: "Draw the Curtains"
	quest.63F1EAE74A1DFED2.quest_desc: ["The deepest slots Sophisticated Storage makes. Put one in a netherite barrel and see how far it goes."]
	quest.63F1EAE74A1DFED2.title: "Stack Upgrade Tier 5"
	quest.64142DBF2F5648FE.quest_desc: [
		"YUNG's Better Dungeons replaces the old cobblestone box with real dungeons: skeleton dungeons, spider dungeons, and zombie dungeons with a staircase down from the surface."
		""
		"Bring torches, food and a good sword. Breaking the spawners makes the place quieter, and drops something you'll want soon."
	]
	quest.64142DBF2F5648FE.title: "Down in the Dark"
	quest.6414F40CD42B0211.quest_desc: ["Built around an Allthemodium Jetpack with vibranium ingots. More armor, more speed, more charge."]
	quest.6414F40CD42B0211.title: "Vibranium Jetpack"
	quest.64391E9B9A321FED.quest_desc: ["256 FE/t, and it holds a lot more power than the emerald one."]
	quest.64391E9B9A321FED.title: "Netherite Generator"
	quest.645990DA0BF7D21C.quest_desc: ["The advanced &eWireless Player Charger&r reaches farther and charges faster."]
	quest.645990DA0BF7D21C.title: "Advanced Player Charger"
	quest.646E3D84C94D2473.quest_desc: [
		"Grows &eNetherite Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Netherite Ingots and four Supremium Essence on the pedestals."
	]
	quest.646E3D84C94D2473.title: "Netherite Seeds"
	quest.64E0513952E39D02.quest_desc: [
		"String, spider eyes and cobwebs."
		""
		"Right-click a Spider with a &eModel Framework&r to attune one. Simulating it costs 128 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.64E0513952E39D02.title: "Spider Model"
	quest.6524445C3AABEF30.quest_desc: [
		"5,000 Gold in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.6524445C3AABEF30.title: "Gold Singularity"
	quest.65310972DDC3E3D4.quest_desc: [
		"Grows &eSheep Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of sheep souls and four Prudentium Essence on the pedestals."
	]
	quest.65310972DDC3E3D4.title: "Sheep Seeds"
	quest.65B21594EE43AAD9.quest_desc: [
		"Your backpack has upgrade slots down its side. Every upgrade starts from an &eUpgrade Base&r: string, iron and leather."
		""
		"Many chest upgrades also craft straight into their backpack twin, so a spare from your chests isn't wasted."
	]
	quest.65B21594EE43AAD9.title: "Backpack Upgrades"
	quest.65B272BB7973E20F.quest_desc: ["Prometheum tools have no durability at all. The &ePickaxe&r switches between area mining and Silk Touch, and the &eBattleaxe&r fells a whole tree if you sneak while you chop."]
	quest.65B272BB7973E20F.title: "Tools That Never Break"
	quest.65D2D26F132D8F8A.quest_desc: ["Wireless Universal Grids and Ultimate Induction Cells make a Creative Wireless Universal Grid that never runs flat."]
	quest.65D2D26F132D8F8A.title: "Everything, Everywhere"
	quest.65EE65E03AAB3B13.quest_desc: [
		"An Advanced Control Circuit between two Reinforced Alloys makes an &eElite Control Circuit&r."
		""
		"The Chemical Injection Chamber needs two, plus Reinforced Alloy, gold, and a Purification Chamber to build on."
	]
	quest.65EE65E03AAB3B13.title: "Elite Control Circuit"
	quest.65F3240CE2B8E852.quest_desc: [
		"Infuse a &ecopper ingot&r with redstone and you get &eInfused Alloy&r, the first of Mekanism's three alloys."
		""
		"You'll go through a lot of it. Generators, the Electrolytic Separator, the Purification Chamber and the chemical machines all want some."
	]
	quest.65F3240CE2B8E852.title: "Infused Alloy"
	quest.65FB0CCC4FB6BADE.quest_desc: ["Gold and redstone around a Basic upgrade. Moves more, more often."]
	quest.65FB0CCC4FB6BADE.title: "Improved Pipe Upgrade"
	quest.6620A16CFB01713B.quest_desc: [
		"The &eFoundry&r makes Oritech's alloys: steel, electrum, adamant and more. You can hand-craft the first few, but it costs far more metal than the foundry does."
		""
		"It needs three machine cores. The manual's advice is to pair it with your Pulverizer as soon as you can."
		""
		"Adamant from the foundry is what you need for the Assembler, next."
	]
	quest.6620A16CFB01713B.title: "The Foundry"
	quest.6627F19FCB95EEB9.quest_desc: ["Now try a creeper. Stand well back."]
	quest.6627F19FCB95EEB9.title: "Supercharged"
	quest.66502B332CF836C7.quest_desc: [
		"An empty &eStorage Housing&r is glass, redstone and Quartz Enriched Iron. Put any Storage Part in one and it becomes a disk."
		""
		"Making the housing and the part separately is handy when you keep spare parts around."
	]
	quest.66502B332CF836C7.title: "Storage Housing"
	quest.6652A1C28FB978CB.quest_desc: [
		"5,000 Aluminum in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.6652A1C28FB978CB.title: "Aluminum Singularity"
	quest.665EEB86298DA219.quest_desc: [
		"Every feast there is. Set them out on one long table and invite the whole server."
		""
		"Each one only has to be in your inventory once. After that, set it out and let everyone help themselves."
	]
	quest.665EEB86298DA219.title: "A Table for Everyone"
	quest.666D0F96D8BD2B0F.quest_desc: [
		"A &eChargepad&r charges anything powered in your inventory while you stand on it, from any mod: tools, jetpacks, gadgets."
		""
		"Put one by the door."
	]
	quest.666D0F96D8BD2B0F.title: "Stand Here"
	quest.66C576AD650B451D.quest_desc: [
		"The &eAntiprotonic Nucleosynthesizer&r uses a little antimatter and a lot of power to turn one thing into another: coal into diamond, diamond into emerald, an egg into a dragon egg."
		""
		"JEI lists everything it knows."
	]
	quest.66C576AD650B451D.title: "Alchemy, With Science"
	quest.66E39867BC33D027.quest_desc: [
		"Modules go into the Meka-Tool and MekaSuit at a &eModification Station&r. Every module starts from a &eModule Base&r: HDPE, tin and bronze."
		""
		"Put the gear in, then the module. Most modules can be installed several times for a stronger effect."
	]
	quest.66E39867BC33D027.title: "The Modification Station"
	quest.6720CF3DBE3A0AC2.quest_desc: [
		"The cheap way to kill mobs. &eIron Spikes&r hurt anything that walks over them and drop its experience."
		""
		"Their kills don't count as player kills, though, so some drops never come. The Mob Masher's do."
	]
	quest.6720CF3DBE3A0AC2.title: "Iron Spikes"
	quest.672BDE2DDB749647.quest_desc: [
		"A full chest doesn't need emptying to get bigger. Right-click a placed one with a tier upgrade, such as &eBasic to Iron Tier Upgrade&r, and it grows on the spot with everything still inside. A double chest takes two."
		""
		"You can also craft the next tier directly: a Sophisticated chest ringed with copper ingots becomes a Copper Chest."
		""
		"Copper, iron, gold, diamond, netherite. Each step adds room, and most add another upgrade slot."
	]
	quest.672BDE2DDB749647.title: "Upgrade in Place"
	quest.672D4A365A04B735.quest_desc: [
		"Five ingots from every ore. Every swing of the pickaxe is worth five times what it used to be."
		""
		"The &eUltimate Control Circuit&r is also one of the pieces of the &eAllthemodium Alloy Paxel&r, the pack's capstone. The paxel quest gives it back once you've crafted the paxel."
		""
		"From here, swap your machines for factories and let the line chew through everything you dig up."
	]
	quest.672D4A365A04B735.title: "Five From One"
	quest.67388593CFA104CC.quest_desc: [
		"Everything you store, in one window. Connect a &eGrid&r to the network and put things in or take them out from one place."
		""
		"The search box has tricks: start with &e@&r to search by mod, &e#&r by tag, or &e$&r by tooltip."
		""
		"A &eMachine Casing&r is eight Quartz Enriched Iron around a stone. The two cores are a Basic Processor with glowstone dust or with quartz."
	]
	quest.67388593CFA104CC.title: "The Grid"
	quest.677BEC24411F3B73.quest_desc: [
		"You already know waystones live in villages. They also stand alone out in the countryside, in a style that matches the land around them."
		""
		"Activate five. The more you have, the less walking home."
		""
		"Here's a &eWarp Stone&r. Hold right-click with it, anywhere, and you can travel to any waystone you've activated."
	]
	quest.677BEC24411F3B73.title: "Stones in the Wild"
	quest.67963E9E8CC3F3B6.quest_desc: [
		"Put an &eExternal Storage&r against a chest, barrel or drawer and its contents show up in the Grid. The network can fill it too."
		""
		"It's a gentle way to move in: keep your old storage and hook it up while you build disks."
	]
	quest.67963E9E8CC3F3B6.title: "Bring Your Chests"
	quest.67C1B647A7C23F32.quest_desc: [
		"Rabbit hide, meat and rabbit's feet."
		""
		"Right-click a Rabbit with a &eModel Framework&r to attune one. Simulating it costs 64 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.67C1B647A7C23F32.title: "Rabbit Model"
	quest.67CD54A705D777AA.quest_desc: ["The deepest backpack slots there are."]
	quest.67CD54A705D777AA.title: "Stack Upgrade Tier 4"
	quest.67D301ADF4ADA2EC.quest_desc: [
		"Mekanism's &eHDPE Reinforced Elytra&r is an elytra wrapped in five HDPE sheets and two atomic alloy."
		""
		"It flies like any elytra but lasts longer between repairs."
	]
	quest.67D301ADF4ADA2EC.title: "Plastic Wings"
	quest.67D3BBE2F9B57DB6.quest_desc: ["More slots and a bigger transfer quota, for feeding a hungry machine line."]
	quest.67D3BBE2F9B57DB6.title: "Tiered Interfaces"
	quest.67D772C8D56E8FFB.quest_desc: ["A &eDetector Module&r gives off a redstone signal when the item in the buffer matches its filter."]
	quest.67D772C8D56E8FFB.title: "Detector Module"
	quest.67E4B99842AE40C6.quest_desc: ["A thousand buckets. Enough lava to run a generator for a long while."]
	quest.67E4B99842AE40C6.title: "1024B Fluid Storage Disk"
	quest.68064347936C2E86.quest_desc: [
		"5,000 Steel in the Quantum Compressor."
		""
		"Steel is an alloy. Press &eR&r on the ingot to see what makes it."
	]
	quest.68064347936C2E86.title: "Steel Singularity"
	quest.68751B8E3969A37D.quest_desc: [
		"Oil springs gush up out of the ground, and they're much more common in deserts."
		""
		"Fill a bucket, or set a &ePump&r over the spring. It lowers a pipe until it finds the oil, then drains the whole pool into its tank."
		""
		"Crude oil burns in a &eFuel Generator&r as it is, but it's worth far more refined."
	]
	quest.68751B8E3969A37D.title: "Black Gold"
	quest.68921C32DF469C53.quest_desc: ["Sneak and right-click an animal with a &eMob Catcher Upgrade&r fitted, and it goes into a backpack slot. The advanced one catches monsters too."]
	quest.68921C32DF469C53.title: "Pocket Zoo"
	quest.68A6C974FE45D895.quest_desc: [
		"The &eAddon Splicer&r squeezes several addons into one block. Attach the addons to it through extenders, fill it with power, and it fuses them into a &eHeart of the Machine&r."
		""
		"It needs four machine cores and a lot of RF."
	]
	quest.68A6C974FE45D895.title: "Addon Splicer"
	quest.68D62D82C54B61B1.quest_desc: ["With a &eTool Swapper Upgrade&r, hitting a block or a mob swaps the best tool from your backpack into your hand."]
	quest.68D62D82C54B61B1.title: "The Right Tool"
	quest.68D839180FC9A4FB.quest_desc: ["&eEnergy Pipes&r carry FE from generators to machines, the same way."]
	quest.68D839180FC9A4FB.title: "Energy Pipes"
	quest.68DF1CC5922CC711.quest_desc: [
		"Grows &eWood Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Logs, any kind and four Inferium Essence on the pedestals."
	]
	quest.68DF1CC5922CC711.title: "Wood Seeds"
	quest.690E4BD4BAE14389.quest_desc: ["A &eMob Fan&r pushes mobs the way it faces, straight into whatever's waiting. Upgrades change how far, wide and high it blows."]
	quest.690E4BD4BAE14389.title: "Mob Fan"
	quest.69274539DC7502D1.quest_desc: ["Cooked fish of any kind, for the Friday fish fry."]
	quest.69274539DC7502D1.quest_subtitle: "Odd Job"
	quest.69274539DC7502D1.title: "Fresh Catch"
	quest.6997BAC09A05CC77.quest_desc: [
		"Right-click a block to save its position, then sneak and right-click a machine to give it that target."
		""
		"Lasers, Drone Ports and Power Poles all take their orders this way."
	]
	quest.6997BAC09A05CC77.title: "Target Designator"
	quest.69A1D8992A92198D.quest_desc: [
		"The &eRotary Condensentrator&r turns chemicals into their fluid form and back again. Flip the switch on its screen to choose which way."
		""
		"It's how water becomes water vapor for sulfuric acid, and how ethylene becomes a liquid for plastic."
	]
	quest.69A1D8992A92198D.title: "Gas to Liquid"
	quest.69E58B74588C0E28.quest_desc: [
		"Every transmitter comes in four tiers. Each one is eight of the tier below around an alloy: infused for advanced, reinforced for elite and atomic for ultimate."
		""
		"Each tier moves more chemicals, and faster, so it pays to upgrade the busiest lines first."
	]
	quest.69E58B74588C0E28.title: "Ultimate Pressurized Tube"
	quest.6A017F11683968AD.quest_desc: ["Any color. The weavers aren't fussy."]
	quest.6A017F11683968AD.quest_subtitle: "Odd Job"
	quest.6A017F11683968AD.title: "Shearing Day"
	quest.6A1D87E61510373E.quest_desc: [
		"The &ePersonal Shrinking Device&r makes you small. Right-click it to pick a size, then sneak and right-click to shrink. Do it again to grow back."
		""
		"Small you fits through gaps and under slabs, which is half the fun of building a tiny house inside a big one."
		""
		"It runs on FE, a little each time, so charge it like your jetpack. It works on animals too."
	]
	quest.6A1D87E61510373E.title: "Honey, I Shrunk Me"
	quest.6A3251FB0068955D.quest_desc: ["Items, fluids and energy, all in one can. It's made from one of each of the other three."]
	quest.6A3251FB0068955D.title: "Ultimate Trash Can"
	quest.6A3830D4991E6114.quest_desc: [
		"A &eRed Heart Canister&r is a Canister, a Miniature Red Heart, a Relic Apple and a Wither Bone. The Canister itself is iron and a bone."
		""
		"Put it in your Heart Amulet and enjoy &c+1 heart&r. You can fit up to ten red ones."
	]
	quest.6A3830D4991E6114.title: "One More Heart"
	quest.6A9CF31EE7F4C2AF.quest_desc: ["A &eCrafting Upgrade&r puts a crafting table in a tab on the chest. The &eStonecutter Upgrade&r adds a stonecutter the same way."]
	quest.6A9CF31EE7F4C2AF.title: "Craft from the Chest"
	quest.6ADE30DFDE8425D2.quest_desc: ["Module filters take items, but also filter items: a &eTag Filter&r, a &eMod Filter&r, a &eRegex Filter&r for registry names, an &eInspection Filter&r, and a &eBulk Item Filter&r for long lists."]
	quest.6ADE30DFDE8425D2.title: "Smarter Filters"
	quest.6AED27556BB184E8.quest_desc: [
		"A &eMagnet&r pulls nearby items and experience orbs straight to you, from up to 5 blocks away."
		""
		"Press &eCtrl+M&r to turn it on or off. Switch it off before you stand over a farm or a pile of things you meant to leave behind."
		""
		"A &eDemagnetization Coil&r stops magnets from grabbing items near it, which is handy around machines."
	]
	quest.6AED27556BB184E8.title: "Pull It All In"
	quest.6AF6C919C410C5A5.quest_desc: [
		"Grows &eNiotic Crystal Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Niotic Crystals and four Supremium Essence on the pedestals."
	]
	quest.6AF6C919C410C5A5.title: "Niotic Crystal Seeds"
	quest.6AF886AF6C938EDD.quest_desc: [
		"Cabbages, tomatoes, onions and rice grow wild out in the world, along with wild carrots, potatoes and beets. Break them for seeds and the odd crop to take home."
		""
		"When your own crops are ready, just &eright-click&r them. You get the harvest and the crop replants itself. No hoe needed."
	]
	quest.6AF886AF6C938EDD.title: "Wild Crops"
	quest.6AFB5C2CCFB57C70.quest_desc: [
		"Grows &eRefined Glowstone Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Refined Glowstone Ingots and four Imperium Essence on the pedestals."
	]
	quest.6AFB5C2CCFB57C70.title: "Refined Glowstone Seeds"
	quest.6AFDF6EE260C2E44.quest_desc: [
		"The &eChemical Crystallizer&r turns clean slurry into &eCrystals&r: five from every ore."
		""
		"Crystals go into the Chemical Injection Chamber to become shards, and from there down the same line as tier four. Five ingots per ore."
	]
	quest.6AFDF6EE260C2E44.title: "Quintuple Your Ores"
	quest.6B00282E9FE189A4.quest_desc: [
		"Some dishes are too big for one plate. A &efeast&r is placed on the table, and everyone can help themselves to a serving."
		""
		"Roast chicken, honey glazed ham, shepherd's pie, stuffed pumpkin: each one is a new food for the book, and a good excuse to have people over."
	]
	quest.6B00282E9FE189A4.title: "A Feast for Friends"
	quest.6BF4FF33C1704A87.quest_desc: [
		"The &eRobit&r follows you around, picks up items, and has a crafting table, a furnace and an inventory of its own. It goes back to a Chargepad on its own when it runs low."
		""
		"It's also the brain of the Digital Miner."
	]
	quest.6BF4FF33C1704A87.title: "A Robot Friend"
	quest.6BFAA2D8C21B4C12.quest_desc: [
		"The swamp's catch isn't pretty, but it counts."
		""
		"A leech makes decent bait, if you can bring yourself to use it."
	]
	quest.6BFAA2D8C21B4C12.title: "Swamp Fishing"
	quest.6C3D000609F6BFED.quest_desc: ["The &eTank Upgrade&r swaps part of the backpack's space for fluid storage. Add a &ePump Upgrade&r and it fills and empties itself."]
	quest.6C3D000609F6BFED.title: "A Bucket That Never Ends"
	quest.6C5AD29AEB97D1CB.quest_desc: ["Burns potions. A use for the ones you were never going to drink."]
	quest.6C5AD29AEB97D1CB.title: "Potion Generator"
	quest.6C7F13ED4B042AE5.quest_desc: [
		"Ink sacs and calamari."
		""
		"Right-click a Squid with a &eModel Framework&r to attune one. Simulating it costs 32 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.6C7F13ED4B042AE5.title: "Squid Model"
	quest.6C9C4B1D8A7D18E5.quest_desc: [
		"The &eBuilding Gadget&r places whole rows, columns and walls of blocks at once."
		""
		"Shift-right-click a block to choose what to build with, then right-click to place. You'll see a ghost of what's coming first. Hold &eG&r to open its menu, where you pick the mode and the size. &eShift+H&r anchors the preview so you can look around."
		""
		"The blocks come out of your inventory, and the gadget runs on FE, so charge it before you start."
	]
	quest.6C9C4B1D8A7D18E5.title: "A Wall in One Click"
	quest.6CB7B4C89FB16CD2.quest_desc: [
		"Real homes are full of small things. Cluttered has hundreds of them: stacks of books, teddy bears, vases of flowers, sewing machines, radios, picnic baskets and patterned wallpaper."
		""
		"Most are simple crafts. A stack of books is three books, a teddy bear is brown wool. Press &eU&r on an everyday item to see what it makes."
	]
	quest.6CB7B4C89FB16CD2.title: "A Little Clutter"
	quest.6CC432F2B3F3FECF.quest_desc: [
		"Fruit trees grow wild across the world: oranges, peaches, bananas, nuts and plenty more. Their leaves sometimes drop a sapling."
		""
		"No luck? Two pieces of fruit and any sapling craft a new one."
		""
		"Plant a few and wait. When the fruit is ripe, right-click it to pick it and leave the tree to grow more."
	]
	quest.6CC432F2B3F3FECF.title: "Plant an Orchard"
	quest.6CE981A14E5BC78E.quest_desc: [
		"Steel and redstone make eight &eBasic Universal Cables&r. Run them from your generators to your machines and the power follows."
		""
		"Every Mekanism machine has a side configuration tab in its screen. Use it to choose which faces take power, items and chemicals, and which push them out."
	]
	quest.6CE981A14E5BC78E.title: "Power Lines"
	quest.6D15724E29BBA7A5.quest_desc: [
		"Fill out the set: something for your head, your neck, your belt, your hands and your feet."
		""
		"Mix and match for the job at hand. A diving kit, a mining kit and a fighting kit are all worth keeping in a chest by the door."
	]
	quest.6D15724E29BBA7A5.title: "Dressed for Adventure"
	quest.6D3C1A843C2FB31F.quest_desc: ["A boss farm is loud. The &eWither Boss Death Muffler&r and &eEnder Dragon Death Muffler&r silence their death sounds nearby. Right-click one to hide the boss bar too."]
	quest.6D3C1A843C2FB31F.title: "Peace and Quiet"
	quest.6D40D938E2A94CDA.quest_desc: [
		"Trial Chambers are copper halls buried underground, full of Trial Spawners and Breezes."
		""
		"Beat a spawner's wave and it drops loot, sometimes a &eTrial Key&r. Keys open Vaults, the locked boxes with the best loot in the place."
		""
		"Bring blocks to wall off corridors, and a shield for the arrows."
	]
	quest.6D40D938E2A94CDA.title: "Trial Chambers"
	quest.6D4809624C1B97CE.quest_desc: [
		"&eDripstone Caves&r bristle with stone spikes, up and down."
		""
		"Look up before you dig. Pointed dripstone falls when you break the block it hangs from, and it hurts. Land on one and it hurts more."
	]
	quest.6D4809624C1B97CE.title: "Mind Your Head"
	quest.6D485BA017539056.quest_desc: [
		"5,000 Bronze in the Quantum Compressor."
		""
		"Bronze is an alloy. Press &eR&r on the ingot to see what makes it."
	]
	quest.6D485BA017539056.title: "Bronze Singularity"
	quest.6D4A8EE2E92BB963.quest_desc: [
		"Comforts adds two ways to rest away from your bed."
		""
		"A &esleeping bag&r gets you through the night without moving your spawn point, which is handy on long trips."
		""
		"A &ehammock&r hangs between two Rope and Nails. Rest in it during the day and you'll wake at dusk."
	]
	quest.6D4A8EE2E92BB963.title: "Afternoon Nap"
	quest.6D6E33C693B8AB99.quest_desc: [
		"A Sophisticated &eShulker Box&r keeps everything inside when you break it, and takes tiers and upgrades like the chests do."
		""
		"Got vanilla shulker boxes already? Craft one into its Sophisticated version."
	]
	quest.6D6E33C693B8AB99.title: "A Shulker Box That Grows"
	quest.6D8ED61924431C78.quest_desc: [
		"Land from any height, unhurt."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.6D8ED61924431C78.title: "No Fall Damage Augment"
	quest.6D9ECE8EE856BC35.quest_desc: [
		"Two enchantments keep good gear going for a very long time."
		""
		"&eUnbreaking&r makes each use less likely to cost durability."
		""
		"&eMending&r repairs the item from experience orbs you pick up. Librarian villagers sometimes sell it, and it turns up in chests."
		""
		"Find a Mending book, then put both on your favorite pickaxe. It may never need replacing."
	]
	quest.6D9ECE8EE856BC35.title: "Tools That Last"
	quest.6DC303F34BBA5633.quest_desc: [
		"Grows &eMystical Flower Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Mystical Flower Agglomeratio and four Prudentium Essence on the pedestals."
	]
	quest.6DC303F34BBA5633.title: "Mystical Flower Seeds"
	quest.6E03269FEA380C16.quest_desc: [
		"Surround your backpack with copper ingots and it becomes a &eCopper Backpack&r, contents and upgrades included."
		""
		"Bigger packs have more slots and more room for upgrades. Each tier after this one is built around the one before."
	]
	quest.6E03269FEA380C16.title: "A Bigger Backpack"
	quest.6E2A53E1997A4DDF.quest_desc: [
		"&eAddons&r are blocks that attach to a machine at its marked spots. A &eSpeed Addon&r makes it work half again as fast but costs more power, and an &eEfficiency Addon&r cuts its power use by a fifth."
		""
		"A connected addon's pink parts turn blue. If yours stays pink, right-click the machine."
	]
	quest.6E2A53E1997A4DDF.title: "Addons"
	quest.6E6B72FCC24A72C7.quest_desc: ["Clear the spiders out of the barn rafters."]
	quest.6E6B72FCC24A72C7.quest_subtitle: "Odd Job"
	quest.6E6B72FCC24A72C7.title: "Cobweb Duty"
	quest.6E86768C0FE66A53.quest_desc: [
		"The &eAbsorption Hopper&r vacuums up items and experience orbs in a 7x7x7 area around it."
		""
		"It can push out of any side you choose, into chests for items and tanks for experience. Radius upgrades make the area bigger."
	]
	quest.6E86768C0FE66A53.title: "Absorption Hopper"
	quest.6E890BBA5D1DDE91.quest_desc: [
		"A &eFlux Plug&r takes power from whatever it touches. A &eFlux Point&r gives power to whatever it touches. Put both on the same network, and power jumps between them however far apart they are."
		""
		"Right-click a flux block to make a network or pick one. You can have up to five."
		""
		"Flux can't keep chunks loaded here, so force-load both ends with the claim map (&eM&r, then &eShift&r-drag)."
	]
	quest.6E890BBA5D1DDE91.title: "Link Two Bases"
	quest.6EA07FC704C53A2C.quest_desc: ["Widens the area the Entity Spawner spawns in."]
	quest.6EA07FC704C53A2C.title: "Spawner: Width"
	quest.6EA5E8C4074474E0.quest_desc: ["The strangest augments need this one: flight, a cloak, ore vision, a way home through a portal, and more."]
	quest.6EA5E8C4074474E0.title: "Arcane Research Station"
	quest.6EB2F39880CC2BDE.quest_desc: [
		"&ePower Poles&r send power across long distances. Link two with a Target Designator: sneak-click the first, then the second."
		""
		"One pole can link to as many others as you like."
	]
	quest.6EB2F39880CC2BDE.title: "Power Lines"
	quest.6EC0318BAA83CAB0.quest_desc: [
		"Right-click the Wither with a Model Framework (carefully), then train the model past Faulty with a few more Wither fights. Simulating it costs 2,560 FE a tick, so have power to spare."
		""
		"A &eWither Prediction&r is one of the pieces of the &eAllthemodium Alloy Paxel&r. The paxel quest gives it back once you've crafted the paxel."
	]
	quest.6EC0318BAA83CAB0.title: "A Wither in a Box"
	quest.6EF490A1F8E868AF.quest_desc: [
		"A resource seed grows the real thing: stone, coal, iron, diamond and many more. Each one is a seed base on the altar, with four of the material and four essences on the pedestals."
		""
		"Better materials need better essence. Look any seed up in JEI with &eR&r to see what it takes, and start with whatever you use the most of."
	]
	quest.6EF490A1F8E868AF.title: "Your First Resource Seed"
	quest.6EF77A7565F00B61.quest_desc: ["Iron for hinges, buckets and a hundred small repairs."]
	quest.6EF77A7565F00B61.quest_subtitle: "Odd Job"
	quest.6EF77A7565F00B61.title: "Smelter's Due"
	quest.6F17D8D9506A3BAC.quest_desc: [
		"Fish from a boat, or off a beach."
		""
		"Halibut and herring prefer seas that aren't too warm. Tuna, grouper and jellyfish turn up in any ocean."
	]
	quest.6F17D8D9506A3BAC.title: "The Open Sea"
	quest.6F2A07DFF5C26DC2.quest_desc: [
		"A &estone pickaxe&r mines iron ore, which is the next step up, and it lasts a good deal longer than wood."
		""
		"Put the cobblestone you dig to use: a &efurnace&r turns raw iron into ingots, and charcoal from logs works as fuel when coal runs short."
	]
	quest.6F2A07DFF5C26DC2.title: "Set in Stone"
	quest.6F48E5221B56C656.quest_desc: [
		"&eProsperity Ore&r sits a little deeper than Inferium, from about Y 24 down to Y -60, and drops &eProsperity Shards&r."
		""
		"Shards go into Infusion Crystals and into the seed base that every resource seed is built on, so keep a healthy pile."
	]
	quest.6F48E5221B56C656.title: "Prosperity Shards"
	quest.6F7946E42B17D436.quest_desc: [
		"The &eCooking Pot&r makes soups, stews and proper meals. Set it over heat: a campfire, a stove, fire, a magma block or lava."
		""
		"Most meals need a bowl to serve into, so keep some nearby. The pot holds the finished food until you take it."
		""
		"Hearty meals grant &eNourishment&r, which keeps your hunger from dropping for a while."
	]
	quest.6F7946E42B17D436.title: "Something on the Stove"
	quest.6F8102BD83116775.quest_desc: ["A hardened capacitor around a basic rod. Faster again."]
	quest.6F8102BD83116775.title: "Hardened Energizing Rod"
	quest.6F94888591C13D60.quest_desc: [
		"Slimeballs and slime blocks."
		""
		"Right-click a Slime with a &eModel Framework&r to attune one. Simulating it costs 128 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.6F94888591C13D60.title: "Slime Model"
	quest.6FBC06855929E17C.quest_desc: [
		"Four Dragon Scales, four Insanium Essence and a block of diamond make a &eDragon Egg Crux&r, the soil the Dragon Egg Seed needs below it."
		""
		"Nine Dragon Egg Essence make a chunk, and three chunks a whole Dragon Egg. Your friends will each want one."
	]
	quest.6FBC06855929E17C.title: "Dragon Egg Crux"
	quest.6FD54CDF7C272EF3.quest_desc: [
		"Each alloy tool upgrades its unobtainium counterpart. On an &eAdvanced Crafting Table&r, surround an Unobtainium pickaxe, axe, shovel or sword with alloy ingots and Unobtainium Rods."
		""
		"They're the best tools in the pack in their own right, so use them while you work toward the paxel. It needs all four."
	]
	quest.6FD54CDF7C272EF3.title: "Four Alloy Tools"
	quest.6FDEE1032AA1E808.quest_desc: [
		"Watch for gear with a colored name. That's an &eaffix item&r: Common, Uncommon, Rare, Epic or Mythic, each with more bonuses than the last."
		""
		"They turn up in chests, and on &eElite&r mobs, the ones with names that hit too hard. Pick up your first one and the &eHaven&r tier is yours."
		""
		"Until Haven is active, affix items show as Unidentified. Open the World Tier screen with &eCtrl+T&r to check."
	]
	quest.6FDEE1032AA1E808.title: "World Tier: Haven"
	quest.6FF315F37048EB75.quest_desc: [
		"Two farming tools Mystical Agriculture adds: a &eSickle&r cuts through leaves and plants around you, and a &eScythe&r through a whole patch of crops at once."
		""
		"They start at diamond, like the rest, and essence versions reach further."
	]
	quest.6FF315F37048EB75.title: "Sickles and Scythes"
	quest.702153B7CC347D16.quest_desc: [
		"5,000 Iron in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.702153B7CC347D16.title: "Iron Singularity"
	quest.7034F747A83C00B3.quest_desc: ["Clear the guardians from an ocean monument."]
	quest.7034F747A83C00B3.quest_subtitle: "Commission"
	quest.7034F747A83C00B3.title: "Monument Work"
	quest.705C0BABD066C4AC.quest_desc: [
		"A &eThermo Generator&r sits on top of something hot, like lava, and makes power as long as you give it a coolant such as water."
		""
		"No fuel to shovel. Pipe water in and it hums along on its own. Every Powah generator comes in all seven tiers, and any tier counts here."
	]
	quest.705C0BABD066C4AC.title: "Hot and Cold"
	quest.707379AAA0B2B4DC.quest_desc: [
		"Dragon's breath, and a dragon egg of your very own."
		""
		"Right-click an Ender Dragon with a &eModel Framework&r to attune one. Simulating it costs 4,096 FE a tick, and every run makes a &eGeneralized Ender Prediction&r as well."
	]
	quest.707379AAA0B2B4DC.title: "Ender Dragon Model"
	quest.70738B53DF25B42C.quest_desc: [
		"A &ePersonal Chest&r is a 54-slot chest you can open straight from your inventory. A &ePersonal Barrel&r is the same, barrel-shaped."
		""
		"It's also the heart of the Robit."
	]
	quest.70738B53DF25B42C.title: "Personal Storage"
	quest.7077C1FA257E0C4D.quest_desc: [
		"A &eNetwork Transmitter&r and a &eNetwork Receiver&r carry the network between two places with no cable between them. Pair them with a &eNetwork Card&r bound to the receiver."
		""
		"Each one takes a netherite ingot, so they're not cheap. For a base on the other side of the mountain, they're worth it."
	]
	quest.7077C1FA257E0C4D.title: "No Cables Required"
	quest.7091DC902F9DC3B7.quest_desc: ["Carry up to 10,000 RF a tick. Oritech power is pushed: generators and storage send it out, and pipes never pull."]
	quest.7091DC902F9DC3B7.title: "Energy Pipes"
	quest.70C564184533B020.quest_desc: ["Empties and fills disks much faster, with more filter slots."]
	quest.70C564184533B020.title: "Tiered Disk Interfaces"
	quest.70CE56C4C49A6218.quest_desc: ["A &eStack Upgrade&r moves more items each time the router ticks."]
	quest.70CE56C4C49A6218.title: "Stack Upgrade"
	quest.70FF78BBF74A4686.quest_desc: [
		"Hydrogen chloride needs &echlorine&r, and chlorine comes from &ebrine&r."
		""
		"The quick way is a &eChemical Oxidizer&r fed with salt. Salt Blocks form patches on the beds of lakes and seas, where you'd find clay, and the Enrichment Chamber turns each one into four Salt. Salt Ore underground works too."
		""
		"The grand way is a &eThermal Evaporation Plant&r, a multiblock that draws brine out of plain water. Look up its controller in JEI: Just Enough Mekanism Multiblocks shows every Mekanism multiblock layer by layer, with the full bill of materials."
	]
	quest.70FF78BBF74A4686.title: "Brine"
	quest.71099A6DBC9C74FE.quest_desc: [
		"The first of the three. Allthemodium makes gear a step above netherite, and everything else in this chapter builds on it."
		""
		"On a Smithing Table, an Allthemodium Smithing Template and one ingot turn a piece of netherite gear into Allthemodium."
	]
	quest.71099A6DBC9C74FE.title: "Allthemodium"
	quest.7117CFC3FC8EF5B1.quest_desc: [
		"Generator Galore has generators for things other than coal. The first is the &eCulinary Generator&r: it eats food."
		""
		"It's a Gold Generator with a cake, crops, eggs and redstone around it, or a Gold to Culinary Upgrade on a placed one. Honey and potion generators grow from it."
	]
	quest.7117CFC3FC8EF5B1.title: "Odd Fuels"
	quest.7117E38E00A621C3.quest_desc: [
		"Grows &eSlime Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of slime souls and four Prudentium Essence on the pedestals."
	]
	quest.7117E38E00A621C3.title: "Slime Seeds"
	quest.712C67596C1DB470.quest_desc: [
		"Mine and dig faster. It comes in 3 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.712C67596C1DB470.title: "Haste Augments"
	quest.714590CDDF3837D6.quest_desc: [
		"Oritech is industry on a grand scale: multiblock machines, lasers, oil refineries, and a drill that pulls ore up from below the bedrock forever."
		""
		"It runs on &enickel&r. Here nickel comes from AllTheOres veins, and the ore boulders you'll find on the surface often have some showing."
		""
		"Bring copper, iron, coal and redstone too."
		""
		"Oritech's own manual, the &eOracle Index&r, has a page for nearly every block: hover an Oritech item and hold &eAlt&r. Its key is unbound here; set &eOpen Oracle Index&r under Options, Controls, Key Binds if you want one."
	]
	quest.714590CDDF3837D6.title: "Oritech"
	quest.7149BA847FFC8F0E.quest_desc: ["Widens what a Destroyer or Enderic Laser can reach, so one machine clears far more without moving."]
	quest.7149BA847FFC8F0E.title: "Quarry Addon"
	quest.715BE28077242B64.quest_desc: [
		"Beef, leather and both kinds of mushroom."
		""
		"Right-click a Mooshroom with a &eModel Framework&r to attune one. Simulating it costs 64 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.715BE28077242B64.title: "Mooshroom Model"
	quest.715E84C98704AAF5.quest_desc: ["Raises the area the Entity Spawner spawns in."]
	quest.715E84C98704AAF5.title: "Spawner: Height"
	quest.7179EBBC885D43E1.quest_desc: [
		"The &ePiglich&r guards the Ancient Pyramids in the soul sand valleys of the Other."
		""
		"You'll be fighting a few of these for their hearts if you're after the Alloy Paxel. One of them goes on the wall."
	]
	quest.7179EBBC885D43E1.title: "A Lich in Gold"
	quest.718F1F03BD03F83A.quest_desc: [
		"Purple as far as you can see. Bring a friend to show it to."
		""
		"Your &eNature's Compass&r can find it."
	]
	quest.718F1F03BD03F83A.title: "Lavender Forest"
	quest.71A2FD9815DC7190.quest_desc: ["A &eMagmator&r burns hot fluids like lava for power. Better tiers burn faster and make more."]
	quest.71A2FD9815DC7190.title: "Magmator"
	quest.71B7D47338992D2B.quest_desc: ["With a bucket or tank item in its buffer, a router with a &eFluid Module&r moves fluids to and from the block it faces. The Mk2 reaches any block nearby."]
	quest.71B7D47338992D2B.title: "Fluid Module"
	quest.71C17E71CA1B9CBF.quest_desc: [
		"A bottle that slowly fills with time while you carry it."
		""
		"Use it on a furnace, a machine or a growing crop to speed it up for 30 seconds. Use it again while it's running to double the speed, up to 256 times as fast."
		""
		"Gold, diamonds, lapis, a clock and a glass bottle."
	]
	quest.71C17E71CA1B9CBF.title: "Time in a Bottle"
	quest.71DB06DB24FDB7F3.quest_desc: ["&eGas Pipes&r move Mekanism's gases. They need Infused Alloy, so they come a little later."]
	quest.71DB06DB24FDB7F3.title: "Gas Pipes"
	quest.7211CD319A89561D.quest_desc: ["Four million items on one disk. Most bases never fill one."]
	quest.7211CD319A89561D.title: "4096k Storage Disk"
	quest.72161221FA31FC21.quest_desc: [
		"The last tier. Wear a full set of &5Epic&r gear, weapon included, and free the End by slaying the &cEnder Dragon&r."
		""
		"From here the monsters are as strong as they get, and so is the loot. You can always step back down with &eCtrl+T&r when you'd rather build in peace."
	]
	quest.72161221FA31FC21.title: "World Tier: Pinnacle"
	quest.72498393775CC042.quest_desc: [
		"A whole world built for digging: no towns, no structures, just stone, layer on layer, laced with ore."
		""
		"Dig as much as you like. Your base back home stays exactly as you left it."
		""
		"From the top down it's stone, deepslate, netherrack, then end stone above the bedrock. Ores take on the look of the block around them, but they smelt the same."
		""
		"Take your pad with you, or build another one here, for the trip home."
	]
	quest.72498393775CC042.title: "The Mining Dimension"
	quest.72624A75F4597951.quest_desc: ["Burns &enether stars&r for 4,092 FE/t. Wither farm, meet power plant."]
	quest.72624A75F4597951.title: "Netherstar Generator"
	quest.7265BC04C59307C5.quest_desc: [
		"Grows &eFluorite Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Fluorite and four Imperium Essence on the pedestals."
	]
	quest.7265BC04C59307C5.title: "Fluorite Seeds"
	quest.72B21F5C5E982E8B.quest_desc: [
		"A full set of &enetherite armor&r is the toughest you can wear without building it yourself."
		""
		"It also resists knockback, so you're far less likely to be shoved off a ledge into lava."
	]
	quest.72B21F5C5E982E8B.title: "Dressed for the Nether"
	quest.72D07C9F80EE2471.quest_desc: [
		"No number on the label because there's no limit. An &eInfinite Storage Disk&r takes everything you'll ever own."
		""
		"It's the end of the item ladder. Every other disk you own is now a spare."
	]
	quest.72D07C9F80EE2471.title: "Infinite Storage"
	quest.72E1310967061C15.quest_desc: [
		"The &eWarden&r is blind, but it can hear you breathe."
		""
		"Sneak, throw snowballs to distract it, and don't fight it in a corridor. Plenty of people never do fight it, and that's allowed."
	]
	quest.72E1310967061C15.title: "Quiet, Please"
	quest.7316299424FC5AA5.quest_desc: [
		"The &eFeeding Upgrade&r feeds you from the food in your backpack when you get hungry."
		""
		"Pack something filling and stop worrying about the hunger bar on long digs. It takes a golden apple, a golden carrot and a glistering melon slice, so it's a treat to make."
	]
	quest.7316299424FC5AA5.title: "Packed Lunch"
	quest.73273BE106300CA5.quest_desc: ["128 million FE. That's a lot of jetpack."]
	quest.73273BE106300CA5.title: "Gargantuan Flux Storage"
	quest.73437B423E4BA5FE.quest_desc: ["Fit an &eXP Vacuum Augment&r to a Vacuum Module and it collects experience orbs instead of items, as Bottles o' Enchanting."]
	quest.73437B423E4BA5FE.title: "Bottled Experience"
	quest.734A6F348105A68C.quest_desc: [
		"&eDreadful Dirt&r spawns monsters in the dark, and burns in daylight under open sky. A light level of 5 or more stops it."
		""
		"&eDelightful Dirt&r does the opposite: animals, in the light. Neither works in oceans."
	]
	quest.734A6F348105A68C.title: "Dirt That Spawns Things"
	quest.7358113C8896FA6E.quest_desc: [
		"Apotheosis has a challenge Gateway for each World Tier past Haven. The Frontier gate is full of zombies and skeletons in affixed armor."
		""
		"Win and it pays in affix gear, gems and Gem Dust. Check JEI for the pearl's recipe."
	]
	quest.7358113C8896FA6E.title: "Challenge Gates"
	quest.7366E6C3CEFC9AE8.quest_desc: [
		"People lived out here once. Structory leaves their traces: abandoned camps and chapels, an old manor, firetowers, graveyards, and ruins both above and below ground."
		""
		"Most have a chest or two. Some have company."
	]
	quest.7366E6C3CEFC9AE8.title: "Old Stones"
	quest.738D460B9DBF23A5.quest_desc: [
		"Supplementaries is a box of useful oddments. A few to start with:"
		""
		"A &eJar&r holds bottles, buckets, cookies or even a small mob. An &eItem Shelf&r shows off one item on a wall. A &eFlower Box&r holds any big plant under a window. A &eGlobe&r spins when you hit it."
		""
		"There are notice boards, hat stands, sacks, doormats and a lot more. Browse the mod in JEI."
		""
		"Amendments adds no blocks, just new places for old ones: lanterns on walls, carpet on stairs, flower pots and banners hanging from the ceiling, and cakes you can stack."
	]
	quest.738D460B9DBF23A5.title: "Odds and Ends"
	quest.73A74258BA4CDD10.quest_desc: [
		"A &eTimber Frame&r is a wooden frame that holds any full block. Right-click one with a block and it fills in behind the beams."
		""
		"Braces and cross braces give you the diagonal beams, and &eDaub&r is the plaster to fill them with. That's a cottage wall in two blocks."
	]
	quest.73A74258BA4CDD10.title: "Half-Timbered"
	quest.73C6F26208A51C9C.quest_desc: [
		"All that copper from the mines has somewhere to go: copper lanterns, chains, bars, ladders, doors, trapdoors, rails, even copper tools and armor."
		""
		"Like copper blocks, they turn green with age. Wax them with a &eHoneycomb&r to keep the color you like."
	]
	quest.73C6F26208A51C9C.title: "Everything Copper"
	quest.7422BC30ED1E3918.quest_desc: [
		"A &eGate Pearl&r opens a Gateway: a portal that sends out waves of monsters, and pays out if you beat them all."
		""
		"&eOverworldian Nights&r is a good first one: zombies, skeletons, spiders, creepers and witches, with a pile of dungeon loot at the end."
		""
		"Hover over a pearl to see its waves, rewards and rules. Use it on a block in an open space and stand back. A Gateway fails if the timer runs out, a monster wanders too far, or it can't find room to spawn, so fight on flat ground and stay close."
	]
	quest.7422BC30ED1E3918.title: "A Pearl Full of Trouble"
	quest.745F23572067F798.quest_desc: [
		"5,000 Copper in the Quantum Compressor."
		""
		"A Mystical Agriculture farm makes short work of it."
	]
	quest.745F23572067F798.title: "Copper Singularity"
	quest.74A6647F27B291DD.quest_desc: ["An electric furnace. The &eEnergized Smelter&r cooks anything a furnace would, on power instead of fuel, and takes upgrades."]
	quest.74A6647F27B291DD.title: "The Energized Smelter"
	quest.74F1BBF845B45E83.quest_desc: [
		"Gadgets run on FE. If you don't have a power setup yet, the &eCharging Station&r is the easy way."
		""
		"Feed it furnace fuel, like coal, and put a gadget in to charge. Coal blocks burn longest."
		""
		"Later on, any machine or cell that charges items will top up a gadget too."
	]
	quest.74F1BBF845B45E83.title: "Power to the Gadgets"
	quest.74F714E45F2B8EAD.quest_desc: [
		"Mud, mangrove roots, moss and whole trees, all under the rock. The &eUnderground Jungle&r even has frogs, turtles and tropical fish."
		""
		"Fewer monsters spawn here than in most caves, though creepers, spiders and witches still find their way in."
	]
	quest.74F714E45F2B8EAD.title: "A Jungle in the Dark"
	quest.74FDF8562F62A3A2.quest_desc: [
		"A Teleport Pad placed in the End leads to &eThe Beyond&r."
		""
		"There's nothing there at all: no land, no ore, no monsters. Just open sky. Bring blocks before you step off the pad. It's the biggest blank canvas in the pack."
	]
	quest.74FDF8562F62A3A2.title: "The Beyond"
	quest.757591B2843F68FA.quest_desc: [
		"Hit harder. It comes in 3 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.757591B2843F68FA.title: "Strength Augments"
	quest.75A6F42380087AA3.quest_desc: ["A &eCamouflage Upgrade&r makes the router look like any block you set in it, so it disappears into the wall."]
	quest.75A6F42380087AA3.title: "Hide the Machinery"
	quest.75A7CB1D286F0578.quest_desc: [
		"Grows &eEnderman Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Soulium Seed Base in the middle, with four Soul Jars full of enderman souls and four Imperium Essence on the pedestals."
	]
	quest.75A7CB1D286F0578.title: "Enderman Seeds"
	quest.75AEE839F2AD0E4C.quest_desc: ["The &eHopper Upgrade&r pulls items from the block above the chest and pushes them into the block below. The advanced one works on any side, faster."]
	quest.75AEE839F2AD0E4C.title: "Built-in Hopper"
	quest.75C7804B87BBE8D7.quest_desc: ["Destroyers and Enderic Lasers fitted with this pick up blocks whole, ore included. Feed the ore to a Fragment Forge for the best return."]
	quest.75C7804B87BBE8D7.title: "Silk Touch Addon"
	quest.75D1AEF5F001EFB1.quest_desc: [
		"Structory Towers adds tall things to climb: lighthouses, lookouts and outposts, a great toadstool and a few stranger ones."
		""
		"The view from the top is free. So is the jump, with a paraglider."
	]
	quest.75D1AEF5F001EFB1.title: "Lookouts and Lighthouses"
	quest.75EDDC31AD42FAC6.quest_desc: [
		"Potions Master brews potions that let you see one kind of ore through solid rock while they last. Nearly every ore in the pack has one, Allthemodium included."
		""
		"It starts at a &eMortar&r with a &ePestle&r and ends at a brewing stand. JEI shows every step in between: press &eU&r on the Pestle."
		""
		"Worth it when you want diamonds and nothing else."
	]
	quest.75EDDC31AD42FAC6.title: "Seeing Through Stone"
	quest.75F3E3DFA31E06B2.quest_desc: [
		"The Nether has trial chambers of its own, buried low beneath the lava sea."
		""
		"Their vaults hold diamond gear, a mace now and then, and the odd scrap of netherite. The fights are hotter too."
	]
	quest.75F3E3DFA31E06B2.title: "Trials, but Hotter"
	quest.75FD93A935F23B49.quest_desc: [
		"The &eBasic Crafting Table&r is 3x3 like the one you know, but it's the first rung. Each bigger table takes two of the one below it."
		""
		"Components and Catalysts come from Black Iron Slate, Luminessence and a material: iron for Basic, gold for Advanced, diamond for Elite and emerald for Ultimate."
		""
		"These tables keep their contents when you close them."
	]
	quest.75FD93A935F23B49.title: "Basic Crafting Table"
	quest.764B3DFBA120D935.quest_desc: [
		"Inside the reactor go columns of &eFission Fuel Assemblies&r, each topped with a &eControl Rod Assembly&r."
		""
		"More assemblies burn more fuel and make more heat. Leave room around them for coolant."
	]
	quest.764B3DFBA120D935.title: "Fuel Rods"
	quest.766FB3578F483F11.quest_desc: [
		"Supremium can be pushed one step further on an &eAwakening Altar&r. It needs four &eAwakening Pedestals&r for the ingredients and four &eEssence Vessels&r for the essence."
		""
		"The vessels hold &eAir&r, &eEarth&r, &eWater&r and &eFire Essence&r, so plant the elemental seeds well ahead of time."
	]
	quest.766FB3578F483F11.title: "The Awakening Altar"
	quest.76ABBDB1A7DF4ACD.quest_desc: [
		"A Basic Control Circuit between two Infused Alloys makes an &eAdvanced Control Circuit&r. You can also infuse a Basic circuit with more redstone, if you'd rather save the alloy."
		""
		"The Purification Chamber needs two."
	]
	quest.76ABBDB1A7DF4ACD.title: "Advanced Control Circuit"
	quest.76DEA42704713281.quest_desc: [
		"The &eSPS&r turns polonium into &eantimatter&r. It's a big box of SPS Casing with SPS Ports, and &eSupercharged Coils&r on the ports to feed it power."
		""
		"And what power. Each drop of antimatter costs a vast amount of polonium and energy. This is where the Induction Matrix and the reactors earn their keep."
	]
	quest.76DEA42704713281.title: "Supercritical Phase Shifter"
	quest.76DF8AE0C9039AE4.quest_desc: [
		"&ePlatinum&r and &eUranium&r live low, down in the deepslate. Platinum is rare, so don't skip a single block of it."
		""
		"Treat uranium with respect later on. For now it's just another rock in your pack."
		""
		"Spot a lump of ore-studded deepslate sitting out on the surface? Straight below it, in the bedrock, is a &eResource Node&r that never runs dry. Note where it is: Oritech's &eBedrock Extractor&r can mine it forever."
	]
	quest.76DF8AE0C9039AE4.title: "Down Deep"
	quest.77159AAE0D072E39.quest_desc: [
		"The &eMekaSuit&r is armor that runs on power. Each piece is made from its netherite counterpart with HDPE, Polonium and Ultimate Control Circuits."
		""
		"On its own it's tough. With modules it flies, breathes underwater, feeds you and keeps the radiation out."
	]
	quest.77159AAE0D072E39.title: "The MekaSuit"
	quest.771ED5DFA445CA89.quest_desc: [
		"Insanium Essence opens up seeds for the three endgame metals: &eAllthemodium&r, &eVibranium&r and &eUnobtainium Seeds&r, made on the Infusion Altar from their ingots."
		""
		"Each one is picky about its soil: it only grows with a block of the same metal under its farmland."
		""
		"Eight essence in a ring make one ingot. Slow, but it never runs out."
	]
	quest.771ED5DFA445CA89.title: "Metal in the Soil"
	quest.7735E346C68D7B69.quest_desc: ["The &eStonecutter&r, &eLoom&r, &eSmithing Table&r, &eAnvil&r, &eGrindstone&r and &eCartography Table&r all come on sticks too."]
	quest.7735E346C68D7B69.title: "More Sticks"
	quest.77A2B74DBCBC2282.quest_desc: [
		"Extra golden hearts that soak up damage. It comes in 5 tiers."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.77A2B74DBCBC2282.title: "Absorption Augments"
	quest.77C075621BD37AFA.quest_desc: [
		"A &eThermoelectric Boiler&r makes steam from heat: from a fission reactor cooled with sodium, or from Resistive Heaters."
		""
		"It's Boiler Casing and Boiler Valves around &eSuperheating Elements&r and a layer of Pressure Dispersers."
	]
	quest.77C075621BD37AFA.title: "The Thermoelectric Boiler"
	quest.77C934FF272A2B78.quest_desc: ["From an emerald or crystal furnace."]
	quest.77C934FF272A2B78.title: "Obsidian Furnace"
	quest.77DC72092D99CAB3.quest_desc: [
		"The &eInfusion Pylon&r keeps a potion effect on you wherever you are, from &ePotion Filters&r you've charged."
		""
		"To charge a filter, have the effect on you and right-click with the filter. It needs an hour of the effect in total before it activates, so drink a few long potions. It also keeps its own chunk loaded while you're online."
	]
	quest.77DC72092D99CAB3.title: "Infusion Pylon"
	quest.77DE01517AC2992E.quest_desc: ["This &eTinted Glass&r keeps light out, so mobs spawn behind it, and it's tough enough to hold a Wither."]
	quest.77DE01517AC2992E.title: "Dark Glass"
	quest.77E58ECDC96FAD71.quest_desc: [
		"Ender pearls by the stack, and an End Crystal."
		""
		"Right-click an Enderman with a &eModel Framework&r to attune one. Simulating it costs 512 FE a tick, and every run makes a &eGeneralized Ender Prediction&r as well."
	]
	quest.77E58ECDC96FAD71.title: "Enderman Model"
	quest.77EBC78B1DE58F63.quest_desc: [
		"The &eParticle Accelerator&r sends an item around a ring of guide rings and motors. Get it up to speed, then send a second one into the ring, and the collision can make something new."
		""
		"Tachyon Absorbers around the crash catch the energy it throws off. The manual has the whole recipe list."
	]
	quest.77EBC78B1DE58F63.title: "Smash Things Together"
	quest.78189E78A00ABFBE.quest_desc: ["Adds a level of &eSharpness&r to the Mob Masher. Stack a few for more."]
	quest.78189E78A00ABFBE.title: "Masher: Sharpness"
	quest.7818BFA73E8FCBF3.quest_desc: [
		"Ascent has a challenge Gateway of its own, tougher than the Frontier's and better paid."
		""
		"As before, JEI has the pearl's recipe. Bring your best gear, and some food."
	]
	quest.7818BFA73E8FCBF3.title: "The Sunlit Ascent"
	quest.782AA0529B678FF9.quest_desc: ["The Mk2 extrudes copies of blocks from a pattern instead of real ones, so a hidden door can look like any wall."]
	quest.782AA0529B678FF9.title: "Extruder Module Mk2"
	quest.782D6077DF0B82D4.quest_desc: [
		"The infinite part needs &eWithering Processors&r: a Processor Binding with a nether star, silicon and redstone, smelted like any other."
		""
		"One nether star per processor, and the part takes four. Time to visit the Wither again."
	]
	quest.782D6077DF0B82D4.title: "Withering Processor"
	quest.782F22D054F2DD83.quest_desc: [
		"Four Supremium around an Infusion Crystal make &eInsanium Essence&r, the very top of the ladder. The last row of seeds needs it, and so do the cruxes below."
		""
		"It's also a piece of the &eAllthemodium Alloy Paxel&r. The paxel quest gives it back once you've crafted the paxel."
	]
	quest.782F22D054F2DD83.title: "Insanium"
	quest.783155A7542F9C20.quest_desc: [
		"A little of everything in one ingot, and a pellet of antimatter from &eMekanism Reactors&r. That's enough to tear a hole in the world."
		""
		"On the Ultimate Crafting Table: The Ultimate Ingot in the middle, the &eAntimatter Pellet&r above it, Crystaltine around them, Atomic Alloy on the diagonals, Ultimate Control Circuits in the middle of each edge and Nether Stars in the corners. Press &eR&r on the Spark for the exact layout."
		""
		"The Spark is a catalyst. It never gets used up, and with the best of each tech line it makes &dcreative&r items: endless power, an endless jetpack, tanks and bins that never run dry."
	]
	quest.783155A7542F9C20.title: "Break the Universe"
	quest.7845E12F44850DA8.quest_desc: [
		"Gunpowder by the stack, and creeper heads."
		""
		"Right-click a Creeper with a &eModel Framework&r to attune one. Simulating it costs 128 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.7845E12F44850DA8.title: "Creeper Model"
	quest.788C2AB45067AE2F.quest_desc: ["The Mk2 pulls from an inventory in range instead of the one it touches. Sneak and right-click the inventory with the module to set it."]
	quest.788C2AB45067AE2F.title: "Puller Module Mk2"
	quest.78AC94275EBD0E2B.quest_desc: [
		"The &eUltimate Machine Core&r is Oritech's best: prometheum around a superconductor. It gives a machine the highest quality there is, and with it the most room for addons."
		""
		"It's also one of the pieces of the &eAllthemodium Alloy Paxel&r, the pack's capstone. The paxel quest gives it back once you've crafted the paxel."
		""
		"Your drills never stop and your lasers never miss. Not bad at all."
	]
	quest.78AC94275EBD0E2B.title: "The Ultimate Core"
	quest.78B3FB8CFCC8FECB.quest_desc: ["A faster Constructor that places blocks more often, with more filter slots."]
	quest.78B3FB8CFCC8FECB.title: "Tiered Constructors"
	quest.78FD3CAA03278A82.quest_desc: [
		"Most Oritech machines are built from a few parts: &eMagnetic Coils&r from nickel and steel, &eMotors&r from coils and steel, and later &eProcessing Units&r from plastic, carbon fibre, electrum and redstone."
		""
		"Keep a stack of each. You'll use them everywhere."
	]
	quest.78FD3CAA03278A82.title: "Nuts and Bolts"
	quest.79002E5F7F00D379.quest_desc: [
		"Oritech's &eJetpack&r runs on power or on turbofuel, and it's faster on fuel. Fill its tank at an Equipment Charger."
		""
		"It's steel, gunpowder, leather and an Advanced Battery."
	]
	quest.79002E5F7F00D379.title: "Jetpack"
	quest.794CD53A45B7B900.quest_desc: ["The Vibranium Mace, an Unobtainium Smithing Template and a &eBlock of Unobtainium&r. That's nine of the rarest ingots in the pack in one swing."]
	quest.794CD53A45B7B900.title: "Unobtainium Mace"
	quest.7954892B593269ED.quest_desc: [
		"&eOrganic Compost&r is dirt, straw, rotten flesh and bone meal mixed together. Place it and it slowly turns into rich soil."
		""
		"It composts faster with sunlight, water nearby and mushrooms around it."
	]
	quest.7954892B593269ED.title: "Black Gold"
	quest.7978BCFC946903E6.quest_desc: [
		"Mekanism's machines run on power, and the &eHeat Generator&r is the easy first source. It burns lava or anything a furnace would take."
		""
		"It's made from iron, copper, planks and one osmium ingot, so you can build it today."
	]
	quest.7978BCFC946903E6.title: "Something to Run It On"
	quest.797D951557C7583E.quest_desc: [
		"An &eiron pickaxe&r mines diamond, gold and redstone ore, and lasts a good deal longer than stone."
		""
		"Hold &e`&r while you mine and the whole vein comes out at once. Iron veins are often bigger than they look."
	]
	quest.797D951557C7583E.title: "The Iron Age"
	quest.79AE566E38F8106A.quest_desc: [
		"&eItem Pipes&r connect to anything with an inventory. Right-click where a pipe meets a chest with the &ePipe Wrench&r, and that side starts pulling items out."
		""
		"Pipes push into whichever face they touch. Run one along the tops of a row of furnaces for ore, one along the sides for fuel, and pull the bottoms into an output chest."
		""
		"Now you can fill one chest and walk away. The rest of this chapter is about moving things: pipes, routers, and somewhere for the leftovers to go."
	]
	quest.79AE566E38F8106A.title: "Pipe a Furnace Array"
	quest.79CFD9A2743F40F4.quest_desc: [
		"The &ePipe Wrench&r turns pipe connections on and off, and sneak-right-click picks a pipe up instantly."
		""
		"It also lets you zipline along the cables between Power Poles."
	]
	quest.79CFD9A2743F40F4.title: "Pipe Wrench"
	quest.79D304C9B1FD1C5D.quest_desc: [
		"A Mega Torch stops spawns but leaves the cave dark. The &eFeral Flare Lantern&r fixes that: it places invisible lights in the dark spots for 16 blocks around it."
		""
		"Its settings let you choose whether it lights only what it can see, or reaches behind walls too."
		""
		"A &eFrozen Pearl&r clears its lights away again."
	]
	quest.79D304C9B1FD1C5D.title: "No Torch Required"
	quest.79EFCF37DCBCAC63.quest_desc: [
		"The &eBedrock Extractor&r sits over resource nodes and mines them forever. It scans the 3x3 area beneath it, up to three blocks down, and picks one spot at random each cycle, so center it over as many nodes as you can."
		""
		"It needs 26 machine cores, and it only takes power from &eEnderic Lasers&r. Each ore costs about 20,000 RF."
		""
		"Right-click it to see which nodes it can reach."
		""
		"Finding nodes: now and then a heap of deepslate studded with ore sits on the surface. That &eore boulder&r marks resource nodes in the bedrock right below it. Common boulders sit over copper, iron, nickel and coal; rarer ones over diamond, gold, emerald, uranium and platinum. Press &eShift+B&r to drop a waypoint."
	]
	quest.79EFCF37DCBCAC63.title: "Endless Ore"
	quest.79FC9BF235F0A984.quest_desc: [
		"Induction Cells and Providers go up to Ultimate too. A matrix full of Ultimate Cells holds more power than you'll likely ever need."
		""
		"Almost: the Reactors chapter asks for a lot."
	]
	quest.79FC9BF235F0A984.title: "Ultimate Cells"
	quest.7A029F3F00F5A8D6.quest_desc: ["The &eInfinite Fluid Storage Disk&r holds every bucket there is. Like its item cousin, it needs Withering Processors."]
	quest.7A029F3F00F5A8D6.title: "A Bottomless Tank"
	quest.7A24E1E781114AD3.quest_desc: [
		"Any artifact a Mimic can drop. Pick the one you want on the fabricator's screen."
		""
		"Right-click a Mimic with a &eModel Framework&r to attune one. Simulating it costs 2,560 FE a tick, and every run makes a &eGeneralized Ender Prediction&r as well."
	]
	quest.7A24E1E781114AD3.title: "Mimic Model"
	quest.7A401849EA875061.quest_desc: [
		"Wither Skeletons in Nether fortresses sometimes drop a &eWither Bone&r."
		""
		"If you already have a Wither Skeleton Skull, three bones and the skull craft six Wither Bones at once."
	]
	quest.7A401849EA875061.title: "Wither Bones"
	quest.7A60B5FB3AFB6CC9.quest_desc: [
		"Some geodes deep underground aren't amethyst. They're lined with ore instead: coal, copper, iron, gold, lapis, redstone, emerald, even diamond."
		""
		"The budding blocks grow clusters over time. Break a full-grown cluster for &eshards&r, and smelt the shards into ingots or gems."
		""
		"Leave the budding blocks where they are, and come back later for another crop."
	]
	quest.7A60B5FB3AFB6CC9.title: "Crystal Caves"
	quest.7A75F8E58A00344F.quest_desc: [
		"Grows &eUraninite Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Uraninite and four Supremium Essence on the pedestals."
	]
	quest.7A75F8E58A00344F.title: "Uraninite Seeds"
	quest.7A8DC469C6107CC2.quest_desc: ["Spirited rods. By now a single orb can keep a whole base supplied."]
	quest.7A8DC469C6107CC2.title: "Spirited Energizing Rod"
	quest.7A9079E387046CD2.quest_desc: [
		"&eSolar Generators&r run whenever the sun can see them. Four of them and some Infused Alloy make an &eAdvanced Solar Generator&r, which does the job in one block."
		""
		"Pair your solar farm with wind or a Heat Generator so the lights stay on at night."
	]
	quest.7A9079E387046CD2.title: "Soak Up the Sun"
	quest.7B15752D4C4D1108.quest_desc: ["Sixteen blocks of diamond for the vault."]
	quest.7B15752D4C4D1108.quest_subtitle: "Grand Bounty"
	quest.7B15752D4C4D1108.title: "Diamond Hoard"
	quest.7B26545A6FA5A450.quest_desc: [
		"A &eLogistical Sorter&r sits on a chest and pulls items out by filter, sending each kind down the transporter you choose."
		""
		"It's also a part in the Digital Miner."
	]
	quest.7B26545A6FA5A450.title: "Sort It Out"
	quest.7B4BF795B52FD0FE.quest_desc: ["&eEnergy Upgrades&r cut a machine's power use and let it store more. Pair them with Speed Upgrades."]
	quest.7B4BF795B52FD0FE.title: "Energy Upgrade"
	quest.7B4F04D3F0EF829A.quest_desc: [
		"Bundle up. These fish only bite along cold coasts and in cold seas."
		""
		"Rainbow trout and pink salmon also turn up in cold rivers."
	]
	quest.7B4F04D3F0EF829A.title: "Cold Water"
	quest.7B7B32BD4CE7C331.quest_desc: [
		"Rotten flesh and gold ingots."
		""
		"Right-click a Zombified Piglin with a &eModel Framework&r to attune one. Simulating it costs 256 FE a tick, and every run makes a &eGeneralized Nether Prediction&r as well."
	]
	quest.7B7B32BD4CE7C331.title: "Zombified Piglin Model"
	quest.7B938B75CEB7363A.quest_desc: [
		"Grows &eNether Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Nether Agglomeratio and four Prudentium Essence on the pedestals."
	]
	quest.7B938B75CEB7363A.title: "Nether Seeds"
	quest.7B9B1975332A092D.quest_desc: [
		"For serious storage, build an &eInduction Matrix&r: a hollow box of &eInduction Casing&r with a port or two, filled with &eInduction Cells&r and &eProviders&r."
		""
		"Cells set how much it holds. Providers set how fast power moves in and out. Look it up in JEI to see the layout."
	]
	quest.7B9B1975332A092D.title: "The Induction Matrix"
	quest.7BAB923D2C362509.quest_desc: [
		"Cable Tiers makes faster Importers, Exporters, Constructors, Destructors, Disk Interfaces and Interfaces, in three grades: &eElite&r, &eUltra&r and &eMega&r."
		""
		"An Elite device is four of the plain one around an Advanced Processor, with iron blocks. Each grade after that is built from four of the one before."
	]
	quest.7BAB923D2C362509.title: "Faster Hands"
	quest.7BD4696CF3657AE3.quest_desc: [
		"Template, netherite pickaxe, Allthemodium Ingot."
		""
		"You'll need it: Vibranium Ore won't break for anything less."
	]
	quest.7BD4696CF3657AE3.title: "A Better Pick"
	quest.7C136704376D02D6.quest_desc: [
		"The &eWrench&r has three modes."
		""
		"&eConfig&r changes which way a cable sends power. &eLink&r ties blocks together, like an Energizing Orb and its rods. &eRotate&r turns blocks to face the way you want."
		""
		"You won't need it often, but when you do, nothing else will do."
	]
	quest.7C136704376D02D6.title: "Powah Wrench"
	quest.7C2B1D710BBE205C.quest_desc: [
		"The rarest of the three lives in the End, and only in the &eEnd Highlands&r: the hilly outer islands, past the main one."
		""
		"It forms in end stone near the surface. Bring a Vibranium pickaxe, and an elytra for the gaps."
	]
	quest.7C2B1D710BBE205C.title: "Unobtainium"
	quest.7C2FE3F02624B08C.quest_desc: ["A faster Destructor. Put one in front of a cobblestone generator and watch the numbers climb."]
	quest.7C2FE3F02624B08C.title: "Tiered Destructors"
	quest.7C39909A9EE12274.quest_desc: [
		"Every good home needs a good toolbox. This chapter takes you from your first wooden pickaxe all the way to netherite, with a few handy extras on the way."
		""
		"Any &ewooden tool&r gets you started. A wooden pickaxe is the one that matters: it mines stone, and stone makes the next set."
	]
	quest.7C39909A9EE12274.title: "Tools of the Trade"
	quest.7C6244E10519CA08.quest_desc: [
		"Walk up full blocks as if they were slabs."
		""
		"Look it up with &eR&r to see what it takes and which gear it fits."
	]
	quest.7C6244E10519CA08.title: "Step Assist Augment"
	quest.7CB170FDD5D037D4.quest_desc: [
		"Repurposed Structures puts villages where vanilla never would: in badlands, bamboo jungles, birch and dark forests, cherry groves, mountains, swamps and mushroom islands."
		""
		"Even the Nether has a couple, if you're feeling brave."
	]
	quest.7CB170FDD5D037D4.title: "Off the Usual Map"
	quest.7CEBF0BFE7C976C2.quest_desc: ["An &eEnder Gate&r moves power between the block it touches and your Ender Network. Unlike a cell, it can't add capacity."]
	quest.7CEBF0BFE7C976C2.title: "Ender Gate"
	quest.7D017BA6EEC27E2F.quest_desc: ["Glide like you're wearing an elytra, without giving up the chestplate."]
	quest.7D017BA6EEC27E2F.title: "Elytra Unit"
	quest.7D091F5AFCAB0E45.quest_desc: ["Deeper still. Pair it with a magnet and the mining trips get long."]
	quest.7D091F5AFCAB0E45.title: "Stack Upgrade Tier 3"
	quest.7D1A343965395D13.quest_desc: ["The &eSmelting Upgrade&r adds a furnace to the chest, in a tab down the side. There are blasting and smoking ones too."]
	quest.7D1A343965395D13.title: "A Furnace in a Tab"
	quest.7D30F9A01AB5F498.quest_desc: [
		"Got a second group of chests across the room? Put a &eStorage Link&r against it."
		""
		"Link it to your controller with the &eStorage Tool&r and both groups answer to the same controller."
	]
	quest.7D30F9A01AB5F498.title: "Storage Link"
	quest.7D8106D659F1FE1E.quest_desc: [
		"&eRich Soil&r gives crops planted in it a chance at a free bone meal boost as they grow. Till it for farmland that keeps the bonus."
		""
		"Mushrooms planted on it grow into colonies you can shear for more mushrooms."
	]
	quest.7D8106D659F1FE1E.title: "Rich Soil"
	quest.7D89C873D0AD807D.quest_desc: ["Makes a Destroyer or Enderic Laser skip crops that aren't ripe yet. On a laser with a Hunter Addon, it filters animals too."]
	quest.7D89C873D0AD807D.title: "Crop Filter Addon"
	quest.7DA28C6A59DC8CE6.quest_desc: [
		"Wool in every color, mutton and bezoars."
		""
		"Right-click a Sheep with a &eModel Framework&r to attune one. Simulating it costs 64 FE a tick, and every run makes a &eGeneralized Overworld Prediction&r as well."
	]
	quest.7DA28C6A59DC8CE6.title: "Sheep Model"
	quest.7DF583EE662550BA.quest_desc: [
		"Run brine through a second &eElectrolytic Separator&r to get chlorine, with some sodium on the side."
		""
		"A &eChemical Infuser&r then combines that chlorine with hydrogen from your first separator. Pipe the &ehydrogen chloride&r into the Chemical Injection Chamber and tier four is running."
	]
	quest.7DF583EE662550BA.title: "Hydrogen Chloride"
	quest.7E22A1000C421882.quest_desc: ["A &eSpeed Upgrade&r makes the router tick more often. Stack a few for a router that keeps up with a busy machine."]
	quest.7E22A1000C421882.title: "Speed Upgrade"
	quest.7E49A75D95859B62.quest_desc: ["Adds a level of &eSmite&r to the Mob Masher. Stack a few for more."]
	quest.7E49A75D95859B62.title: "Masher: Smite"
	quest.7E53F8F026CA59BE.quest_desc: [
		"Normally a Vault only opens once for each player. Not here: use another key on a vault you've already opened and it pays out again."
		""
		"So a good chamber is worth coming back to."
		""
		"Drink an Ominous Bottle before you go in, and the chamber turns ominous: harder fights, &eOminous Trial Keys&r and better vaults."
	]
	quest.7E53F8F026CA59BE.title: "Back for Seconds"
	quest.7E8608ED6BC69FB5.quest_desc: ["The advanced block charger covers a bigger area, faster."]
	quest.7E8608ED6BC69FB5.title: "Advanced Block Charger"
	quest.7EA7137D4E067C2C.quest_desc: [
		"Bring a vanilla &eMace&r to a Smithing Table with an Allthemodium Smithing Template and a &eBlock of Allthemodium&r. A block, not an ingot: maces are greedy."
		""
		"Monsters \\& Mettle covers the mace itself."
	]
	quest.7EA7137D4E067C2C.title: "A Heavier Mace"
	quest.7EAF12A262A3D126.quest_desc: [
		"Can't find a seed in the wild? Buy it. The &eMarket&r sells seeds and saplings for an emerald each, including Croptopia's fruit trees and the crops from Farmer's Delight and Cultural Delights."
		""
		"Here are some emeralds to spend."
	]
	quest.7EAF12A262A3D126.title: "Market Day"
	quest.7EB8D84657E26242.quest_desc: ["Copper around a piece of lapis. The first step up in quality."]
	quest.7EB8D84657E26242.title: "Basic Machine Core"
	quest.7EBA022BA6DF6A8B.quest_desc: ["Runs a processing machine at eight times its speed for a short burst. Push it too long and the machine overheats, so let it cool between runs."]
	quest.7EBA022BA6DF6A8B.title: "Burst Addon"
	quest.7EC15D0E59E6ADC3.quest_desc: ["Four times the 256k. Each step up takes three parts of the size below and four Advanced Processors."]
	quest.7EC15D0E59E6ADC3.title: "1024k Storage Disk"
	quest.7EC72CA02267A666.quest_desc: ["Ultimate Chemical Tanks and Atomic Alloy make a Creative Chemical Tank. Fill it once with any chemical and it never empties."]
	quest.7EC72CA02267A666.title: "A Bottomless Tank"
	quest.7F08027DAC18F338.quest_desc: [
		"Put a &eSteam Boiler Addon&r on any generator except the Basic one, feed the addon water, and the generator makes steam instead of RF."
		""
		"The &eSteam Engine&r turns that steam back into RF and water. It runs faster the fuller its steam tank, and makes the most per bucket at around seven times its base speed. Engines built in a row chain together: pipe steam into the first one only."
	]
	quest.7F08027DAC18F338.title: "Full Steam"
	quest.7F0ADAE03FD86B05.quest_desc: ["Cooked beef, pork, chicken or mutton for the work crews."]
	quest.7F0ADAE03FD86B05.quest_subtitle: "Odd Job"
	quest.7F0ADAE03FD86B05.title: "Hot Supper"
	quest.7F34147977E60DC2.quest_desc: [
		"Shulker shells for every shulker box you'll ever want, and end rods."
		""
		"Right-click a Shulker with a &eModel Framework&r to attune one. Simulating it costs 512 FE a tick, and every run makes a &eGeneralized Ender Prediction&r as well."
	]
	quest.7F34147977E60DC2.title: "Shulker Model"
	quest.7F4C91F5619176D3.quest_desc: [
		"Grows &eAir Essence&r, one of the four elemental essences the Awakening Altar needs."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Air Agglomeratio and four Inferium Essence on the pedestals."
	]
	quest.7F4C91F5619176D3.title: "Air Seeds"
	quest.7F5AC85F2A3DCCE6.quest_desc: ["Adamant around an &eAdvanced Computing Engine&r from the Atomic Forge."]
	quest.7F5AC85F2A3DCCE6.title: "Elite Machine Core"
	quest.7F8AAF2E1AED3552.quest_desc: [
		"XyCraft's &eExtractor&r pulls items out of the world. Point it at a stone block with water and lava touching it, and it makes copies of that stone, slowly, with no power."
		""
		"It keeps what it makes, so pipe the stone out into a chest."
		""
		"Cobblestone, andesite, granite and more each have their own setup. Press &eU&r on the Extractor to see them all."
	]
	quest.7F8AAF2E1AED3552.title: "Stone from Nowhere"
	quest.7F997C652BB76B12.quest_desc: [
		"Autocrafting starts with &ePatterns&r. Put a blank one in a &ePattern Grid&r, lay out a recipe and encode it."
		""
		"Crafting patterns cover anything from a crafting table. Processing patterns are for machines: you list what goes in and what should come back out."
		""
		"Fuzzy mode lets a pattern accept alternatives, like any kind of plank."
	]
	quest.7F997C652BB76B12.title: "Write It Down"
	quest.7FAF9822E465FD9D.quest_desc: [
		"Grows &eEmerald Essence&r, which crafts back into the real thing."
		""
		"Made on the Infusion Altar: a Prosperity Seed Base in the middle, with four Emeralds and four Supremium Essence on the pedestals."
	]
	quest.7FAF9822E465FD9D.title: "Emerald Seeds"
	quest.7FC77056CEFCDCF2.quest_desc: [
		"The &eGem Cutting Table&r raises a gem's purity. It takes a second gem of the same purity, plus Gem Dust and some salvaged materials."
		""
		"The better the gem, the more it costs. JEI shows the exact price for each step."
	]
	quest.7FC77056CEFCDCF2.title: "Cut and Polish"
	quest.7FEE886F83E9709B.quest_desc: [
		"A &eFission Reactor&r is a hollow box of &eFission Reactor Casing&r, with Reactor Glass where you want to look in."
		""
		"Start small. A reactor can be as little as a few blocks across, and a small one is far easier to keep cool."
	]
	quest.7FEE886F83E9709B.title: "Lead-Lined"
	reward_table.041278CDAD7DD44C.title: "&eSpark Box"
	reward_table.092D24A5C2535F79.title: "&6Ember Crate"
	reward_table.098B892367E7AC30.title: "&9Packer's Parcel"
	reward_table.09A1F14D608457E8.title: "&fAviator's Kit"
	reward_table.155DB9931188C043.title: "&cHunter's Spoils"
	reward_table.25C6C8D830E1B038.title: "&dCurio Box"
	reward_table.27DF773AF193952A.title: "&7Kindling Crate"
	reward_table.286253AF46381B4E.title: "&5Ascent Cache"
	reward_table.2D56F3C469A191C5.title: "&bMekanism Parts Bin"
	reward_table.327B34F5C8C797CE.title: "&aSeed Bag"
	reward_table.354604C3695F61A5.title: "&dLantern Crate"
	reward_table.3B7A20930808D1EF.title: "&aHearth Crate"
	reward_table.4538FC66A0357427.title: "&7Smithy Bundle"
	reward_table.4DD3DB2B887A605F.title: "&ePantry Basket"
	reward_table.5400C5F1DDC85EC5.title: "&4Grinder's Haul"
	reward_table.57FE9E52A38B8B63.title: "&2Almanac Satchel"
	reward_table.5AA011D355B164A9.title: "&3Storage Kit"
	reward_table.666A24F1A872EB54.title: "&bBuilder's Bundle"
	reward_table.6950B51D8872EFFF.title: "&6Prospector's Pack"
	reward_table.6D6A8DFA125A1F60.title: "&aTraveler's Pack"
	reward_table.7544621E95881C71.title: "&6Oritech Parts Bin"
	task.000A335DBC596B4F.title: "Any Infinite Fluid Storage Disk"
	task.0020A9EADF46996A.title: "Sulfur"
	task.0023906E30BBAB72.title: "Any 65536k Storage Disk"
	task.0027A0A2FE883201.title: "Visit a Moonlight Grove"
	task.003664E2AE41AA74.title: "A smelting, blasting or smoking upgrade"
	task.0071D24E173529B6.title: "Deep Caves"
	task.00AB2E585E6187B0.title: "An Advanced Importer or Exporter"
	task.00C314EA6FBEBECF.title: "Visit the Thermal Caves"
	task.00C621D86FEB1E77.title: "Any Structory tower"
	task.01B18AFD250A0268.title: "A ender generator, or the upgrade to one"
	task.01C21C18B024CD2B.title: "A netherite chest or barrel, or the upgrade to one"
	task.027CE67BF3F5ED49.title: "Any 4096k Storage Disk"
	task.0340A7FDA63ECC98.title: "Any tiered Importer or Exporter"
	task.03612743E4094A1B.title: "A Repurposed Structures village"
	task.03FE4697B44C1F6D.title: "Sakura Grove"
	task.045FD7FB1CABF146.title: "Ender Dragon Data Model"
	task.046C882D847E0DBB.title: "Visit the Lush Caves"
	task.04B46072E24D23BA.title: "A Copper Generator or a Furnator"
	task.0572B2CD476BE9F9.title: "Dripstone Caves"
	task.05B16E687BAB2ADB.title: "Lush Desert"
	task.05C68EA39402AE4D.title: "Any storage upgrade"
	task.05D082591AA14A87.title: "Raw Osmium"
